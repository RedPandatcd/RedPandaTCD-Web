@page "/deck-builder"
@using RedPandaTCD_Web.Game
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
@inject GameSessionState Session

<PageTitle>Deck Builder - Red Panda TCD</PageTitle>

<div class="builder-page @GetPageTutorialClass("builder-page")">
    <div class="builder-shell">
        <header class="builder-header">
            <div>
                <h1>
    @(IsLearnToPlayDeckBuilder
        ? "Tutorial Deck Builder"
        : EditDeckIndex != null
            ? "Edit Deck"
            : "Deck Builder")
</h1>
                <p>@(IsLearnToPlayDeckBuilder
    ? "Save Tutorial Deck & Continue"
    : EditDeckIndex != null
        ? "Save Changes"
        : "Save Deck")</p>
            </div>
            <div class="header-actions">
                @if (IsLearnToPlayDeckBuilder)
                {
                    <button @onclick="ExitLearnToPlayBuilder">Exit Tutorial</button>
                }
                else
                {
                    <button @onclick="GoToDecks">View Decks</button>
                    <button @onclick="GoHome">Main Menu</button>
                }
            </div>
        </header>

        <main class="builder-content">
            <section class="available-panel @GetPageTutorialClass("available-cards")">
                <div class="panel-header">
                    <div>
                        <h2>Card Finder</h2>
                        <span>
                            @if (IsLearnToPlayDeckBuilder)
                            {
                                <text>@TutorialManager.GetLearnToPlayDeckProgress(workingDeck) · @FilteredCards.Count visible</text>
                            }
                            else
                            {
                                <text>@FilteredCards.Count card(s)</text>
                            }
                        </span>
                    </div>
                </div>

                @if (IsLearnToPlayDeckBuilder)
                {
                    <div class="tutorial-order-guide">@GetTutorialBuilderInstruction()</div>
                }

                <div class="@GetPageTutorialClass("card-filters")">
                    <input class="search-box" @bind="searchText" @bind:event="oninput" placeholder="Search by card name or ID..." />
                    <div class="filter-group">
                        <button class="@GetTypeButtonClass(null)" @onclick="() => SetTypeFilter(null)">All</button>
                        <button class="@GetTypeButtonClass(CardType.Character)" @onclick="() => SetTypeFilter(CardType.Character)">Characters</button>
                        <button class="@GetTypeButtonClass(CardType.Attack)" @onclick="() => SetTypeFilter(CardType.Attack)">Attacks</button>
                        <button class="@GetTypeButtonClass(CardType.Utility)" @onclick="() => SetTypeFilter(CardType.Utility)">Utilities</button>
                    </div>
                    <div class="filter-group">
                        <button class="@GetArchetypeButtonClass(null)" @onclick="() => SetArchetypeFilter(null)">All Archetypes</button>
                        <button class="@GetArchetypeButtonClass(Archetype.Magic)" @onclick="() => SetArchetypeFilter(Archetype.Magic)">Magic</button>
                        <button class="@GetArchetypeButtonClass(Archetype.Physical)" @onclick="() => SetArchetypeFilter(Archetype.Physical)">Physical</button>
                        <button class="@GetArchetypeButtonClass(Archetype.Neutral)" @onclick="() => SetArchetypeFilter(Archetype.Neutral)">Neutral</button>
                    </div>
                </div>

                <div class="available-list">
                    @foreach (Card card in FilteredCards)
                    {
                        bool tutorialRequired = IsCurrentTutorialCard(card);
                        bool alreadyAdded = IsTutorialCardAlreadyAdded(card);
                        bool addDisabled = !CanAddCard(card) || !CanAddTutorialCard(card);

                       <CardBrowseRow
                        @key="card.Id"
                        Card="@card"
                        ShowCardPreview="true"
                        ShowAdd="true"
                        AddDisabled="@addDisabled"
                        AddDisabledTitle="@GetAddDisabledTitle(card)"
                        OnAdd="RequestAddCard"
                        TutorialRequired="@tutorialRequired"
                        Subdued="@(IsLearnToPlayDeckBuilder && !tutorialRequired)"
                        StatusText="@GetFinderStatusText(card)"
                        StatusClass="@GetFinderStatusClass(card)"
                        Expanded="@IsFinderCardExpanded(card)"
                        ExpandedChanged="@(expanded => SetFinderCardExpanded(card, expanded))" />
                    }
                </div>
            </section>

            <section class="deck-panel @GetPageTutorialClass("built-deck")">
                <div class="compact-deck-name @GetPageTutorialClass("deck-name")">
                    <label>DECK NAME</label>
                    <input @bind="deckName" @bind:event="oninput" placeholder="Enter deck name..." disabled="@IsLearnToPlayDeckBuilder" />
                </div>

                <div class="deck-structure-selector @GetPageTutorialClass("structure-selector")">
                    <div class="structure-selector-header">
                        <label>DATA STRUCTURE</label>
                        <select @bind="selectedStructure" @bind:after="StructureChanged" disabled="@IsLearnToPlayDeckBuilder">
                            @foreach (DeckStructure structure in Enum.GetValues<DeckStructure>())
                            {
                                <option value="@structure">@GetStructureName(structure)</option>
                            }
                        </select>
                    </div>
                    <div class="selected-structure-info">
                        <strong>@GetStructureName(selectedStructure)</strong>
                        <span>@GetStructureDescription(selectedStructure)</span>
                    </div>
                </div>

                <div class="panel-header deck-panel-header">
                    <div>
                        <h2>Your Deck</h2>
                        <span>
                            @if (IsLearnToPlayDeckBuilder)
                            {
                                <text>@workingDeck.Cards.Count / @TutorialRequiredCount tutorial cards</text>
                            }
                            else
                            {
                                <text>@workingDeck.Cards.Count cards · 10-15 required</text>
                            }
                        </span>
                    </div>
                </div>

                <div class="deck-summary">
                    <span>Characters: <strong>@CharacterCount</strong></span>
                    <span>Attacks: <strong>@AttackCount</strong></span>
                    <span>Utilities: <strong>@UtilityCount / 5</strong></span>
                </div>

                @if (workingDeck.Cards.Count == 0)
                {
                    <div class="empty-deck">
                        <strong>Deck is empty.</strong>
                        <span>@(IsLearnToPlayDeckBuilder ? "Find the highlighted Tutorial card in the Card Finder." : "Add cards from the Card Finder.")</span>
                    </div>
                }
                else
                {
                    <div class="deck-list">
                        @for (int i = 0; i < workingDeck.Cards.Count; i++)
                        {
                            int index = i;
                            Card card = workingDeck.Cards[index];
                            int? priority = selectedStructure == DeckStructure.PriorityQueue ? card.Priority : null;

                           <CardBrowseRow
                            @key="@($"deck-{index}-{card.Id}")"
                            Card="@card"
                            Position="@(index + 1)"
                            Priority="@priority"
                            ShowCardPreview="false"
                            ShowMoveControls="@(UsesManualOrder && !IsLearnToPlayDeckBuilder)"
                            DisableMoveUp="@(index == 0)"
                            DisableMoveDown="@(index == workingDeck.Cards.Count - 1)"
                            OnMoveUp="@(() => MoveCardUp(index))"
                            OnMoveDown="@(() => MoveCardDown(index))"
                            ShowRemove="@(!IsLearnToPlayDeckBuilder)"
                            OnRemove="@(() => RemoveCard(index))"
                            StatusText="@(IsLearnToPlayDeckBuilder ? "ADDED" : "")"
                            StatusClass="@(IsLearnToPlayDeckBuilder ? "complete" : "")"
                            Expanded="@(expandedDeckCardIndex == index)"
                            ExpandedChanged="@(expanded => SetDeckCardExpanded(index, expanded))" />
                        }
                    </div>
                }

                <div class="validation-box @GetDisplayedValidationClass() @GetPageTutorialClass("deck-summary")">
                    <strong>DECK STATUS</strong>
                    <span>@(IsLearnToPlayDeckBuilder ? TutorialValidationMessage : ValidationMessage)</span>
                </div>

                <button class="save-button @GetPageTutorialClass("save-deck")"
                        disabled="@(IsLearnToPlayDeckBuilder && !IsTutorialDeckReady)"
                        @onclick="SaveDeck">
                    @(IsLearnToPlayDeckBuilder ? "Save Tutorial Deck & Continue" : "Save Deck")
                </button>

                @if (!string.IsNullOrWhiteSpace(saveMessage))
                {
                    <div class="save-message @(saveSucceeded ? "success" : "error")">@saveMessage</div>
                }
            </section>
        </main>
    </div>
</div>

<PageTutorialOverlay
    Visible="@showPageTutorial"
    Label="DECK BUILDER TUTORIAL"
    Steps="@DeckBuilderPageTutorialSteps"
    CurrentIndex="@pageTutorialStep"
    CurrentIndexChanged="SetPageTutorialStep"
    OnExit="ExitPageTutorial"
    OnFinished="FinishPageTutorial" />

@if (showTutorialBuilderIntro && IsLearnToPlayDeckBuilder)
{
    <div class="builder-overlay">
        <div class="tutorial-builder-dialog" @onclick:stopPropagation="true">
            <div class="tutorial-builder-dialog-icon">FIFO</div>
            <span class="tutorial-builder-dialog-kicker">LEARN TO PLAY · DECK BUILDING</span>
            <h2>Build the Tutorial Queue</h2>
            <p>This deck uses Queue order: <strong>First In, First Out</strong>.</p>

            <div class="tutorial-builder-dialog-steps">
                <div><strong>1</strong><span>Use the real Card Finder and scroll until you find the highlighted required card.</span></div>
                <div><strong>2</strong><span>Only the current required card can be added. Other cards stay inspectable.</span></div>
                <div><strong>3</strong><span>Add all @TutorialRequiredCount cards, save the deck, and continue to Battle.</span></div>
            </div>

            <p class="tutorial-builder-dialog-note">Cards are added in the required Queue order automatically. You do not need to reorder the Tutorial deck.</p>
            <button @onclick="CloseTutorialBuilderIntro">START BUILDING</button>
        </div>
    </div>
}

@if (priorityCard != null)
{
    <div class="builder-overlay" @onclick="CancelPriority">
        <div class="priority-dialog" @onclick:stopPropagation="true">
            <h2>Choose Priority</h2>
            <p><strong>@priorityCard.Name</strong></p>
            @if (priorityCard.Type == CardType.Character)
            {
                <p class="priority-hint">Character cards always use Priority 5.</p>
                <button @onclick="() => AddPriorityCard(5)">Priority 5</button>
            }
            else
            {
                <p class="priority-hint">Choose Priority 1-4. Priority 5 is reserved for Characters.</p>
                <div class="priority-buttons">
                    @for (int priority = 1; priority <= 4; priority++)
                    {
                        int selectedPriority = priority;
                        <button @onclick="() => AddPriorityCard(selectedPriority)">Priority @selectedPriority</button>
                    }
                </div>
            }
            <button class="cancel-button" @onclick="CancelPriority">Cancel</button>
        </div>
    </div>
}

@if (showPriorityConversion)
{
    <div class="builder-overlay">
        <div class="priority-conversion-dialog">
            <h2>Assign Priorities</h2>
            <p>Priority Queue requires every card to have a valid priority.</p>
            <p class="priority-hint">Characters are locked to Priority 5. Attacks and Utilities use Priority 1-4.</p>
            <div class="conversion-list">
                @for (int i = 0; i < workingDeck.Cards.Count; i++)
                {
                    int cardIndex = i;
                    Card card = workingDeck.Cards[cardIndex];
                    <div class="conversion-card">
                        <div class="conversion-card-info"><strong>@card.Name</strong><span>@card.Id · @card.Type</span></div>
                        @if (card.Type == CardType.Character)
                        {
                            <div class="fixed-priority">PRIORITY 5</div>
                        }
                        else
                        {
                            <div class="conversion-buttons">
                                @for (int priority = 1; priority <= 4; priority++)
                                {
                                    int choice = priority;
                                    <button class="@GetConversionPriorityClass(cardIndex, choice)" @onclick="() => SetConversionPriority(cardIndex, choice)">@choice</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="conversion-actions">
                <button class="conversion-confirm" @onclick="ConfirmPriorityConversion">Apply Priorities</button>
                <button @onclick="CancelPriorityConversion">Cancel</button>
            </div>
        </div>
    </div>
}

@if (showTutorialDeckComplete)
{
    <div class="builder-overlay">
        <div class="tutorial-complete-dialog" @onclick:stopPropagation="true">
            <div class="tutorial-complete-icon">✓</div>
            <span class="tutorial-complete-kicker">DECK BUILDING COMPLETE</span>
            <h2>Your Tutorial Deck Is Ready</h2>
            <p>You've built the required @TutorialRequiredCount-card Queue in the order used by the guided Battle.</p>
            <div class="tutorial-complete-details">
                <div><span>DECK</span><strong>Tutorial Deck</strong></div>
                <div><span>STRUCTURE</span><strong>Queue</strong></div>
                <div><span>CARDS</span><strong>@TutorialRequiredCount</strong></div>
            </div>
            <p class="tutorial-complete-note">Next, you'll use this deck in a guided Battle. Incorrect actions will be blocked so you can follow the lesson without restarting.</p>
            <button class="proceed-battle-button" @onclick="ProceedToTutorialBattle">PROCEED TO BATTLE <span>→</span></button>
        </div>
    </div>
}

<style>
* { box-sizing: border-box; }
.builder-page
{
    height: calc(100vh - 58px);
    padding: 12px 18px 12px;
    overflow: hidden;
 background: linear-gradient(160deg,#18212b 0%,#23364a 55%,#3a2428 100%); color:#f5f5f5; }
.builder-shell {
    width:min(1350px,100%);
    height:100%;
    margin:0 auto;

    display:flex;
    flex-direction:column;
    min-height:0;
}

.available-panel {
    display:flex;
    flex-direction:column;
    min-height:0;
}
.builder-header { margin-bottom:10px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
.builder-header h1 { margin:0; color:#f4efe3;  font-size:clamp(24px,3vw,34px); }
.builder-header p { margin:6px 0 0; color:#c8d0d8; }
.header-actions { display:flex; align-items:center; gap:8px; }
.header-actions button { padding:11px 18px; border:1px solid #9b9383; border-radius:6px; background:#f4efe3; color:#222; cursor:pointer; font-weight:bold; }
.header-actions button:hover { background:#e5ddcc; }
.panel-header { margin-bottom:12px; display:flex; align-items:center; justify-content:space-between; }
.panel-header h2 { margin:0; color:#f4efe3; font-size:21px; }
.panel-header span { display:block; margin-top:3px; color:#9da8b2; font-size:10px; }
.compact-deck-name { margin-bottom:12px; padding:9px 11px; display:flex; align-items:center; gap:12px; border:1px solid #596674; border-radius:7px; background:#111820; }
.compact-deck-name label { flex-shrink:0; color:#aeb8c1; font-size:8px; font-weight:900; letter-spacing:.8px; white-space:nowrap; }
.compact-deck-name input { min-width:0; flex:1; padding:7px 9px; border:1px solid #77818a; border-radius:5px; background:#f4efe3; color:#222; font-size:11px; }
.compact-deck-name input:focus,.search-box:focus,.structure-selector-header select:focus { border-color:#e5cc67; outline:none; box-shadow:0 0 0 2px rgba(229,204,103,.16); }
.compact-deck-name input:disabled { background:#d9d1c0; color:#665f54; cursor:default; opacity:.9; }
.search-box { width:100%; margin-bottom:10px; padding:10px 12px; border:1px solid #8b949e; border-radius:6px; background:#f4efe3; color:#222; }
.filter-group { margin-bottom:8px; display:flex; flex-wrap:wrap; gap:6px; }
.filter-group button { padding:7px 10px; border:1px solid #8b949e; border-radius:5px; background:#e9e4d8; color:#222; cursor:pointer; font-size:10px; font-weight:bold; }
.filter-group button:hover { background:#f4efe3; }
.filter-group button.active { border-color:#e5cc67; background:#e5cc67; }
.tutorial-order-guide
{
    margin-bottom:12px;
    padding:18px 20px;
    border:1px solid #b69d55;
    border-left:6px solid #e5cc67;
    border-radius:8px;
    background:rgba(229,204,103,.10);
    color:#f0e5b8;
    font-size:14px;
    font-weight:700;
    line-height:1.65;
    white-space: pre-line;
}

.available-list {
    height: calc(100vh - 398px);
    margin-top: 6px;
    padding-right: 4px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    overflow-y: auto;
}
.builder-page:has(.tutorial-order-guide) .available-list {
    height: calc(100vh - 563px);
}
.deck-structure-selector { margin-bottom:16px; padding:13px; display:flex; flex-direction:column; gap:10px; border:1px solid #596674; border-radius:8px; background:#111a23; }
.structure-selector-header { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.structure-selector-header label { color:#aeb8c1; font-size:9px; font-weight:bold; letter-spacing:.8px; }
.structure-selector-header select { min-width:180px; padding:8px 10px; border:1px solid #8b949e; border-radius:5px; background:#f4efe3; color:#222; font-size:12px; }
.structure-selector-header select:disabled { cursor:default; opacity:.75; }
.selected-structure-info { padding:9px 10px; display:flex; flex-direction:column; gap:4px; border-left:4px solid #e5cc67; background:#18232e; }
.selected-structure-info strong { color:#e5cc67; font-size:11px; letter-spacing:.4px; }
.selected-structure-info span { color:#b9c3cc; font-size:10px; line-height:1.4; }
.deck-panel-header { padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,.09); }
.deck-summary { margin-bottom:12px; display:grid; grid-template-columns:repeat(3,1fr); gap:6px; }
.deck-summary span { padding:7px 5px; border:1px solid #4e5963; border-radius:5px; background:#1a242e; color:#aeb8c1; font-size:9px; text-align:center; }
.deck-summary strong { color:#f4efe3; }
.empty-deck { min-height:230px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; border:1px dashed #5e6973; border-radius:7px; color:#8f9aa4; text-align:center; }
.empty-deck strong { color:#c8d0d8; }
.deck-list { max-height:500px; padding-right:3px; display:flex; flex-direction:column; gap:6px; overflow-y:auto; }
.validation-box { margin-top:14px; padding:10px 11px; display:flex; flex-direction:column; gap:4px; border:1px solid; border-radius:6px; }
.validation-box strong { font-size:8px; letter-spacing:.7px; }
.validation-box span { font-size:10px; line-height:1.3; }
.validation-box.valid { border-color:#4e8d61; background:rgba(67,132,84,.12); color:#9bd5aa; }
.validation-box.invalid { border-color:#985a5a; background:rgba(152,70,70,.12); color:#e9aaaa; }
.save-button { width:100%; margin-top:10px; padding:12px; border:2px solid #9b9383; border-radius:6px; background:#f4efe3; color:#222; cursor:pointer; font-size:13px; font-weight:bold; }
.save-button:hover:not(:disabled) { background:#e5ddcc; }
.save-button:disabled { cursor:default; opacity:.45; }
.save-message { margin-top:8px; padding:8px; border-radius:5px; font-size:10px; text-align:center; }
.save-message.success { background:rgba(59,132,76,.18); color:#9bd5aa; }
.save-message.error { background:rgba(152,70,70,.18); color:#e9aaaa; }
.builder-overlay { position:fixed; inset:0; z-index:10000; padding:20px; display:flex; align-items:center; justify-content:center; background:rgba(7,11,15,.88); }
.tutorial-builder-dialog,.tutorial-complete-dialog { width:min(480px,100%); max-height:calc(100vh - 40px); padding:28px; display:flex; flex-direction:column; align-items:center; gap:12px; overflow-y:auto; border:2px solid #b69d55; border-radius:12px; background:#18232e; color:#f4efe3; text-align:center; box-shadow:0 20px 55px rgba(0,0,0,.55); }
.tutorial-complete-dialog { width:min(470px,100%); border-color:#4f9364; gap:11px; }
.tutorial-builder-dialog-icon,.tutorial-complete-icon { width:60px; height:60px; flex-shrink:0; display:flex; align-items:center; justify-content:center; border:2px solid #e5cc67; border-radius:50%; background:rgba(229,204,103,.1); color:#e5cc67; font-size:13px; font-weight:900; }
.tutorial-complete-icon { width:52px; height:52px; border-color:#81c784; background:rgba(81,199,132,.1); color:#81c784; font-size:24px; }
.tutorial-builder-dialog-kicker,.tutorial-complete-kicker { color:#e5cc67; font-size:8px; font-weight:900; letter-spacing:1.3px; }
.tutorial-complete-kicker { color:#81c784; }
.tutorial-builder-dialog h2,.tutorial-complete-dialog h2 { margin:0; color:#f4efe3; font-size:25px; }
.tutorial-builder-dialog > p,.tutorial-complete-dialog > p { margin:0; color:#bac4cd; font-size:11px; line-height:1.5; }
.tutorial-builder-dialog > p strong { color:#e5cc67; }
.tutorial-builder-dialog-steps { width:100%; display:flex; flex-direction:column; gap:7px; }
.tutorial-builder-dialog-steps > div { padding:10px 12px; display:grid; grid-template-columns:30px minmax(0,1fr); align-items:center; gap:10px; border:1px solid #596674; border-radius:6px; background:#111820; text-align:left; }
.tutorial-builder-dialog-steps strong { width:28px; height:28px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#e5cc67; color:#222; font-size:11px; }
.tutorial-builder-dialog-steps span { color:#c8d0d8; font-size:10px; line-height:1.4; }
.tutorial-builder-dialog .tutorial-builder-dialog-note,.tutorial-complete-note { width:100%; padding:10px 11px; border-left:3px solid #e5cc67; background:rgba(229,204,103,.06); color:#d1c9ac; text-align:left; }
.tutorial-builder-dialog > button,.proceed-battle-button { width:100%; padding:12px 15px; border:2px solid #b69d55; border-radius:7px; background:#e5cc67; color:#222; cursor:pointer; font-size:10px; font-weight:900; letter-spacing:.6px; }
.tutorial-builder-dialog > button:hover,.proceed-battle-button:hover { filter:brightness(1.06); }
.tutorial-complete-details { width:100%; display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }
.tutorial-complete-details > div { padding:10px 7px; display:flex; flex-direction:column; gap:4px; border:1px solid #596674; border-radius:6px; background:#111820; }
.tutorial-complete-details span { color:#89959f; font-size:7px; font-weight:bold; letter-spacing:.7px; }
.tutorial-complete-details strong { color:#f4efe3; font-size:10px; }
.proceed-battle-button { margin-top:3px; display:flex; align-items:center; justify-content:center; gap:9px; font-size:9px; }
.proceed-battle-button span { font-size:15px; }
.priority-dialog { width:min(380px,100%); padding:24px; display:flex; flex-direction:column; gap:12px; border:2px solid #777064; border-radius:10px; background:#18232e; color:#f4efe3; text-align:center; }
.priority-dialog h2,.priority-dialog p,.priority-conversion-dialog h2,.priority-conversion-dialog p { margin:0; }
.priority-hint { color:#b8c2cc; font-size:11px; line-height:1.35; }
.priority-buttons { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.priority-dialog button,.conversion-actions button { padding:10px; border:1px solid #9b9383; border-radius:5px; background:#f4efe3; color:#222; cursor:pointer; font-weight:bold; }
.priority-dialog button:hover,.conversion-actions button:hover { background:#fffaf0; }
.priority-dialog .cancel-button { margin-top:4px; background:#d4d0c6; }
.priority-conversion-dialog { width:min(620px,100%); max-height:calc(100vh - 50px); padding:22px; display:flex; flex-direction:column; gap:12px; overflow:hidden; border:2px solid #777064; border-radius:10px; background:#18232e; color:#f4efe3; }
.priority-conversion-dialog > p { color:#aeb9c3; font-size:11px; line-height:1.35; }
.conversion-list { min-height:0; padding-right:3px; display:flex; flex-direction:column; gap:6px; overflow-y:auto; }
.conversion-card { padding:8px 10px; display:flex; align-items:center; justify-content:space-between; gap:12px; border:1px solid #4e5964; border-radius:6px; background:#111820; }
.conversion-card-info { min-width:0; display:flex; flex-direction:column; gap:2px; }
.conversion-card-info strong { overflow:hidden; color:#f4efe3; font-size:11px; text-overflow:ellipsis; white-space:nowrap; }
.conversion-card-info span { color:#8f9ba5; font-size:7px; text-transform:uppercase; }
.conversion-buttons { flex-shrink:0; display:flex; gap:4px; }
.conversion-buttons button { width:32px; height:32px; padding:0; border:1px solid #77818a; border-radius:5px; background:#e8e8e8; color:#222; cursor:pointer; font-weight:bold; }
.conversion-buttons button.selected { border-color:#e5cc67; background:#e5cc67; box-shadow:0 0 0 2px rgba(229,204,103,.2); }
.fixed-priority { flex-shrink:0; padding:7px 10px; border-radius:5px; background:#4c3d17; color:#e5cc67; font-size:9px; font-weight:bold; }
.conversion-actions { padding-top:10px; display:grid; grid-template-columns:1fr 1fr; gap:7px; border-top:1px solid #46515d; }
.conversion-actions .conversion-confirm { background:#e5cc67; }
.available-list,.deck-list,.conversion-list,.tutorial-builder-dialog,.tutorial-complete-dialog { scrollbar-width:thin; scrollbar-color:#67727d #111820; }
.available-list::-webkit-scrollbar,.deck-list::-webkit-scrollbar,.conversion-list::-webkit-scrollbar,.tutorial-builder-dialog::-webkit-scrollbar,.tutorial-complete-dialog::-webkit-scrollbar { width:8px; }
.available-list::-webkit-scrollbar-track,.deck-list::-webkit-scrollbar-track,.conversion-list::-webkit-scrollbar-track,.tutorial-builder-dialog::-webkit-scrollbar-track,.tutorial-complete-dialog::-webkit-scrollbar-track { background:#111820; }
.available-list::-webkit-scrollbar-thumb,.deck-list::-webkit-scrollbar-thumb,.conversion-list::-webkit-scrollbar-thumb,.tutorial-builder-dialog::-webkit-scrollbar-thumb,.tutorial-complete-dialog::-webkit-scrollbar-thumb { border-radius:8px; background:#67727d; }
.page-tutorial-target { position:relative; z-index:8995; outline:4px solid #ffe078; outline-offset:5px; border-radius:8px; box-shadow:0 0 0 3px rgba(0,0,0,.5),0 0 20px rgba(255,224,120,.72),0 0 42px rgba(229,204,103,.4); animation:pageTutorialTargetPulse 1s ease-in-out infinite alternate; }
.builder-content {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(380px, .75fr);
    align-items: stretch;
    gap: 18px;
    overflow: hidden;
}

.available-panel,
.deck-panel {
    min-width: 0;
    min-height: 0;
    height: 100%;
    padding: 17px;
    border: 1px solid #56616c;
    border-radius: 10px;
    background: rgba(19, 27, 35, .94);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
/* Keep the deck header and summary at their natural sizes */
.deck-panel-header,
.deck-summary,
.validation-box,
.save-button,
.save-message {
    flex-shrink: 0;
}

/* Allow the card area to take up the remaining space */
.deck-list,
.empty-deck {
    flex: 1;
    min-height: 0;
    max-height: none;
}

/* Scroll the cards instead of growing the panel */
.deck-list {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 4px;
}

/* Keep the empty-deck message contained in the same area */
.empty-deck {
    overflow-y: auto;
}
@@keyframes pageTutorialTargetPulse { from { outline-color:rgba(255,224,120,.65); box-shadow:0 0 0 3px rgba(0,0,0,.45),0 0 10px rgba(255,224,120,.4); } to { outline-color:#ffe078; box-shadow:0 0 0 3px rgba(0,0,0,.55),0 0 24px rgba(255,224,120,.85),0 0 48px rgba(229,204,103,.45); } }
@@media (max-width: 900px) {
    .builder-page {
        height: auto;
        min-height: calc(100vh - 58px);
        overflow: visible;
    }

    .builder-shell {
        height: auto;
    }

    .builder-content {
        flex: initial;
        height: auto;
        grid-template-columns: minmax(0, 1fr);
        overflow: visible;
    }

    .available-panel,
    .deck-panel {
        height: 650px;
    }

    .available-list,
    .deck-list {
        min-height: 0;
        max-height: none;
        flex: 1;
        overflow-y: auto;
    }
}@@media (max-width:650px) { .builder-page { padding:22px 12px 40px; } .builder-header { align-items:stretch; flex-direction:column; } .header-actions { width:100%; } .header-actions button { flex:1; } .compact-deck-name,.structure-selector-header { align-items:stretch; flex-direction:column; } .compact-deck-name input,.structure-selector-header select { width:100%; min-width:0; } .deck-summary,.tutorial-complete-details,.conversion-actions { grid-template-columns:1fr; } .tutorial-builder-dialog,.tutorial-complete-dialog { padding:22px 18px; } .conversion-card { align-items:stretch; flex-direction:column; } .conversion-buttons { width:100%; } .conversion-buttons button { flex:1; } }
</style>

@code {
    private List<Card> allCards = new();
    private Deck workingDeck = new();
    private string deckName = "";
    private string searchText = "";
    private CardType? selectedType;
    private Archetype? selectedArchetype;
    private DeckStructure selectedStructure = DeckStructure.Queue;
    private DeckStructure previousStructure = DeckStructure.Queue;
    private Card? priorityCard;
    private bool showPriorityConversion;
    private Dictionary<int, int> conversionPriorities = new();
    private string saveMessage = "";
    private bool saveSucceeded;
    private bool showTutorialDeckComplete;
    private bool showTutorialBuilderIntro;
    private string? expandedFinderCardId;
    private int? expandedDeckCardIndex;

    private int TutorialRequiredCount => TutorialManager.LearnToPlayDeckOrder.Count;

    private bool IsLearnToPlayDeckBuilder =>
        Session.Tutorial.IsActive &&
        Session.Tutorial.CurrentTutorial == TutorialType.LearnToPlay &&
        Session.Tutorial.TutorialDeck == null;

    private bool IsTutorialDeckReady =>
        IsLearnToPlayDeckBuilder &&
        IsDeckValid &&
        selectedStructure == DeckStructure.Queue &&
        TutorialManager.IsLearnToPlayDeckComplete(workingDeck) &&
        TutorialManager.IsLearnToPlayDeckOrderCorrect(workingDeck);

    private string TutorialValidationMessage
    {
        get
        {
            if (!IsLearnToPlayDeckBuilder) return ValidationMessage;
            if (selectedStructure != DeckStructure.Queue) return "The Learn to Play deck must use the Queue structure.";
            if (!TutorialManager.IsLearnToPlayDeckComplete(workingDeck)) return $"Find and add all {TutorialRequiredCount} required Tutorial cards. {TutorialManager.GetLearnToPlayDeckProgress(workingDeck)}";
            if (!TutorialManager.IsLearnToPlayDeckOrderCorrect(workingDeck)) return "The Tutorial Queue order is not correct.";
            if (!IsDeckValid) return ValidationMessage;
            return "Tutorial deck complete. Save it to continue.";
        }
    }

    private List<Card> FilteredCards
    {
        get
        {
            IEnumerable<Card> cards = allCards;
            if (!string.IsNullOrWhiteSpace(searchText)) cards = CardLibraryManager.LinearSearch(allCards, searchText);
            if (selectedType != null) cards = cards.Where(card => card.Type == selectedType.Value);
            if (selectedArchetype != null) cards = cards.Where(card => card.Archetype == selectedArchetype.Value);
            return cards.ToList();
        }
    }

    private int CharacterCount => workingDeck.Cards.Count(card => card.Type == CardType.Character);
    private int AttackCount => workingDeck.Cards.Count(card => card.Type == CardType.Attack);
    private int UtilityCount => workingDeck.Cards.Count(card => card.Type == CardType.Utility);
    private bool UsesManualOrder => selectedStructure == DeckStructure.Queue || selectedStructure == DeckStructure.Stack;

    private string ValidationMessage
    {
        get
        {
            workingDeck.Structure = selectedStructure;
            return RedPandaTCD_Web.Game.DeckBuilder.ValidateDeck(workingDeck, out string error) ? "Deck is valid and ready to save." : error;
        }
    }

    private bool IsDeckValid
    {
        get
        {
            workingDeck.Structure = selectedStructure;
            return RedPandaTCD_Web.Game.DeckBuilder.ValidateDeck(workingDeck, out _);
        }
    }

    protected override void OnInitialized()
    {
        showPageTutorial = PageTutorialRequested;
        pageTutorialStep = 0;
        allCards = CardLibraryManager.GetAllCards();

        if (IsLearnToPlayDeckBuilder)
        {
            selectedStructure = DeckStructure.Queue;
            previousStructure = DeckStructure.Queue;
            deckName = "Tutorial Deck";
            showTutorialBuilderIntro = true;
            showPageTutorial = false;
        }

        if (EditDeckIndex != null)
{
    Deck? existingDeck =
        DeckManager.GetDeck(
            EditDeckIndex.Value);

    if (existingDeck != null)
    {
        workingDeck =
            existingDeck;

        deckName =
            existingDeck.Name;

        selectedStructure =
            existingDeck.Structure;

        previousStructure =
            existingDeck.Structure;
    }
    else
    {
        workingDeck = new Deck
        {
            Name = "",
            Structure = selectedStructure
        };
    }
}
else
{
    workingDeck = new Deck
    {
        Name = IsLearnToPlayDeckBuilder
            ? "Tutorial Deck"
            : "",

        Structure = selectedStructure
    };
}

        previousStructure = selectedStructure;
    }

    private void CloseTutorialBuilderIntro() => showTutorialBuilderIntro = false;

  private string GetTutorialBuilderInstruction()
{
    if (!IsLearnToPlayDeckBuilder)
        return "";

    int nextPosition =
        workingDeck.Cards.Count;

    if (nextPosition >= TutorialRequiredCount)
    {
        return
            $"Tutorial Queue complete. All {TutorialRequiredCount} cards are ready. Save the deck to continue.";
    }

    string requiredId =
        TutorialManager.LearnToPlayDeckOrder[nextPosition];

    return
        TutorialManager.GetLearnToPlayDeckInstruction(
            requiredId);
}

    private bool CanAddTutorialCard(Card card)
    {
        if (!IsLearnToPlayDeckBuilder) return true;
        int nextPosition = workingDeck.Cards.Count;
        if (nextPosition >= TutorialRequiredCount) return false;
        return string.Equals(card.Id, TutorialManager.LearnToPlayDeckOrder[nextPosition], StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCurrentTutorialCard(Card card) => IsLearnToPlayDeckBuilder && CanAddTutorialCard(card);

    private bool IsTutorialCardAlreadyAdded(Card card) => IsLearnToPlayDeckBuilder && workingDeck.Cards.Any(existing => string.Equals(existing.Id, card.Id, StringComparison.OrdinalIgnoreCase));

    private string GetFinderStatusText(Card card)
    {
        if (!IsLearnToPlayDeckBuilder) return "";
        if (IsTutorialCardAlreadyAdded(card)) return "ADDED";
        if (IsCurrentTutorialCard(card)) return "FIND & ADD";
        return "";
    }

    private string GetFinderStatusClass(Card card) => IsTutorialCardAlreadyAdded(card) ? "complete" : "";

    private string GetAddDisabledTitle(Card card)
    {
        if (IsLearnToPlayDeckBuilder && !CanAddTutorialCard(card)) return "Find the highlighted Tutorial card next.";
        if (!CanAddCard(card)) return "Deck rules prevent adding this card right now.";
        return "Add card to deck";
    }

    private bool IsFinderCardExpanded(Card card) => string.Equals(expandedFinderCardId, card.Id, StringComparison.OrdinalIgnoreCase);

    private Task SetFinderCardExpanded(Card card, bool expanded)
    {
        expandedFinderCardId = expanded ? card.Id : null;
        return Task.CompletedTask;
    }

    private Task SetDeckCardExpanded(int index, bool expanded)
    {
        expandedDeckCardIndex = expanded ? index : null;
        return Task.CompletedTask;
    }

    private void StructureChanged()
    {
        DeckStructure newStructure = selectedStructure;
        workingDeck.Structure = newStructure;
        saveMessage = "";
        expandedDeckCardIndex = null;
        if (newStructure == DeckStructure.PriorityQueue)
        {
            conversionPriorities.Clear();
            for (int i = 0; i < workingDeck.Cards.Count; i++) conversionPriorities[i] = workingDeck.Cards[i].Type == CardType.Character ? 5 : 1;
            if (workingDeck.Cards.Count > 0) { showPriorityConversion = true; return; }
            previousStructure = DeckStructure.PriorityQueue;
            return;
        }
        showPriorityConversion = false;
        conversionPriorities.Clear();
        foreach (Card card in workingDeck.Cards) card.Priority = 0;
        previousStructure = newStructure;
    }

    private bool CanAddCard(Card card)
    {
        int maximumDeckSize = IsLearnToPlayDeckBuilder ? TutorialRequiredCount : 15;
        if (workingDeck.Cards.Count >= maximumDeckSize) return false;
        int copies = workingDeck.Cards.Count(existing => string.Equals(existing.Id, card.Id, StringComparison.OrdinalIgnoreCase));
        return card.Type switch
        {
            CardType.Character => copies < 1 && CharacterCount < 2,
            CardType.Attack => copies < 2,
            CardType.Utility => UtilityCount < 5 && copies < 1,
            _ => false
        };
    }

    private void RequestAddCard(Card card)
    {
        if (!CanAddCard(card) || !CanAddTutorialCard(card)) return;
        saveMessage = "";
        saveSucceeded = false;
        workingDeck.Structure = selectedStructure;
        if (selectedStructure == DeckStructure.PriorityQueue) { priorityCard = card; return; }
        if (!RedPandaTCD_Web.Game.DeckBuilder.AddCard(workingDeck, card)) { saveMessage = "The selected card could not be added."; return; }
        expandedFinderCardId = null;
        if (IsLearnToPlayDeckBuilder && workingDeck.Cards.Count >= TutorialRequiredCount) { saveMessage = "Tutorial Queue complete. Save the deck to continue."; saveSucceeded = true; }
    }

    private void AddPriorityCard(int priority)
    {
        if (priorityCard == null) return;
        workingDeck.Structure = selectedStructure;
        if (!RedPandaTCD_Web.Game.DeckBuilder.AddCard(workingDeck, priorityCard, priority)) { saveSucceeded = false; saveMessage = "That priority is not valid for this card."; return; }
        priorityCard = null;
        saveMessage = "";
    }

    private void CancelPriority() => priorityCard = null;

    private void SetConversionPriority(int cardIndex, int priority)
    {
        if (cardIndex < 0 || cardIndex >= workingDeck.Cards.Count) return;
        Card card = workingDeck.Cards[cardIndex];
        if (card.Type == CardType.Character) { conversionPriorities[cardIndex] = 5; return; }
        if (priority < 1 || priority > 4) return;
        conversionPriorities[cardIndex] = priority;
    }

    private string GetConversionPriorityClass(int cardIndex, int priority) => conversionPriorities.TryGetValue(cardIndex, out int selected) && selected == priority ? "selected" : "";

    private void ConfirmPriorityConversion()
    {
        for (int i = 0; i < workingDeck.Cards.Count; i++)
        {
            Card card = workingDeck.Cards[i];
            if (card.Type == CardType.Character) { card.Priority = 5; continue; }
            if (!conversionPriorities.TryGetValue(i, out int priority) || priority < 1 || priority > 4) return;
            card.Priority = priority;
        }
        selectedStructure = DeckStructure.PriorityQueue;
        workingDeck.Structure = DeckStructure.PriorityQueue;
        previousStructure = DeckStructure.PriorityQueue;
        showPriorityConversion = false;
        conversionPriorities.Clear();
        saveMessage = "";
    }

    private void CancelPriorityConversion()
    {
        showPriorityConversion = false;
        conversionPriorities.Clear();
        selectedStructure = previousStructure;
        workingDeck.Structure = previousStructure;
        if (previousStructure != DeckStructure.PriorityQueue) foreach (Card card in workingDeck.Cards) card.Priority = 0;
    }

    private void RemoveCard(int index)
    {
        if (IsLearnToPlayDeckBuilder) return;
        RedPandaTCD_Web.Game.DeckBuilder.RemoveCard(workingDeck, index);
        expandedDeckCardIndex = null;
        saveMessage = "";
        saveSucceeded = false;
    }

    private void MoveCardUp(int index)
    {
        if (IsLearnToPlayDeckBuilder) return;
        RedPandaTCD_Web.Game.DeckBuilder.MoveCardUp(workingDeck, index);
        expandedDeckCardIndex = null;
        saveMessage = "";
        saveSucceeded = false;
    }

    private void MoveCardDown(int index)
    {
        if (IsLearnToPlayDeckBuilder) return;
        RedPandaTCD_Web.Game.DeckBuilder.MoveCardDown(workingDeck, index);
        expandedDeckCardIndex = null;
        saveMessage = "";
        saveSucceeded = false;
    }

private void SaveDeck()
{
    workingDeck.Structure = selectedStructure;
    workingDeck.Name = deckName.Trim();

    if (IsLearnToPlayDeckBuilder)
    {
        SaveLearnToPlayDeck();
        return;
    }

    string error;
    bool success;

    if (EditDeckIndex != null)
    {
        success =
            DeckManager.UpdateDeck(
                EditDeckIndex.Value,
                workingDeck,
                deckName,
                out error);

        saveSucceeded = success;

        if (!success)
        {
            saveMessage = error;
            return;
        }

        saveMessage =
            "Deck updated successfully.";

        return;
    }

    success =
        DeckManager.SaveDeck(
            workingDeck,
            deckName,
            out error);

    saveSucceeded = success;

    if (!success)
    {
        saveMessage = error;
        return;
    }

    string savedName =
        deckName.Trim();

    ResetBuilder();

    saveSucceeded = true;

    saveMessage =
        $"{savedName} saved successfully.";
}

    private void SaveLearnToPlayDeck()
    {
        workingDeck.Structure = DeckStructure.Queue;
        workingDeck.Name = "Tutorial Deck";
        if (!TutorialManager.IsLearnToPlayDeckComplete(workingDeck)) { saveSucceeded = false; saveMessage = $"Add all {TutorialRequiredCount} required Tutorial cards first."; return; }
        if (!TutorialManager.IsLearnToPlayDeckOrderCorrect(workingDeck)) { saveSucceeded = false; saveMessage = "The Tutorial Queue order is incorrect."; return; }
        if (!IsTutorialDeckReady) { saveSucceeded = false; saveMessage = "Complete the required Tutorial deck first."; return; }
        bool success = DeckManager.SaveDeck(workingDeck, deckName, out string error);
        if (!success) { saveSucceeded = false; saveMessage = error; return; }
        Session.Tutorial.TutorialDeck = DeckCloner.Clone(workingDeck);
        saveSucceeded = true;
        saveMessage = "Tutorial Deck saved.";
        showTutorialDeckComplete = true;
    }

    private void ProceedToTutorialBattle()
    {
        if (Session.Tutorial.TutorialDeck == null) { showTutorialDeckComplete = false; saveSucceeded = false; saveMessage = "The Tutorial deck could not be loaded."; return; }
        showTutorialDeckComplete = false;
        Session.CurrentMatch = GameSetupManager.StartLearnToPlayMatch(Session.PlayerName, Session.Tutorial.TutorialDeck);
        Navigation.NavigateTo("/battle");
    }

    private void ExitLearnToPlayBuilder()
{
    DeckManager.DeleteTutorialDeck();

    Session.Tutorial.TutorialDeck = null;

    TutorialManager.ExitTutorial(
        Session.Tutorial);

    Navigation.NavigateTo("/tutorial");
}

    private void ResetBuilder()
    {
        deckName = "";
        searchText = "";
        selectedType = null;
        selectedArchetype = null;
        priorityCard = null;
        showPriorityConversion = false;
        showTutorialDeckComplete = false;
        showTutorialBuilderIntro = false;
        expandedFinderCardId = null;
        expandedDeckCardIndex = null;
        conversionPriorities.Clear();
        workingDeck = new Deck { Name = "", Structure = selectedStructure };
        previousStructure = selectedStructure;
    }

    private void SetTypeFilter(CardType? type) => selectedType = type;
    private void SetArchetypeFilter(Archetype? archetype) => selectedArchetype = archetype;
    private string GetTypeButtonClass(CardType? type) => selectedType == type ? "active" : "";
    private string GetArchetypeButtonClass(Archetype? archetype) => selectedArchetype == archetype ? "active" : "";
    private string GetValidationClass() => IsDeckValid ? "valid" : "invalid";
    private string GetDisplayedValidationClass() => IsLearnToPlayDeckBuilder ? (IsTutorialDeckReady ? "valid" : "invalid") : GetValidationClass();

    private static string GetStructureName(DeckStructure structure) => structure switch
    {
        DeckStructure.Queue => "Queue",
        DeckStructure.Stack => "Stack",
        DeckStructure.PriorityQueue => "Priority Queue",
        DeckStructure.RandomList => "Random List",
        DeckStructure.LinkedList => "Linked List",
        _ => structure.ToString()
    };

    private static string GetStructureDescription(DeckStructure structure) => structure switch
    {
        DeckStructure.Queue => "First In, First Out. Deck order matters.",
        DeckStructure.Stack => "Last In, First Out. Deck order matters and Placement is automatic.",
        DeckStructure.PriorityQueue => "Cards draw by priority. Characters use Priority 5; other cards use Priority 1-4.",
        DeckStructure.RandomList => "Cards are drawn from a randomized list.",
        DeckStructure.LinkedList => "The deck uses linked nodes and supports node reordering during play.",
        _ => ""
    };

    private void GoToDecks() => Navigation.NavigateTo("/decks");
    private void GoHome() => Navigation.NavigateTo("/");

    [SupplyParameterFromQuery(Name = "tutorial")]
    public bool PageTutorialRequested { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
        public int? EditDeckIndex { get; set; }

    private bool showPageTutorial;
    private int pageTutorialStep;

    private static readonly IReadOnlyList<PageTutorialStep> DeckBuilderPageTutorialSteps = new List<PageTutorialStep>
    {
        new() { Title="Deck Builder", Message="The Deck Builder creates decks used in battles, tournaments, and simulations. The Card Finder is on the left and your deck is on the right.", Target="builder-page" },
        new() { Title="Card Finder", Message="Browse compact card rows here. Click a row or its arrow to inspect the full card before adding it.", Target="available-cards" },
        new() { Title="Search and Filters", Message="Search by card name or ID, then narrow results by type and archetype.", Target="card-filters" },
        new() { Title="Deck Name", Message="Give the deck a recognizable name before saving it.", Target="deck-name" },
        new() { Title="Data Structure", Message="The selected data structure determines how cards are stored, retrieved, inspected, recycled, and sometimes deployed.", Target="structure-selector" },
        new() { Title="Your Deck", Message="Added cards appear here. You can inspect them and, when the structure uses manual order, arrange them with the move controls.", Target="built-deck" },
        new() { Title="Card Ordering", Message="Queue and Stack decks depend on card order. Priority Queue decks use assigned priority values instead.", Target="built-deck" },
        new() { Title="Validation", Message="The summary and status message explain whether the deck is legal and what still needs to be corrected.", Target="deck-summary" },
        new() { Title="Save Deck", Message="Once the deck is valid, save it for battle, Tournament, and Simulator deck selection.", Target="save-deck" },
        new() { Title="Deck Builder Tutorial Complete", Message="You now know how to find and inspect cards, select a structure, assemble a legal deck, arrange it, and save it.", Target="builder-page" }
    };

    private string GetPageTutorialClass(string target)
    {
        if (!showPageTutorial || pageTutorialStep < 0 || pageTutorialStep >= DeckBuilderPageTutorialSteps.Count) return "";
        return string.Equals(DeckBuilderPageTutorialSteps[pageTutorialStep].Target, target, StringComparison.OrdinalIgnoreCase) ? "page-tutorial-target" : "";
    }

    private Task SetPageTutorialStep(int step) { pageTutorialStep = step; return Task.CompletedTask; }
    private void FinishPageTutorial() { Session.Tutorial.DeckBuilderCompleted = true; showPageTutorial = false; Navigation.NavigateTo("/tutorial"); }
    private void ExitPageTutorial() { showPageTutorial = false; Navigation.NavigateTo("/tutorial"); }


}
