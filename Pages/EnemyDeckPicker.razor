@page "/enemy-deck"
@using RedPandaTCD_Web.Game
@using RedPandaTCD_Web.Component
@inject GameSessionState Session
@inject NavigationManager Navigation

<PageTitle>Choose Enemy Deck - Red Panda TCD</PageTitle>

<div class="deck-page">

    <DeckPicker
        Title="Choose Enemy Deck"
        Subtitle="@PlayerDeckText"
        OnDeckSelected="SelectEnemyDeck"
        OnBack="GoBack"
        BackText="Back to Your Deck" />

</div>

<ConfirmDialog
    IsVisible="showConfirmation"
    Title="Start Training Match?"
    Message="Confirm both decks before beginning."
    ConfirmText="@(isStartingMatch ? "Starting..." : "Start Match")"
    CancelText="Choose Another Deck"
    OnConfirm="StartMatch"
    OnCancel="CancelConfirmation">

    <DialogContent>

        @if (Session.TrainingPlayerDeck != null &&
             Session.TrainingBotDeck != null)
        {
            <div class="match-summary">

                <div class="bot-difficulty-picker">

                    <div class="difficulty-heading">
                        <div>
                            <span class="difficulty-eyebrow">
                                BATTLE SETTINGS
                            </span>

                            <label class="difficulty-title">
                                Choose Your Challenge
                            </label>
                        </div>

                        <span class="difficulty-current">
                            @selectedDifficulty.ToString().ToUpperInvariant()
                        </span>
                    </div>

                    <div class="difficulty-options"
                         role="radiogroup"
                         aria-label="Training bot difficulty">

                        <label class="difficulty-option easy-option
                            @(selectedDifficulty == BotDifficulty.Easy ? "selected" : "")">

                            <input type="radio"
                                   name="bot-difficulty"
                                   value="@BotDifficulty.Easy"
                                   checked="@(selectedDifficulty == BotDifficulty.Easy)"
                                   @onchange="@(() => selectedDifficulty = BotDifficulty.Easy)" />

                            <span class="difficulty-icon">I</span>

                            <span class="difficulty-name">Easy</span>

                            <span class="difficulty-description">
                                Learn the basics
                            </span>

                            <span class="difficulty-indicator">
                                @(selectedDifficulty == BotDifficulty.Easy ? "SELECTED" : "SELECT")
                            </span>

                        </label>

                        <label class="difficulty-option medium-option
                            @(selectedDifficulty == BotDifficulty.Medium ? "selected" : "")">

                            <input type="radio"
                                   name="bot-difficulty"
                                   value="@BotDifficulty.Medium"
                                   checked="@(selectedDifficulty == BotDifficulty.Medium)"
                                   @onchange="@(() => selectedDifficulty = BotDifficulty.Medium)" />

                            <span class="difficulty-icon">II</span>

                            <span class="difficulty-name">Medium</span>

                            <span class="difficulty-description">
                                Test your strategy
                            </span>

                            <span class="difficulty-indicator">
                                @(selectedDifficulty == BotDifficulty.Medium ? "SELECTED" : "SELECT")
                            </span>

                        </label>

                        <label class="difficulty-option hard-option
                            @(selectedDifficulty == BotDifficulty.Hard ? "selected" : "")">

                            <input type="radio"
                                   name="bot-difficulty"
                                   value="@BotDifficulty.Hard"
                                   checked="@(selectedDifficulty == BotDifficulty.Hard)"
                                   @onchange="@(() => selectedDifficulty = BotDifficulty.Hard)" />

                            <span class="difficulty-icon">III</span>

                            <span class="difficulty-name">Hard</span>

                            <span class="difficulty-description">
                                Face a tougher opponent
                            </span>

                            <span class="difficulty-indicator">
                                @(selectedDifficulty == BotDifficulty.Hard ? "SELECTED" : "SELECT")
                            </span>

                        </label>

                    </div>

                    <p class="difficulty-footer">
                        Your choice applies to this training match.
                        Tournament matches remain on Medium.
                    </p>

                </div>

                <div class="summary-section">

                    <span class="summary-label">
                        YOUR DECK
                    </span>

                    <strong>
                        @Session.TrainingPlayerDeck.Name
                    </strong>

                    <small>
                        @GetStructureName(
                            Session.TrainingPlayerDeck.Structure)
                    </small>

                </div>

                <div class="summary-divider"></div>

                <div class="summary-section">

                    <span class="summary-label">
                        ENEMY DECK
                    </span>

                    <strong>
                        @Session.TrainingBotDeck.Name
                    </strong>

                    <small>
                        @GetStructureName(
                            Session.TrainingBotDeck.Structure)
                    </small>

                </div>

            </div>
        }

    </DialogContent>

</ConfirmDialog>

@if (showNameDialog)
{
    <div class="name-overlay"
         @onclick="CancelNameDialog">

        <div class="name-dialog"
             @onclick:stopPropagation="true">

            <h2>
                Enter Your Name
            </h2>

            <p>
                A player name is required before starting the match.
            </p>

            <form @onsubmit="SubmitNameAndStart"
                  @onsubmit:preventDefault>

                <input @bind="pendingPlayerName"
                       @bind:event="oninput"
                       placeholder="Player name"
                       maxlength="24"
                       autofocus />

                @if (!string.IsNullOrWhiteSpace(nameError))
                {
                    <p class="name-error">
                        @nameError
                    </p>
                }

                <button type="submit"
                        disabled="@isStartingMatch">

                    @(isStartingMatch
                        ? "Starting..."
                        : "Start Match")

                </button>

                <button type="button"
                        class="secondary-button"
                        disabled="@isStartingMatch"
                        @onclick="CancelNameDialog">

                    Cancel

                </button>

            </form>

        </div>

    </div>
}

<style>
/* ================================
   BOT DIFFICULTY SELECTOR
   ================================ */

.bot-difficulty-picker {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;

    border: 1px solid rgba(229, 204, 103, 0.3);
    border-radius: 12px;

    background:
        radial-gradient(
            circle at top right,
            rgba(229, 204, 103, 0.09),
            transparent 45%
        ),
        linear-gradient(145deg, #1b2733, #111820);

    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.035),
        0 8px 20px rgba(0, 0, 0, 0.12);
}

.difficulty-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.difficulty-heading > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.difficulty-eyebrow {
    color: #c6ad63;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1.8px;
}

.difficulty-title {
    color: #f4efe3;
    font-size: 18px;
    font-weight: 800;
}

.difficulty-current {
    padding: 6px 9px;
    border: 1px solid rgba(229, 204, 103, 0.45);
    border-radius: 5px;

    background: rgba(229, 204, 103, 0.09);
    color: #e5cc67;

    font-size: 8px;
    font-weight: 800;
    letter-spacing: 1px;
}

.difficulty-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
}

.difficulty-option {
    position: relative;
    min-width: 0;
    min-height: 142px;
    padding: 14px 9px 11px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 7px;

    border: 1px solid #465360;
    border-radius: 9px;

    background: rgba(255, 255, 255, 0.025);
    color: #f4efe3;

    text-align: center;
    cursor: pointer;

    transition:
        transform 160ms ease,
        border-color 160ms ease,
        background 160ms ease,
        box-shadow 160ms ease;
}

.difficulty-option input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
}

.difficulty-option:hover {
    transform: translateY(-2px);
    border-color: #9b9383;
    background: rgba(255, 255, 255, 0.045);
}

.difficulty-option:has(input:focus-visible) {
    outline: 3px solid #f4efe3;
    outline-offset: 3px;
}

.difficulty-icon {
    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #566370;
    border-radius: 50%;

    background: #202d39;
    color: #d7dfe6;

    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
}

.difficulty-name {
    font-size: 14px;
    font-weight: 800;
}

.difficulty-description {
    color: #aeb8c1;
    font-size: 9px;
    line-height: 1.4;
}

.difficulty-indicator {
    margin-top: auto;
    padding-top: 5px;

    color: #8c98a3;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: 1px;
}

/* Easy — calm green accent */

.easy-option.selected {
    border-color: #67bd8a;
    background: linear-gradient(
        160deg,
        rgba(67, 153, 99, 0.19),
        rgba(20, 34, 29, 0.8)
    );

    box-shadow: inset 0 0 18px rgba(103, 189, 138, 0.06);
}

.easy-option.selected .difficulty-icon {
    border-color: #67bd8a;
    background: #244735;
    color: #a6efc0;
}

.easy-option.selected .difficulty-indicator {
    color: #8fe0ad;
}

/* Medium — signature gold accent */

.medium-option.selected {
    border-color: #e5cc67;
    background: linear-gradient(
        160deg,
        rgba(229, 204, 103, 0.17),
        rgba(42, 36, 22, 0.8)
    );

    box-shadow:
        inset 0 0 18px rgba(229, 204, 103, 0.07),
        0 0 12px rgba(229, 204, 103, 0.05);
}

.medium-option.selected .difficulty-icon {
    border-color: #e5cc67;
    background: #40371f;
    color: #ffe99a;
}

.medium-option.selected .difficulty-indicator {
    color: #e5cc67;
}

/* Hard — crimson accent */

.hard-option.selected {
    border-color: #dc777d;
    background: linear-gradient(
        160deg,
        rgba(190, 67, 78, 0.19),
        rgba(43, 24, 29, 0.8)
    );

    box-shadow: inset 0 0 18px rgba(220, 119, 125, 0.06);
}

.hard-option.selected .difficulty-icon {
    border-color: #dc777d;
    background: #48272c;
    color: #ffb3b7;
}

.hard-option.selected .difficulty-indicator {
    color: #ff9da3;
}

.difficulty-footer {
    margin: 0;
    color: #9ca8b3;
    font-size: 9px;
    line-height: 1.5;
    text-align: center;
}

@@media (max-width: 440px) {
    .bot-difficulty-picker {
        padding: 13px;
    }

    .difficulty-options {
        grid-template-columns: 1fr;
    }

    .difficulty-option {
        min-height: 0;
        padding: 11px 12px;

        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto;
        grid-template-rows: auto auto;
        column-gap: 10px;

        text-align: left;
    }

    .difficulty-icon {
        grid-column: 1;
        grid-row: 1 / span 2;
    }

    .difficulty-name {
        grid-column: 2;
        grid-row: 1;
    }

    .difficulty-description {
        grid-column: 2;
        grid-row: 2;
    }

    .difficulty-indicator {
        grid-column: 3;
        grid-row: 1 / span 2;
        margin-top: 0;
        align-self: center;
    }
}

@@media (prefers-reduced-motion: reduce) {
    .difficulty-option {
        transition: none;
    }

    .difficulty-option:hover {
        transform: none;
    }
}
    .deck-page {
        min-height: calc(100vh - 58px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
        box-sizing: border-box;

        background:
            linear-gradient(
                160deg,
                #18212b 0%,
                #23364a 55%,
                #3a2428 100%
            );
    }

    /* CONFIRMATION SUMMARY */

    .match-summary {
        display: flex;
        flex-direction: column;

        gap: 12px;
    }

    .summary-section {
        display: flex;
        flex-direction: column;

        gap: 3px;
    }

    .summary-label {
        color: #9daab5;

        font-size: 8px;
        font-weight: bold;

        letter-spacing: 0.8px;
    }

    .summary-section strong {
        color: #f4efe3;

        font-size: 15px;
    }

    .summary-section small {
        color: #b8c0c7;

        font-size: 10px;
    }

    .summary-divider {
        height: 1px;

        background:
            rgba(255, 255, 255, 0.12);
    }

    /* PLAYER NAME DIALOG */

    .name-overlay {
        position: fixed;
        inset: 0;

        z-index: 10000;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 20px;

        background:
            rgba(7, 11, 15, 0.82);
    }

    .name-dialog {
        width: min(380px, 100%);

        box-sizing: border-box;

        padding: 26px;

        display: flex;
        flex-direction: column;

        gap: 12px;

        border: 2px solid #9b9383;
        border-radius: 11px;

        background: #18212b;
        color: #f5f5f5;

        text-align: center;

        box-shadow:
            0 18px 45px
            rgba(0, 0, 0, 0.45);
    }

    .name-dialog h2 {
        margin: 0;

        color: #f4efe3;

        font-size: 25px;
    }

    .name-dialog > p {
        margin: 0;

        color: #c8d0d8;

        font-size: 12px;
        line-height: 1.45;
    }

    .name-dialog form {
        display: flex;
        flex-direction: column;

        gap: 10px;

        margin-top: 6px;
    }

    .name-dialog input {
        width: 100%;
        box-sizing: border-box;

        padding: 12px 14px;

        border: 2px solid #9b9383;
        border-radius: 7px;

        background: #f4efe3;
        color: #222222;

        outline: none;

        text-align: center;
        font-size: 15px;
    }

    .name-dialog input:focus {
        border-color: #d4c6a5;
    }

    .name-dialog button {
        width: 100%;

        padding: 11px 14px;

        border: 1px solid #9b9383;
        border-radius: 7px;

        background: #f4efe3;
        color: #222222;

        cursor: pointer;

        font-weight: bold;
    }

    .name-dialog button:hover:not(:disabled) {
        background: #e5ddcc;
    }

    .name-dialog button:disabled {
        cursor: default;
        opacity: 0.55;
    }

    .name-dialog .secondary-button {
        background: #29333e;
        color: #e7ebef;
    }

    .name-dialog .secondary-button:hover:not(:disabled) {
        background: #36424e;
    }

    .name-error {
        margin: 0;

        color: #ffb3b3;

        font-size: 12px;
        font-weight: bold;
    }
</style>

@code {
    private bool showConfirmation;
    private bool showNameDialog;
    private bool isStartingMatch;

    private string pendingPlayerName = "";
    private string nameError = "";

    private string PlayerDeckText =>
        Session.TrainingPlayerDeck == null
            ? ""
            : $"Your Deck: {Session.TrainingPlayerDeck.Name} ({GetStructureName(Session.TrainingPlayerDeck.Structure)})";

    protected override void OnInitialized()
    {
        if (Session.TrainingPlayerDeck == null)
        {
            Navigation.NavigateTo(
                "/player-deck");
        }
    }

    private void SelectEnemyDeck(
        Deck deck)
    {
        if (isStartingMatch)
        {
            return;
        }

        Session.TrainingBotDeck =
            deck;

        showConfirmation =
            true;
    }

    private void CancelConfirmation()
    {
        if (isStartingMatch)
        {
            return;
        }

        showConfirmation =
            false;
    }

    private void StartMatch()
    {
        if (isStartingMatch)
        {
            return;
        }

        if (Session.TrainingPlayerDeck == null)
        {
            showConfirmation =
                false;

            Navigation.NavigateTo(
                "/player-deck");

            return;
        }

        if (Session.TrainingBotDeck == null)
        {
            showConfirmation =
                false;

            return;
        }

        if (!Session.HasPlayerName)
        {
            pendingPlayerName =
                "";

            nameError =
                "";

            showConfirmation =
                false;

            showNameDialog =
                true;

            return;
        }

        CreateAndStartMatch();
    }

    private void SubmitNameAndStart()
    {
        if (isStartingMatch)
        {
            return;
        }

        string name =
            pendingPlayerName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            nameError =
                "Please enter a player name.";

            return;
        }

        Session.PlayerName =
            name;

        showNameDialog =
            false;

        nameError =
            "";

        CreateAndStartMatch();
    }

    private void CancelNameDialog()
    {
        if (isStartingMatch)
        {
            return;
        }

        showNameDialog =
            false;

        pendingPlayerName =
            "";

        nameError =
            "";

        // Return to the deck confirmation instead of
        // making the player choose the enemy deck again.
        if (Session.TrainingPlayerDeck != null &&
            Session.TrainingBotDeck != null)
        {
            showConfirmation =
                true;
        }
    }

    private void CreateAndStartMatch()
    {
        if (isStartingMatch)
        {
            return;
        }

        if (!Session.HasPlayerName ||
            Session.TrainingPlayerDeck == null ||
            Session.TrainingBotDeck == null)
        {
            return;
        }

        isStartingMatch =
            true;

        try
        {
            Session.CurrentMatch =
            GameSetupManager.StartTrainingMatch(
            Session.PlayerName,
            Session.TrainingPlayerDeck,
            Session.TrainingBotDeck,
            selectedDifficulty);

            if (Session.CurrentMatch == null)
            {
                isStartingMatch =
                    false;

                return;
            }

            showConfirmation =
                false;

            showNameDialog =
                false;

            Navigation.NavigateTo(
                "/battle");
        }
        catch (Exception exception)
        {
            isStartingMatch =
                false;

            Console.Error.WriteLine(
                "START MATCH FAILED:");

            Console.Error.WriteLine(
                exception.ToString());
        }
    }

    private void GoBack()
    {
        if (isStartingMatch)
        {
            return;
        }

        Session.TrainingBotDeck =
            null;

        Navigation.NavigateTo(
            "/player-deck");
    }

    private static string GetStructureName(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.PriorityQueue =>
                "Priority Queue",

            DeckStructure.RandomList =>
                "Random List",

            DeckStructure.LinkedList =>
                "Linked List",

            _ =>
                structure.ToString()
        };
    }
    private BotDifficulty selectedDifficulty =
    BotDifficulty.Medium;
}