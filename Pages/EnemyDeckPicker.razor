@page "/enemy-deck"
@using RedPandaTCD_Web.Game
@using RedPandaTCD_Web.Component
@inject GameSessionState Session
@inject NavigationManager Navigation

<PageTitle>Choose Enemy Deck - Red Panda TCD</PageTitle>

<div class="deck-page">

    <DeckPicker
        Title="Choose Enemy Deck"
        Subtitle="@PlayerDeckText"
        OnDeckSelected="SelectEnemyDeck"
        OnBack="GoBack"
        BackText="Back to Your Deck" />

</div>

<ConfirmDialog
    IsVisible="showConfirmation"
    Title="Start Training Match?"
    Message="Confirm both decks before beginning."
    ConfirmText="@(isStartingMatch ? "Starting..." : "Start Match")"
    CancelText="Choose Another Deck"
    OnConfirm="StartMatch"
    OnCancel="CancelConfirmation">

    <DialogContent>

        @if (Session.TrainingPlayerDeck != null &&
             Session.TrainingBotDeck != null)
        {
            <div class="match-summary">
                <div class="bot-difficulty-picker">
    <label for="bot-difficulty">
        Training Bot Difficulty
    </label>

    <select id="bot-difficulty"
            @bind="selectedDifficulty">
        <option value="@BotDifficulty.Easy">Easy</option>
        <option value="@BotDifficulty.Medium">Medium</option>
        <option value="@BotDifficulty.Hard">Hard</option>
    </select>

    <small>
        Choose how challenging your training match will be.
    </small>
</div>
                <div class="summary-section">

                    <span class="summary-label">
                        YOUR DECK
                    </span>

                    <strong>
                        @Session.TrainingPlayerDeck.Name
                    </strong>

                    <small>
                        @GetStructureName(
                            Session.TrainingPlayerDeck.Structure)
                    </small>

                </div>

                <div class="summary-divider"></div>

                <div class="summary-section">

                    <span class="summary-label">
                        ENEMY DECK
                    </span>

                    <strong>
                        @Session.TrainingBotDeck.Name
                    </strong>

                    <small>
                        @GetStructureName(
                            Session.TrainingBotDeck.Structure)
                    </small>

                </div>

            </div>
        }

    </DialogContent>

</ConfirmDialog>

@if (showNameDialog)
{
    <div class="name-overlay"
         @onclick="CancelNameDialog">

        <div class="name-dialog"
             @onclick:stopPropagation="true">

            <h2>
                Enter Your Name
            </h2>

            <p>
                A player name is required before starting the match.
            </p>

            <form @onsubmit="SubmitNameAndStart"
                  @onsubmit:preventDefault>

                <input @bind="pendingPlayerName"
                       @bind:event="oninput"
                       placeholder="Player name"
                       maxlength="24"
                       autofocus />

                @if (!string.IsNullOrWhiteSpace(nameError))
                {
                    <p class="name-error">
                        @nameError
                    </p>
                }

                <button type="submit"
                        disabled="@isStartingMatch">

                    @(isStartingMatch
                        ? "Starting..."
                        : "Start Match")

                </button>

                <button type="button"
                        class="secondary-button"
                        disabled="@isStartingMatch"
                        @onclick="CancelNameDialog">

                    Cancel

                </button>

            </form>

        </div>

    </div>
}

<style>
    .deck-page {
        min-height: calc(100vh - 58px);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 20px;
        box-sizing: border-box;

        background:
            linear-gradient(
                160deg,
                #18212b 0%,
                #23364a 55%,
                #3a2428 100%
            );
    }

    /* CONFIRMATION SUMMARY */

    .match-summary {
        display: flex;
        flex-direction: column;

        gap: 12px;
    }

    .summary-section {
        display: flex;
        flex-direction: column;

        gap: 3px;
    }

    .summary-label {
        color: #9daab5;

        font-size: 8px;
        font-weight: bold;

        letter-spacing: 0.8px;
    }

    .summary-section strong {
        color: #f4efe3;

        font-size: 15px;
    }

    .summary-section small {
        color: #b8c0c7;

        font-size: 10px;
    }

    .summary-divider {
        height: 1px;

        background:
            rgba(255, 255, 255, 0.12);
    }

    /* PLAYER NAME DIALOG */

    .name-overlay {
        position: fixed;
        inset: 0;

        z-index: 10000;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 20px;

        background:
            rgba(7, 11, 15, 0.82);
    }

    .name-dialog {
        width: min(380px, 100%);

        box-sizing: border-box;

        padding: 26px;

        display: flex;
        flex-direction: column;

        gap: 12px;

        border: 2px solid #9b9383;
        border-radius: 11px;

        background: #18212b;
        color: #f5f5f5;

        text-align: center;

        box-shadow:
            0 18px 45px
            rgba(0, 0, 0, 0.45);
    }

    .name-dialog h2 {
        margin: 0;

        color: #f4efe3;

        font-size: 25px;
    }

    .name-dialog > p {
        margin: 0;

        color: #c8d0d8;

        font-size: 12px;
        line-height: 1.45;
    }

    .name-dialog form {
        display: flex;
        flex-direction: column;

        gap: 10px;

        margin-top: 6px;
    }

    .name-dialog input {
        width: 100%;
        box-sizing: border-box;

        padding: 12px 14px;

        border: 2px solid #9b9383;
        border-radius: 7px;

        background: #f4efe3;
        color: #222222;

        outline: none;

        text-align: center;
        font-size: 15px;
    }

    .name-dialog input:focus {
        border-color: #d4c6a5;
    }

    .name-dialog button {
        width: 100%;

        padding: 11px 14px;

        border: 1px solid #9b9383;
        border-radius: 7px;

        background: #f4efe3;
        color: #222222;

        cursor: pointer;

        font-weight: bold;
    }

    .name-dialog button:hover:not(:disabled) {
        background: #e5ddcc;
    }

    .name-dialog button:disabled {
        cursor: default;
        opacity: 0.55;
    }

    .name-dialog .secondary-button {
        background: #29333e;
        color: #e7ebef;
    }

    .name-dialog .secondary-button:hover:not(:disabled) {
        background: #36424e;
    }

    .name-error {
        margin: 0;

        color: #ffb3b3;

        font-size: 12px;
        font-weight: bold;
    }
</style>

@code {
    private bool showConfirmation;
    private bool showNameDialog;
    private bool isStartingMatch;

    private string pendingPlayerName = "";
    private string nameError = "";

    private string PlayerDeckText =>
        Session.TrainingPlayerDeck == null
            ? ""
            : $"Your Deck: {Session.TrainingPlayerDeck.Name} ({GetStructureName(Session.TrainingPlayerDeck.Structure)})";

    protected override void OnInitialized()
    {
        if (Session.TrainingPlayerDeck == null)
        {
            Navigation.NavigateTo(
                "/player-deck");
        }
    }

    private void SelectEnemyDeck(
        Deck deck)
    {
        if (isStartingMatch)
        {
            return;
        }

        Session.TrainingBotDeck =
            deck;

        showConfirmation =
            true;
    }

    private void CancelConfirmation()
    {
        if (isStartingMatch)
        {
            return;
        }

        showConfirmation =
            false;
    }

    private void StartMatch()
    {
        if (isStartingMatch)
        {
            return;
        }

        if (Session.TrainingPlayerDeck == null)
        {
            showConfirmation =
                false;

            Navigation.NavigateTo(
                "/player-deck");

            return;
        }

        if (Session.TrainingBotDeck == null)
        {
            showConfirmation =
                false;

            return;
        }

        if (!Session.HasPlayerName)
        {
            pendingPlayerName =
                "";

            nameError =
                "";

            showConfirmation =
                false;

            showNameDialog =
                true;

            return;
        }

        CreateAndStartMatch();
    }

    private void SubmitNameAndStart()
    {
        if (isStartingMatch)
        {
            return;
        }

        string name =
            pendingPlayerName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            nameError =
                "Please enter a player name.";

            return;
        }

        Session.PlayerName =
            name;

        showNameDialog =
            false;

        nameError =
            "";

        CreateAndStartMatch();
    }

    private void CancelNameDialog()
    {
        if (isStartingMatch)
        {
            return;
        }

        showNameDialog =
            false;

        pendingPlayerName =
            "";

        nameError =
            "";

        // Return to the deck confirmation instead of
        // making the player choose the enemy deck again.
        if (Session.TrainingPlayerDeck != null &&
            Session.TrainingBotDeck != null)
        {
            showConfirmation =
                true;
        }
    }

    private void CreateAndStartMatch()
    {
        if (isStartingMatch)
        {
            return;
        }

        if (!Session.HasPlayerName ||
            Session.TrainingPlayerDeck == null ||
            Session.TrainingBotDeck == null)
        {
            return;
        }

        isStartingMatch =
            true;

        try
        {
            Session.CurrentMatch =
            GameSetupManager.StartTrainingMatch(
            Session.PlayerName,
            Session.TrainingPlayerDeck,
            Session.TrainingBotDeck,
            selectedDifficulty);

            if (Session.CurrentMatch == null)
            {
                isStartingMatch =
                    false;

                return;
            }

            showConfirmation =
                false;

            showNameDialog =
                false;

            Navigation.NavigateTo(
                "/battle");
        }
        catch (Exception exception)
        {
            isStartingMatch =
                false;

            Console.Error.WriteLine(
                "START MATCH FAILED:");

            Console.Error.WriteLine(
                exception.ToString());
        }
    }

    private void GoBack()
    {
        if (isStartingMatch)
        {
            return;
        }

        Session.TrainingBotDeck =
            null;

        Navigation.NavigateTo(
            "/player-deck");
    }

    private static string GetStructureName(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.PriorityQueue =>
                "Priority Queue",

            DeckStructure.RandomList =>
                "Random List",

            DeckStructure.LinkedList =>
                "Linked List",

            _ =>
                structure.ToString()
        };
    }
    private BotDifficulty selectedDifficulty =
    BotDifficulty.Medium;
}