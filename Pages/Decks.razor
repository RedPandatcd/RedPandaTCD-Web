    gap: 7px;
}


.delete-actions button {
    padding: 10px;

    border:
        1px solid #8a8376;

    border-radius: 5px;

    background: #e5dfd1;
    color: #222222;

    cursor: pointer;

    font-weight: bold;
}


.delete-actions .confirm-delete {
    background: #a84147;
    color: white;

    border-color: #c75d63;
}


/* =========================
   RESPONSIVE
   ========================= */

@@media (max-width: 700px) {

    .decks-page {
        padding:
            24px
            13px
            40px;
    }


    .decks-header {
        align-items: stretch;

        flex-direction: column;
    }


    .header-actions {
        width: 100%;
    }


    .header-actions button {
        flex: 1;
    }


    .deck-stats {
        grid-template-columns: 1fr;
    }


    .deck-grid {
        grid-template-columns: 1fr;
    }


    .deck-overlay {
        padding: 10px;
    }


    .viewer-summary {
        grid-template-columns: 1fr;
    }


    .viewer-card {
        grid-template-columns:
            28px
            4px
            minmax(0, 1fr);
    }


    .viewer-priority {
        grid-column:
            1 / -1;

        min-height: 30px;

        flex-direction: row;

        gap: 6px;

        border-left: 0;

        border-top:
            1px solid #56616c;
    }


    .viewer-footer {
        flex-direction: column;
    }


    .viewer-footer button {
        width: 100%;
    }

}

</style>


@code {

    private const int StarterDeckCount =
        5;

    private int? viewedDeckIndex;

    private int? deleteDeckIndex;


    protected override void OnInitialized()
    {
        DeckManager.InitializeDefaultDecks();
    }


    private int CustomDeckCount =>
        Math.Max(
            0,
            DeckManager.Decks.Count -
            StarterDeckCount);


    private static int CountCards(
        Deck deck,
        CardType type)
    {
        return deck.Cards.Count(card =>
            card.Type == type);
    }


    private static string GetStructureName(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.Queue =>
                "Queue",

            DeckStructure.Stack =>
                "Stack",

            DeckStructure.PriorityQueue =>
                "Priority Queue",

            DeckStructure.RandomList =>
                "Random List",

            DeckStructure.LinkedList =>
                "Linked List",

            _ =>
                structure.ToString()
        };
    }


    private static string GetStructureDescription(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.Queue =>
                "First In, First Out. Deck order determines draw order.",

            DeckStructure.Stack =>
                "Last In, First Out. Deck order matters and Placement is automatic.",

            DeckStructure.PriorityQueue =>
                "Higher-priority cards are selected first. Characters occupy Priority 5.",

            DeckStructure.RandomList =>
                "Cards are drawn from a randomized list.",

            DeckStructure.LinkedList =>
                "Cards use linked nodes that can be reordered through deck actions.",

            _ =>
                ""
        };
    }


    private static string GetStructureClass(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.Queue =>
                "structure-queue",

            DeckStructure.Stack =>
                "structure-stack",

            DeckStructure.PriorityQueue =>
                "structure-priority",

            DeckStructure.RandomList =>
                "structure-random",

            DeckStructure.LinkedList =>
                "structure-linked",

            _ =>
                ""
        };
    }


    private static string GetCardTypeClass(
        Card card)
    {
        return card.Type switch
        {
            CardType.Character =>
                "card-character",

            CardType.Attack =>
                "card-attack",

            CardType.Utility =>
                "card-utility",

            _ =>
                ""
        };
    }


    private bool IsStarterDeck(
        int index)
    {
        return index >= 0 &&
               index < StarterDeckCount;
    }


    private void ViewDeck(
        int index)
    {
        if (index < 0 ||
            index >= DeckManager.Decks.Count)
        {
            return;
        }

        deleteDeckIndex = null;

        viewedDeckIndex =
            index;
    }


    private void CloseDeckViewer()
    {
        viewedDeckIndex =
            null;
    }


    private void AskDeleteDeck(
        int index)
    {
        if (IsStarterDeck(index))
        {
            return;
        }

        if (index < 0 ||
            index >= DeckManager.Decks.Count)
        {
            return;
        }

        viewedDeckIndex = null;

        deleteDeckIndex =
            index;
    }


    private void CancelDelete()
    {
        deleteDeckIndex =
            null;
    }


    private void ConfirmDelete()
    {
        if (deleteDeckIndex == null)
        {
            return;
        }

        int index =
            deleteDeckIndex.Value;

        if (IsStarterDeck(index))
        {
            deleteDeckIndex = null;
            return;
        }

        DeckManager.DeleteDeck(
            index);

        deleteDeckIndex =
            null;

        viewedDeckIndex =
            null;
    }


    private void GoToDeckBuilder()
    {
        Navigation.NavigateTo(
            "/deck-builder");
    }


    private void GoHome()
    {
        Navigation.NavigateTo(
            "/");
    }
private void EditDeck(int index)
{
    Navigation.NavigateTo(
        $"/deck-builder?edit={index}");
}
