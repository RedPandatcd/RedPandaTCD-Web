    padding:
        5px
        8px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    border-left:
        1px solid #56616c;
}


.viewer-priority span {
    color: #817e73;

    font-size: 6px;
    font-weight: bold;
}


.viewer-priority strong {
    color: #e5cc67;

    font-size: 16px;
}


.viewer-footer {
