/* =========================
   DELETE
   ========================= */

.delete-dialog {
    width: min(360px, 100%);

    padding: 22px;

    box-sizing: border-box;

    display: flex;
    flex-direction: column;

    gap: 13px;

    border:
        2px solid #79585b;

    border-radius: 10px;

    background: #18212b;
    color: #f5f5f5;

    text-align: center;
}


.delete-dialog h2,
.delete-dialog p {
    margin: 0;
}


.delete-warning {
    color: #d79696;

    font-size: 10px;
}


.delete-actions {
    display: grid;

    grid-template-columns:
        1fr
