.viewer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 15px;
}


.viewer-label {
    color: #e5cc67;

    font-size: 8px;
    font-weight: bold;

    letter-spacing: 0.8px;

    text-transform: uppercase;
}


.viewer-header h2 {
