        12px;

    border:
        1px solid #8a8376;

    border-radius: 5px;

    cursor: pointer;

    font-size: 10px;
    font-weight: bold;
}


.view-button {
    flex: 1;

    background: #f4efe3;
    color: #222222;
}


.view-button:hover {
    background: #e5ddcc;
}

.edit-button {
    background: #d7c984;
