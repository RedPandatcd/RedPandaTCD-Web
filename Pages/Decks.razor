@page "/decks"
@using RedPandaTCD_Web.Game
@inject NavigationManager Navigation

<PageTitle>My Decks - Red Panda TCD</PageTitle>

<div class="decks-page">

    <main class="decks-shell">

        <header class="decks-header">

            <div>
                <h1>
                    My Decks
                </h1>

                <p>
                    View and manage your available decks.
                </p>
            </div>

            <div class="header-actions">

                <button @onclick="GoToDeckBuilder">
                    Deck Builder
                </button>

                <button @onclick="GoHome">
                    Main Menu
                </button>

            </div>

        </header>


        <section class="deck-stats">

            <div>
                <span>
                    TOTAL DECKS
                </span>

                <strong>
                    @DeckManager.Decks.Count
                </strong>
            </div>

            <div>
                <span>
                    STARTER DECKS
                </span>

                <strong>
                    @Math.Min(
                        StarterDeckCount,
                        DeckManager.Decks.Count)
                </strong>
            </div>

            <div>
                <span>
                    CUSTOM DECKS
                </span>

                <strong>
                    @CustomDeckCount
                </strong>
            </div>

        </section>


        @if (DeckManager.Decks.Count == 0)
        {
            <section class="empty-state">

                <h2>
                    No Decks Available
                </h2>

                <p>
                    Build a deck to get started.
                </p>

                <button @onclick="GoToDeckBuilder">
                    Open Deck Builder
                </button>

            </section>
        }
        else
        {
            <section class="deck-grid">

                @for (int i = 0;
                      i < DeckManager.Decks.Count;
                      i++)
                {
                    int deckIndex = i;

                    Deck deck =
                        DeckManager.Decks[deckIndex];

                    bool isStarter =
                        IsStarterDeck(deckIndex);

                    <article class="deck-card">

                        <div class="deck-card-accent @GetStructureClass(deck.Structure)">
                        </div>

                        <div class="deck-card-heading">

                            <div class="deck-title">

                                <div class="deck-title-row">

                                    <h2>
                                        @deck.Name
                                    </h2>

                                    @if (isStarter)
                                    {
                                        <span class="starter-badge">
                                            STARTER
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="custom-badge">
                                            CUSTOM
                                        </span>
                                    }

                                </div>

                                <span class="structure-name">
                                    @GetStructureName(deck.Structure)
                                </span>

                            </div>

                            <div class="card-count">

                                <strong>
                                    @deck.Cards.Count
                                </strong>

                                <span>
                                    CARDS
                                </span>

                            </div>

                        </div>


                        <div class="deck-counts">

                            <div>

                                <span>
                                    CHARACTERS
                                </span>

                                <strong>
                                    @CountCards(
                                        deck,
                                        CardType.Character)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    ATTACKS
                                </span>

                                <strong>
                                    @CountCards(
                                        deck,
                                        CardType.Attack)
                                </strong>

                            </div>

                            <div>

                                <span>
                                    UTILITIES
                                </span>

                                <strong>
                                    @CountCards(
                                        deck,
                                        CardType.Utility)
                                </strong>

                            </div>

                        </div>


                        <p class="structure-description">
                            @GetStructureDescription(deck.Structure)
                        </p>


                        <div class="deck-actions">

    <button class="view-button"
            @onclick="() => ViewDeck(deckIndex)">
        View Deck
    </button>

    @if (!isStarter)
    {
        <button class="edit-button"
                @onclick="() => EditDeck(deckIndex)">
            Edit
        </button>

        <button class="delete-button"
                @onclick="() => AskDeleteDeck(deckIndex)">
            Delete
        </button>
    }

</div>

                    </article>
                }

            </section>
        }

    </main>

</div>


@if (deleteDeckIndex != null &&
     deleteDeckIndex.Value >= 0 &&
     deleteDeckIndex.Value < DeckManager.Decks.Count)
{
    Deck deckToDelete =
        DeckManager.Decks[deleteDeckIndex.Value];

    <div class="deck-overlay"
         @onclick="CancelDelete">

        <section class="delete-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="delete-deck-title"
                 @onclick:stopPropagation="true">

            <h2 id="delete-deck-title">Delete this deck?</h2>

            <p>
                Are you sure you want to delete <strong>@deckToDelete.Name</strong>?
            </p>

            <p class="delete-warning">
                This action cannot be undone.
            </p>

            <div class="delete-actions">
                <button type="button"
                        @onclick="CancelDelete">
                    Cancel
                </button>

                <button type="button"
                        class="confirm-delete"
                        @onclick="ConfirmDelete">
                    Delete Deck
                </button>
            </div>

        </section>

    </div>
}


@if (viewedDeckIndex != null)
{
    int index =
        viewedDeckIndex.Value;

    if (index >= 0 &&
        index < DeckManager.Decks.Count)
    {
        Deck viewedDeck =
            DeckManager.Decks[index];

        <div class="deck-overlay"
             @onclick="CloseDeckViewer">

            <section class="deck-viewer"
                     @onclick:stopPropagation="true">

                <header class="viewer-header">

                    <div>

                        <span class="viewer-label">
                            @GetStructureName(viewedDeck.Structure)
                        </span>

                        <h2>
                            @viewedDeck.Name
                        </h2>

                        <p>
                            @viewedDeck.Cards.Count cards
                        </p>

                    </div>

                    <button class="close-button"
                            @onclick="CloseDeckViewer">
                        ×
                    </button>

                </header>

                <div class="viewer-structure-info">

                    <strong>
                        @GetStructureName(viewedDeck.Structure)
                    </strong>

                    <span>
                        @GetStructureDescription(viewedDeck.Structure)
                    </span>

                </div>

                <div class="viewer-summary">

                    <span>
                        Characters
                        <strong>
                            @CountCards(
                                viewedDeck,
                                CardType.Character)
                        </strong>
                    </span>

                    <span>
                        Attacks
                        <strong>
                            @CountCards(
                                viewedDeck,
                                CardType.Attack)
                        </strong>
                    </span>

                    <span>
                        Utilities
                        <strong>
                            @CountCards(
                                viewedDeck,
                                CardType.Utility)
                        </strong>
                    </span>

                </div>

                <div class="viewer-list">

                    @for (int i = 0;
                          i < viewedDeck.Cards.Count;
                          i++)
                    {
                        int cardIndex = i;

                        Card card =
                            viewedDeck.Cards[cardIndex];

                        <CardBrowseRow
                            @key="@($"viewer-{cardIndex}-{card.Id}")"
                            Card="@card"
                            Position="@(cardIndex + 1)"
                            Priority="@(viewedDeck.Structure == DeckStructure.PriorityQueue
                                ? card.Priority
                                : null)"
                            ShowCardPreview="true" />
                    }

                </div>

                <footer class="viewer-footer">

                    <button @onclick="CloseDeckViewer">
                        Close
                    </button>

                    <button class="builder-button"
                            @onclick="GoToDeckBuilder">
                        Deck Builder
                    </button>

                </footer>

            </section>

        </div>
    }
}
<style>

.decks-page {
