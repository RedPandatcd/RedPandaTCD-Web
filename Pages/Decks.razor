    align-items: center;
    justify-content: center;

    color: #e5cc67;

    font-size: 10px;
    font-weight: bold;
}


.viewer-card-accent {
    width: 4px;
}


.card-character {
    background: #cf5959;
}


.card-attack {
    background: #d49a3a;
}


.card-utility {
