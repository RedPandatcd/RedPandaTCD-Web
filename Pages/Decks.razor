    padding:
        34px
        24px
        60px;

    box-sizing: border-box;

    background:
        linear-gradient(
            160deg,
            #18212b 0%,
            #23364a 55%,
            #3a2428 100%
        );

    color: #f5f5f5;
}


.decks-shell {
    width: min(1180px, 100%);

    margin: 0 auto;
}


.decks-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;
}


.decks-header h1 {
    margin: 0;

    color: #f4efe3;

    font-size:
        clamp(
            32px,
            4vw,
            48px
        );
}


.decks-header p {
    margin:
        6px
        0
        0;

    color: #c8d0d8;

    font-size: 13px;
}


.header-actions {
    display: flex;

    gap: 8px;
}


.header-actions button,
.empty-state button {
    padding:
        10px
        15px;

    border:
        1px solid #9b9383;

    border-radius: 6px;

    background: #f4efe3;
    color: #222222;

    cursor: pointer;

    font-weight: bold;
}


.header-actions button:hover,
.empty-state button:hover {
    background: #e5ddcc;
}


