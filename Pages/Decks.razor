}


/* =========================
   OVERLAY
   ========================= */

.deck-overlay {
    position: fixed;
    inset: 0;

    z-index: 10000;

    padding: 24px;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        rgba(
            6,
            10,
            14,
            0.90
