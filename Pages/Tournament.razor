protected override void OnInitialized()
{
    DeckManager.InitializeDefaultDecks();

    showPageTutorial =
        PageTutorialRequested;

    pageTutorialStep =
        0;

    /*
        Keep the tutorial on the Tournament overview.

        If a deck picker was left open in component state,
        close it so the overview targets are visible.
    */
    if (showPageTutorial)
    {
        showDeckPicker =
            false;

        showAbandonDialog =
            false;
    }
}
private string GetPageTutorialClass(
    string target)
{
    if (!showPageTutorial ||
        pageTutorialStep < 0 ||
        pageTutorialStep >=
            TournamentPageTutorialSteps.Count)
    {
        return "";
    }

    PageTutorialStep step =
        TournamentPageTutorialSteps[
            pageTutorialStep];

    return string.Equals(
        step.Target,
        target,
        StringComparison.OrdinalIgnoreCase)
            ? "page-tutorial-target"
            : "";
}

private Task SetPageTutorialStep(
    int step)
{
    pageTutorialStep =
        step;

    return Task.CompletedTask;
}

private void ExitPageTutorial()
{
    showPageTutorial =
        false;

    Navigation.NavigateTo(
        "/tutorial");
}
private void BeginTournament()
{
    if (showPageTutorial)
    {
        return;
    }

    errorMessage =
        "";

    showDeckPicker =
        true;
}

    private void CancelDeckSelection()
    {
        showDeckPicker = false;
    }


    private void SelectTournamentDeck(
        Deck deck)
    {
        TournamentManager.StartTournament(
            Session.Tournament,
            deck);

        showDeckPicker = false;

        errorMessage = "";
    }


    private void StartCurrentRound()
{
    if (isStartingMatch)
    {
        return;
    }

    if (!Session.Tournament.IsActive ||
        Session.Tournament.LockedPlayerDeck == null)
    {
        errorMessage =
            "No active Tournament run is ready.";
        return;
    }

    if (!Session.HasPlayerName)
    {
        errorMessage =
            "A player name is required before starting the Tournament.";
        return;
    }

    isStartingMatch = true;
    errorMessage = "";

    try
    {
        // Tournament opponents always use Medium difficulty.
        BotManager.IsTutorialMode = false;
        BotManager.Difficulty = BotDifficulty.Medium;

        Session.CurrentMatch =
            GameSetupManager.StartTournamentMatch(
                Session.PlayerName,
                Session.Tournament);

        Navigation.NavigateTo("/battle");
    }
    catch (Exception exception)
    {
        Session.CurrentMatch = null;
        errorMessage = exception.Message;

        Console.Error.WriteLine(
            "TOURNAMENT MATCH FAILED:");

        Console.Error.WriteLine(exception.ToString());
    }
    finally
    {
        isStartingMatch = false;
    }
}


    private void AskAbandonTournament()
    {
        showAbandonDialog = true;
    }


    private void CancelAbandonTournament()
    {
        showAbandonDialog = false;
    }


    private void ConfirmAbandonTournament()
    {
        showAbandonDialog = false;

        Session.CurrentMatch = null;

        TournamentManager.ResetTournament(
            Session.Tournament);

        errorMessage = "";
    }


    private void StartNewTournament()
    {
        Session.CurrentMatch = null;

        TournamentManager.ResetTournament(
            Session.Tournament);

        errorMessage = "";

        showDeckPicker = true;
    }


    private string GetRoundClass(
        int round)
    {
        if (round <=
            Session.Tournament.CompletedRounds)
        {
            return "completed";
        }

        if (round ==
            Session.Tournament.CurrentRound &&
            Session.Tournament.IsActive)
        {
            return "current";
        }

        return "";
    }


    private string GetLineClass(
        int round)
    {
        return round <=
               Session.Tournament.CompletedRounds
            ? "completed"
            : "";
    }


    private string GetRoundProgressText(
        int round)
    {
        if (round <=
            Session.Tournament.CompletedRounds)
        {
            return "Complete";
        }

        if (round ==
            Session.Tournament.CurrentRound &&
            Session.Tournament.IsActive)
        {
            return "Current";
        }

        return "Locked";
    }


    private string GetCurrentOpponentDeckName()
    {
        Deck? deck =
            TournamentManager.GetOpponentDeck(
                Session.Tournament.CurrentRound);

        return deck?.Name ??
               "Unknown Deck";
    }


    private string GetCurrentOpponentStructureName()
    {
        Deck? deck =
            TournamentManager.GetOpponentDeck(
                Session.Tournament.CurrentRound);

        if (deck == null)
        {
            return "";
        }

        return GetStructureName(
            deck.Structure);
    }


    private static string GetStructureName(
        DeckStructure structure)
    {
        return structure switch
        {
            DeckStructure.PriorityQueue =>
                "Priority Queue",

            DeckStructure.RandomList =>
                "Random List",

            DeckStructure.LinkedList =>
                "Linked List",

            _ =>
                structure.ToString()
        };
    }


