    string? recordedP2Fingerprint =
        GetReplayDeckFingerprint(
            replayData,
            2);

    string actualP1Fingerprint =
        BattleLog.CreateDeckFingerprint(
            player1Deck);

    string actualP2Fingerprint =
        BattleLog.CreateDeckFingerprint(
