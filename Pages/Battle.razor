        bool hasCharacter =
            player.HandSlots.Any(
                slot =>
                    !slot.IsEmpty &&
                    slot.CardInSlot?.Type ==
                        CardType.Character);

        if (!hasCharacter)
            return;

        showCharacterPicker = true;

        if (IsLearnToPlayBattle &&
            player.ActiveCharacter != null &&
            RequiredTutorialAction ==
                TutorialAction.BeginCharacterReplacement)
        {
            NotifyTutorialAction(
                TutorialAction.BeginCharacterReplacement);
        }

        StateHasChanged();
    }

