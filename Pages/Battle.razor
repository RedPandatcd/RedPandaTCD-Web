    private static void DiscardRemainingTutorialSampleCards(Player player)
    {
        if (player.Deck.RuntimeStorage == null)
            return;

        while (player.Deck.RuntimeStorage.Count > 0)
        {
            Card? card = player.Deck.RuntimeStorage.Draw();
            if (card == null)
                continue;

            // Keep the Priority Queue tutorial sample Character at its real
            // priority before recycling. Initialization temporarily lowered
            // its stored queue key so it could not replace an opening Attack.
            if (player.Deck.Structure == DeckStructure.PriorityQueue &&
                card.Type == CardType.Character)
            {
                card.Priority = 5;
            }

            player.DiscardPile.Add(card);
        }

        BattleLog.WriteSystem(
            $"{player.Name}'s tutorial sample cards were moved to the discard pile.");
    }

