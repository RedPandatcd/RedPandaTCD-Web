    {
        allowNavigation = true;
        Navigation.NavigateTo("/simulator");
        return;
    }

    if (P1DeckIndex < 0 ||
        P1DeckIndex >= DeckManager.Decks.Count ||
        P2DeckIndex < 0 ||
