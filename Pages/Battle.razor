    private async Task AcknowledgePassDevice()
    {
        showPassDeviceDialog = false;

        CloseGameplayPopups();
        StateHasChanged();

        await RunAutomaticHumanPlacementIfNeeded();
    }

    private async Task RunAutomaticHumanPlacementIfNeeded()
    {
        if (Session.CurrentMatch == null)
            return;

        MatchState match =
            Session.CurrentMatch;

        if (match.CurrentPhase !=
            MatchPhase.Placement)
        {
            return;
        }

        Player player =
            GetPresentedPlayer();

        if (player.IsBot ||
            player.Deck.Structure != DeckStructure.Stack)
        {
            return;
        }

        StateHasChanged();

        await Task.Delay(
            Random.Shared.Next(500, 1501));

        if (Session.CurrentMatch == null ||
            match.IsCompleted ||
            match.CurrentPhase != MatchPhase.Placement ||
            match.GetActingPlayer() != player)
        {
            return;
        }

        PlacementManager.AutoStackPlacement(
            player);

        if (IsDsaTutorialBattle &&
            Session.Tutorial.CurrentTutorial ==
                TutorialType.Stack)
        {
            NotifyTutorialAction(
                TutorialAction.ObserveAutomaticPlacement);
        }

        CheckForZeroEnergy();
        StateHasChanged();
    }

    // 6. UTILITY PHASE

    private bool CanSelectHandCard(
        Player player,
        HandSlot slot)
    {
        MatchState? match =
            Session.CurrentMatch;

        if (match == null ||
            IsBattleFinished ||
            botIsActing ||
            match.GetActingPlayer() != player ||
            match.CurrentPhase != MatchPhase.Utility ||
            player.UtilityActionsRemaining <= 0 ||
            slot.IsEmpty ||
            slot.CardInSlot == null)
        {
            return false;
        }

        if (!IsGuidedTutorialBattle)
            return true;

        return RequiredTutorialAction switch
        {
            TutorialAction.SelectUtility =>
                !IsLearnToPlayBattle ||
                string.Equals(
                    slot.CardInSlot.Id,
                    "UM1",
                    StringComparison.OrdinalIgnoreCase),

            TutorialAction.DiscardAndDraw =>
                !IsLearnToPlayBattle ||
                string.Equals(
                    slot.CardInSlot.Id,
                    "AP7",
                    StringComparison.OrdinalIgnoreCase),

            _ =>
                false
        };
    }

