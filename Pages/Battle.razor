    private string GetAttackPlacementHighlight(
        Player player,
        int slot)
    {
        MatchState? match =
            Session.CurrentMatch;

        if (match == null ||
            IsBattleFinished ||
            botIsActing ||
            match.GetActingPlayer() != player)
        {
            return "";
        }

        Card? attack =
            slot == 1
                ? player.AttackSlot1
                : player.AttackSlot2;

        if (awaitingWandererEntry)
        {
            return attack != null
                ? "placement-replace"
                : "";
        }

        if (match.CurrentPhase !=
            MatchPhase.Placement)
        {
            return "";
        }

        if (IsDsaTutorialBattle)
        {
            return
                attack == null &&
                HasAffordableAttackInHand(player)
                    ? "placement-deploy"
                    : "";
        }

        if (IsGuidedTutorialBattle)
        {
            if (RequiredTutorialAction ==
                    TutorialAction.RestAttack &&
                attack != null &&
                TutorialAllowsCard(attack))
            {
                return "placement-fatigued";
            }

            if (RequiredTutorialAction ==
                    TutorialAction.ReplaceAttack &&
                attack != null &&
                string.Equals(
                    attack.Id,
                    "AP4",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "placement-replace";
            }

            if (RequiredTutorialAction ==
                TutorialAction.DeployAttack)
            {
                return
                    attack == null &&
                    HasAffordableAttackInHand(player)
                        ? "placement-deploy"
                        : "";
            }

            return "";
        }

        bool fatigued =
            slot == 1
                ? player.IsFatiguedSlot1
                : player.IsFatiguedSlot2;

        if (attack != null &&
            fatigued)
        {
            return "placement-fatigued";
        }

        if (!HasAffordableAttackInHand(
                player))
        {
            return "";
        }

        return attack == null
            ? "placement-deploy"
            : "placement-replace";
    }

    private bool HasAffordableAttackInHand(
        Player player)
    {
        foreach (HandSlot slot in player.HandSlots)
        {
            Card? card =
                slot.CardInSlot;

            if (card?.Type != CardType.Attack)
                continue;

            if (IsLearnToPlayBattle &&
                !TutorialAllowsCard(card))
            {
                continue;
            }

            int cost =
                card.Cost;

            if (player.DiscountActive)
                cost = Math.Max(0, cost - 1);

            if (player.Energy >= cost)
                return true;
        }

        return false;
    }

    private bool ShouldHighlightCharacterAbility(
        Player player)
    {
        if (Session.CurrentMatch?.CurrentPhase !=
            MatchPhase.Attack)
        {
            return false;
        }

        return CanInteractWithCharacter(
            player);
    }

    private string GetCharacterPlacementHighlight(
        Player player)
    {
        MatchState? match =
            Session.CurrentMatch;

        if (match == null ||
            IsBattleFinished ||
            botIsActing ||
            match.CurrentPhase !=
                MatchPhase.Placement ||
            match.GetActingPlayer() != player)
        {
            return "";
        }

        if (IsGuidedTutorialBattle &&
            RequiredTutorialAction is not
                (TutorialAction.DeployCharacter or
                 TutorialAction.BeginCharacterReplacement or
                 TutorialAction.ReplaceCharacter))
        {
            return "";
        }

        if (!HasAffordableCharacterInHand(
                player))
        {
            return "";
        }

        return player.ActiveCharacter == null
            ? "placement-deploy"
            : "placement-replace";
    }

    private bool HasAffordableCharacterInHand(
        Player player)
    {
        foreach (HandSlot slot in player.HandSlots)
        {
            Card? card =
                slot.CardInSlot;

            if (card?.Type != CardType.Character)
                continue;

            if (IsLearnToPlayBattle &&
                !TutorialAllowsCard(card))
            {
                continue;
            }

            int cost =
                player.CharacterDefeatedSinceLastPlacement
                    ? 0
                    : player.ActiveCharacter != null
                        ? 4
                        : card.Cost;

            if (player.Energy >= cost)
                return true;
        }

        return false;
    }

