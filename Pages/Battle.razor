    private bool CanResolveFatigueWithReplace =>
        !IsGuidedTutorialBattle ||
        RequiredTutorialAction == TutorialAction.ReplaceAttack;

    private void RefreshTutorialState() =>
        StateHasChanged();

    private bool TutorialAllows(
        TutorialAction action) =>
        !IsGuidedTutorialBattle ||
        TutorialManager.CanPerformAction(
            Session.Tutorial,
            action);

    private bool NotifyTutorialAction(
        TutorialAction action)
    {
        if (!IsGuidedTutorialBattle)
            return false;

        bool advanced =
            TutorialManager.NotifyAction(
                Session.Tutorial,
                action);

        if (advanced)
            StateHasChanged();

        return advanced;
    }

    private async Task HandleTutorialOverlayAdvanced()
    {
        if (!IsGuidedTutorialBattle)
        {
            StateHasChanged();
            return;
        }

        if (IsDsaTutorialBattle)
            await HandleDsaInformationalAdvance();

        StateHasChanged();
        await Task.Yield();
        await RunBotIfNeeded();
        StateHasChanged();
    }

   private async Task FinishCurrentTutorial()
{
    if (!IsGuidedTutorialBattle)
        return;

    DeckManager.DeleteTutorialDeck();

    // Save the updated deck list to browser storage.
    await JS.InvokeVoidAsync(
        "deckStorage.save",
        DeckManager.ExportCustomDecks());

    Session.Tutorial.TutorialDeck = null;

    TutorialManager.CompleteTutorial(
        Session.Tutorial);

    // Record completion first, then clear active state so a later
    // Training Bot match cannot inherit the completed tutorial overlay.
    TutorialManager.ExitTutorial(
        Session.Tutorial);

    Session.CurrentMatch = null;
    allowNavigation = true;

    Navigation.NavigateTo("/tutorial");
}

    private string RequiredTutorialCardId =>
        TutorialTarget switch
        {
            "tutorial-utility" => "UM1",
            "sorcerer" => "CM1",
            "fireball" => "AM6",
            "piercing-attack" => "AP4",
            "piercing-slot" => "AP4",
            "multi-hit-attack" => "AM3",
            "wanderer" => "CN1",
            _ => ""
        };

    private bool TutorialAllowsCard(Card card)
    {
        if (!IsLearnToPlayBattle)
            return true;

        string required =
            RequiredTutorialCardId;

        return string.IsNullOrWhiteSpace(required) ||
               string.Equals(
                   card.Id,
                   required,
                   StringComparison.OrdinalIgnoreCase);
    }

    private bool CanPerformDeckTutorialAction(
        TutorialAction action) =>
        !IsGuidedTutorialBattle ||
        RequiredTutorialAction == action;

    private bool CanChoosePlacementAttack(
        HandSlot slot)
    {
        if (slot.IsEmpty ||
            slot.CardInSlot?.Type != CardType.Attack)
        {
            return false;
        }

        if (IsDsaTutorialBattle)
            return true;

        if (!IsLearnToPlayBattle)
            return true;

        Card card =
            slot.CardInSlot;

        if (RequiredTutorialAction ==
            TutorialAction.DeployAttack)
        {
            return TutorialAllowsCard(card);
        }

        if (RequiredTutorialAction ==
            TutorialAction.ReplaceAttack)
        {
            return string.Equals(
                card.Id,
                "AM3",
                StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private bool CanChoosePlacementCharacter(
        Card card)
    {
        if (!IsLearnToPlayBattle)
            return true;

        Player player = GetPresentedPlayer();

        // Do not let a replacement satisfy (or bypass) the tutorial's
        // initial-deployment step. The required action must match the
        // actual operation this placement would perform.
        TutorialAction expectedAction =
            player.ActiveCharacter == null
                ? TutorialAction.DeployCharacter
                : TutorialAction.ReplaceCharacter;

        return RequiredTutorialAction == expectedAction &&
               TutorialAllowsCard(card);
    }

    // 4. MAIN TURN / PHASE FLOW

    private bool CanContinuePhase(
        Player player)
    {
        MatchState? match =
            Session.CurrentMatch;

        if (match == null ||
            IsBattleFinished ||
            botIsActing ||
            showPassDeviceDialog ||
            awaitingWandererEntry ||
            !coinFlipAcknowledged ||
            match.GetActingPlayer() != player)
        {
            return false;
        }

        if (IsGuidedTutorialBattle &&
            RequiredTutorialAction !=
                TutorialAction.ContinuePhase)
        {
            return false;
        }


        if (IsDsaTutorialBattle &&
            match.CurrentPhase == MatchPhase.Placement &&
            !HasDeployedAttack(player))
        {
            return false;
        }

        if (match.CurrentPhase == MatchPhase.Placement &&
            HasUnresolvedFatigue(player))
        {
            return false;
        }

        return true;
    }

    private bool IsContinueDisabled(
        Player player) =>
        !CanContinuePhase(player);

    private async Task ContinuePhase()
    {
        if (Session.CurrentMatch == null)
            return;

        MatchState match =
            Session.CurrentMatch;

        Player player =
            GetPresentedPlayer();

        
        if (!CanContinuePhase(player))
            return;

        MatchPhase previousPhase =
            match.CurrentPhase;

        int previousTurn =
            match.TurnNumber;

        TutorialAction actionBeforePhaseChange =
            RequiredTutorialAction;

        CloseGameplayPopups();

        if (!await CompleteCurrentPlayerPhaseWithEndAnimation(match))
        {
            // Another event already owns this End Phase transition.
            // Do not continue this duplicate phase-flow invocation.
            return;
        }

        Console.WriteLine(
    $"BOT TRANSITION: Turn={match.TurnNumber}, " +
    $"Phase={match.CurrentPhase}, " +
    $"ActingIndex={match.ActingPlayerIndex}, " +
    $"ActingPlayer={match.GetActingPlayer().Name}, " +
    $"BotIsActing={botIsActing}");
        if (IsGuidedTutorialBattle &&
            actionBeforePhaseChange == TutorialAction.ContinuePhase &&
            !(previousPhase == MatchPhase.Attack &&
              IsDsaRecycleContinuePending))
        {
            NotifyTutorialAction(
                TutorialAction.ContinuePhase);
        }

        await ResolveAutomaticEndPhase(match);

        if (MatchManager.IsMatchOver(
                match.Player1,
                match.Player2))
        {
            CheckForZeroEnergy();
            return;
        }

        if (IsPassAndPlay())
        {
            showPassDeviceDialog = true;
            StateHasChanged();
            return;
        }

               await RunBotIfNeeded();

        await ResolveAutomaticEndPhase(match);

        if (MatchManager.IsMatchOver(
                match.Player1,
                match.Player2))
        {
            CheckForZeroEnergy();
            return;
        }

        // End-phase resolution may have started a new turn with the bot acting.
        // Check again after the previous bot invocation has fully released its lock.
        await RunBotIfNeeded();

        await RunAutomaticHumanPlacementIfNeeded();

        await ResolveAutomaticEndPhase(match);

        if (MatchManager.IsMatchOver(
                match.Player1,
                match.Player2))
        {
            CheckForZeroEnergy();
            return;
        }

        await RunAutomaticHumanPlacementIfNeeded();

        await HandleTutorialPhaseTransition(
            previousPhase,
            previousTurn);

        StateHasChanged();
    }

    private async Task<bool> CompleteCurrentPlayerPhaseWithEndAnimation(MatchState match)
    {
        if (match.CurrentPhase == MatchPhase.End)
        {
            // ResolveAnimated contains awaits, so Blazor can re-enter this flow
            // before the first End Phase has finished. Only one invocation may
            // resolve and advance an End Phase at a time.
            if (endPhaseResolutionInProgress)
            {
                Console.WriteLine(
                    "END PHASE TRANSITION BLOCKED: resolution already in progress.");
                return false;
            }

            endPhaseResolutionInProgress = true;
            try
            {
                Player acting = match.GetActingPlayer();
                int turnBeingResolved = match.TurnNumber;
                int actingIndexBeingResolved = match.ActingPlayerIndex;

                BattleLog.SetReplayContext(
                    turnBeingResolved,
                    actingIndexBeingResolved,
                    acting.Deck.Structure,
                    match.Player1,
                    match.Player2,
                    match);

                await EndPhaseManager.ResolveAnimated(
                    acting,
                    turnBeingResolved,
                    actingIndexBeingResolved,
                    async () =>
                    {
                        await InvokeAsync(StateHasChanged);
                    });

                // Do not advance a different phase/player if state changed while
                // the animation was awaiting UI updates.
                if (match.CurrentPhase != MatchPhase.End ||
                    match.TurnNumber != turnBeingResolved ||
                    match.ActingPlayerIndex != actingIndexBeingResolved ||
                    match.GetActingPlayer() != acting)
                {
                    Console.WriteLine(
                        "END PHASE ADVANCE CANCELLED: match state changed during resolution.");
                    return false;
                }

                // Effects were resolved above; advance without resolving them again.
                PhaseManager.CompleteCurrentPlayerPhaseAfterResolvedEnd(match);
                return true;
            }
            finally
            {
                endPhaseResolutionInProgress = false;
            }
        }

        PhaseManager.CompleteCurrentPlayerPhase(match);
        return true;
    }

    private async Task ResolveAutomaticEndPhase(
        MatchState match)
    {
        const int maximumEndResolutions = 4;
        int resolutionCount = 0;

        while (!match.IsCompleted &&
               !MatchManager.IsMatchOver(
                   match.Player1,
                   match.Player2) &&
               match.CurrentPhase == MatchPhase.End &&
               resolutionCount < maximumEndResolutions)
        {
            int turnBefore =
                match.TurnNumber;

            TutorialAction tutorialActionBeforeEnd =
                RequiredTutorialAction;

            if (!await CompleteCurrentPlayerPhaseWithEndAnimation(match))
            {
                return;
            }
            
            if (IsGuidedTutorialBattle &&
                tutorialActionBeforeEnd == TutorialAction.ContinuePhase &&
                !IsDsaRecycleContinuePending)
            {
                NotifyTutorialAction(
                    TutorialAction.ContinuePhase);
            }

            await HandleTutorialPhaseTransition(
                MatchPhase.End,
                turnBefore);

            resolutionCount++;
        }
    }

    private bool IsDsaRecycleContinuePending =>
        IsDsaTutorialBattle &&
        RequiredTutorialAction == TutorialAction.ContinuePhase &&
        string.Equals(
            TutorialManager.GetCurrentStep(Session.Tutorial)?.Title,
            "Watch the End-Phase Recycling",
            StringComparison.Ordinal);

    private Task HandleTutorialPhaseTransition(
        MatchPhase previousPhase,
        int previousTurn)
    {
        MatchState? match = Session.CurrentMatch;

        // Keep the recycling instruction visible while the normal End phase
        // resolves automatically. Only advance to the observation step once
        // the next Utility phase has actually begun and the new hand is visible.
        if (match != null &&
            IsDsaRecycleContinuePending &&
            previousTurn < match.TurnNumber &&
            match.CurrentPhase == MatchPhase.Utility &&
            match.GetActingPlayer() == GetPresentedPlayer())
        {
            NotifyTutorialAction(TutorialAction.ContinuePhase);
        }

        return Task.CompletedTask;
    }
    
    // 5. BOT TURN HANDLING

   private async Task RunBotIfNeeded()
{   
    Console.WriteLine(
    $"BOT ENTRY: botIsActing={botIsActing}, " +
    $"Phase={Session.CurrentMatch?.CurrentPhase}, " +
    $"Turn={Session.CurrentMatch?.TurnNumber}");

    if (Session.CurrentMatch == null || botIsActing)
    {
        Console.WriteLine("BOT ENTRY BLOCKED: already acting or no match.");
        return;
    }

    MatchState match =
        Session.CurrentMatch;

    Player actingPlayer =
        match.GetActingPlayer();

    if (!actingPlayer.IsBot)
    {
        return;
    }

    Player bot =
        actingPlayer;

    Player human =
        match.GetOpponent();

    botIsActing = true;

    Console.WriteLine(
        $"BOT LOCK ACQUIRED: match={System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(match)}, " +
        $"turn={match.TurnNumber}, phase={match.CurrentPhase}");

    logCollapsed = false;

    CloseGameplayPopups();
    StateHasChanged();

    try
    {
        const int maximumBotTransitions = 12;
        int transitionCount = 0;

        while (
            Session.CurrentMatch == match &&
            !match.IsCompleted &&
            !MatchManager.IsMatchOver(
                match.Player1,
                match.Player2) &&
            match.GetActingPlayer() == bot &&
            transitionCount <
                maximumBotTransitions)
        {
            MatchPhase phaseBefore =
                match.CurrentPhase;

            int turnBefore =
                match.TurnNumber;

            int actingPlayerBefore =
                match.ActingPlayerIndex;

            switch (phaseBefore)
            {
                case MatchPhase.Utility:
                    await RunBotUtilityPhase(
                        bot,
                        human);
                    break;

                case MatchPhase.Placement:
                    await RunBotPlacementPhase(
                        bot);
                    break;

                case MatchPhase.Attack:
                    await RunBotAttackPhase(
                        bot,
                        human);
                    break;

                case MatchPhase.End:
                    // EndPhaseManager.Resolve() is triggered by
                    // CompleteCurrentPlayerPhase().
                    break;
            }

            if (MatchManager.IsMatchOver(
                    match.Player1,
                    match.Player2))
            {
                CheckForZeroEnergy();
                return;
            }

            if (!await CompleteCurrentPlayerPhaseWithEndAnimation(
                    match))
            {
                return;
            }

            transitionCount++;
            Console.WriteLine(
    $"BOT LOOP CONTINUES: Turn={match.TurnNumber}, " +
    $"Phase={match.CurrentPhase}, " +
    $"ActingPlayer={match.GetActingPlayer().Name}, " +
    $"TransitionCount={transitionCount}");

            await HandleTutorialPhaseTransition(
                phaseBefore,
                turnBefore);

            bool stateChanged =
                match.CurrentPhase != phaseBefore ||
                match.TurnNumber != turnBefore ||
                match.ActingPlayerIndex !=
                    actingPlayerBefore;

            if (!stateChanged)
            {
                BattleLog.WriteSystem(
                    $"Bot phase recovery advanced " +
                    $"{bot.Name} from a stalled " +
                    $"{phaseBefore} phase.");

                if (!await CompleteCurrentPlayerPhaseWithEndAnimation(
                        match))
                {
                    return;
                }
            }

            if (IsDsaTutorialBattle &&
                match.TurnNumber > turnBefore)
            {
                StateHasChanged();
                break;
            }

            StateHasChanged();
        }

        if (transitionCount >=
                maximumBotTransitions &&
            !match.IsCompleted &&
            match.GetActingPlayer() == bot)
        {
            BattleLog.WriteSystem(
                $"Bot safety limit reached for " +
                $"{bot.Name}. Control was released " +
                $"to prevent an infinite loop.");
        }

        await ResolveAutomaticEndPhase(
            match);
    }
    catch (Exception exception)
    {
        BattleLog.WriteSystem(
            $"{bot.Name}'s automated turn encountered " +
            $"an error and was safely released.");

        Console.Error.WriteLine(
            "BOT TURN FAILED:");

        Console.Error.WriteLine(
            exception.ToString());
    }
   finally
        {
            Console.WriteLine(
                $"BOT LOCK RELEASED: match={System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(match)}, " +
                $"turn={match.TurnNumber}, phase={match.CurrentPhase}");

            botIsActing = false;
            StateHasChanged();
        }
}

private async Task RunBotUtilityPhase(
    Player bot,
    Player human)
{
    await BotThinkingDelay();

    if (Session.CurrentMatch == null)
    {
        return;
    }

    MatchState match =
        Session.CurrentMatch;

    if (match.IsCompleted ||
        match.CurrentPhase != MatchPhase.Utility ||
        match.GetActingPlayer() != bot)
    {
        return;
    }

    bool hasUtilityCard =
        bot.HandSlots.Any(slot =>
            !slot.IsEmpty &&
            slot.CardInSlot?.Type ==
                CardType.Utility);

    if (!hasUtilityCard)
    {
        BattleLog.Write(
            $"{bot.Name} has no Utility card and passes.");

        StateHasChanged();
        return;
    }

    int actionsBefore =
        BattleLog.GetPhaseActions().Count;
UpdateReplayContext();
    BotManager.RunUtility(
        bot,
        human);

    if (BattleLog.GetPhaseActions().Count ==
        actionsBefore)
    {
        BattleLog.Write(
            $"{bot.Name} has no usable Utility action and passes.");
    }

    StateHasChanged();
}

    private async Task RunBotPlacementPhase(
        Player bot)
    {
        int before =
            BattleLog.GetPhaseActions().Count;

        for (int step = 0; step <= 4; step++)
        {
            await BotThinkingDelay();
            UpdateReplayContext();
            BotManager.RunNextPlacementAction(
                bot,
                step);

            StateHasChanged();
        }

        if (BattleLog.GetPhaseActions().Count == before)
        {
            BattleLog.Write(
                $"{bot.Name} made no Placement changes.");

            StateHasChanged();
        }
    }

    private async Task RunBotAttackPhase(
        Player bot,
        Player human)
    {
        int before =
            BattleLog.GetPhaseActions().Count;

        for (int step = 0; step <= 2; step++)
        {
            if (MatchManager.IsMatchOver(
                    bot,
                    human))
            {
                return;
            }

            await BotThinkingDelay();
            UpdateReplayContext();
            BotManager.RunNextAttackAction(
                bot,
                human,
                step);

            if (CheckForZeroEnergy())
            {
                StateHasChanged();
                return;
            }

            StateHasChanged();
        }

        if (BattleLog.GetPhaseActions().Count == before)
        {
            BattleLog.Write(
                $"{bot.Name} made no attacks.");

            StateHasChanged();
        }
    }

    private async Task BotThinkingDelay()
    {
        StateHasChanged();

        await Task.Delay(
            Random.Shared.Next(500, 1501));
    }

    private async Task AcknowledgeCoinFlip()
    {
        if (Session.CurrentMatch == null ||
            coinFlipAcknowledged)
        {
            return;
        }

        coinFlipAcknowledged = true;
        showCoinFlipDialog = false;

        MatchState match =
            Session.CurrentMatch;

        if (IsPassAndPlay())
        {
            showPassDeviceDialog = true;
            StateHasChanged();
            return;
        }

        if (match.GetActingPlayer().IsBot)
            await RunBotIfNeeded();
