@page "/battle"
@using RedPandaTCD_Web.Game
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject GameSessionState Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
@layout BattleLayout

<PageTitle>Battle - Red Panda TCD</PageTitle>

<NavigationLock
    OnBeforeInternalNavigation="HandleNavigationAway"
    ConfirmExternalNavigation="@ShouldConfirmExternalNavigation" />

@if (Session.CurrentMatch == null)
{
    <div class="p-3">
        <h1>Battle</h1>
        <p>No active match.</p>
    </div>
}
else
{
    var match = Session.CurrentMatch;
    var player = GetPresentedPlayer();
    var enemy = GetPresentedOpponent();

<div class="battle @(logCollapsed ? "log-collapsed" : "") @GetTutorialFocusClass("battle-board") @GetPlayerInfoTutorialClass()">

        <section class="side enemy-side @GetTutorialFocusClass("enemy-field")">

            <PlayerInfo
                Player="enemy"
                Title="Enemy"
                ShowHandCount="true" />

            <div class="field">
                <AttackCard Owner="enemy" Slot="1" />
                <div class="character-tutorial-target @GetTutorialFocusClass("enemy-character")">
                    <CharacterCard Owner="enemy" />
                </div>
                <AttackCard Owner="enemy" Slot="2" />
            </div>
        </section>

<section class="phase-bar @GetTutorialFocusClass("phase-bar", "phase-utility", "phase-placement", "phase-attack", "phase-end", "initiative")">
            
                <div class="turn-details">
                    <strong>Turn @(IsReplayMode ? replayState!.Match.TurnNumber : match.TurnNumber)</strong>

                    <span class="initiative-owner">
                        Initiative → @(IsReplayMode
                            ? replayState!.Match.GetFirstPlayer().Name
                            : match.GetFirstPlayer().Name)
                    </span>
                </div>


            <div class="phases">
                @PhaseBox("Utility", MatchPhase.Utility, "utility")
                @PhaseBox("Placement", MatchPhase.Placement, "placement")
                @PhaseBox("Attack", MatchPhase.Attack, "attack")
                @PhaseBox("End", MatchPhase.End, "end")
            </div>

            <div class="turn-owner @GetTurnOwnerClass(player)">
                <span>@GetTurnOwnerText(player)</span>
            </div>
        </section>

       <section class="side player-side @GetTutorialFocusClass("player-field")">

            <div class="player-row">

               <PlayerInfo
                    Player="player"
                    Title="Player"
                    ShowUtilityActions="true" />

                <div class="field player-field">
                    <AttackCard
                        Owner="player"
                        Slot="1"
                        IsClickable="@CanInteractWithAttack(player, 1)"
                        HighlightAttackAction="@ShouldHighlightAttack(player, 1)"
                        PlacementHighlightClass="@GetAttackPlacementHighlight(player, 1)"
                        OnCardClicked="HandleAttackCardClick" />

                    <div class="character-tutorial-target @GetTutorialFocusClass("player-character", "wanderer-entry")">
                        <CharacterCard
                            Owner="player"
                            IsClickable="@CanInteractWithCharacter(player)"
                            HighlightAttackAction="@ShouldHighlightCharacterAbility(player)"
                            PlacementHighlightClass="@GetCharacterPlacementHighlight(player)"
                            OnCardClicked="HandleCharacterCardClick" />
                    </div>

                    <AttackCard
                        Owner="player"
                        Slot="2"
                        IsClickable="@CanInteractWithAttack(player, 2)"
                        HighlightAttackAction="@ShouldHighlightAttack(player, 2)"
                        PlacementHighlightClass="@GetAttackPlacementHighlight(player, 2)"
                        OnCardClicked="HandleAttackCardClick" />
                </div>

<div class="piles">

    <div class="@GetDeckClass(player)"
         @onclick="() => SelectDeckAction(player)">

        <strong>DECK</strong>

        <span class="pile-number">
            @(player.Deck.RuntimeStorage?.Count ?? 0)
        </span>

        <small class="deck-structure">
            @GetDeckStructureName(
                player.Deck.Structure)
        </small>
    </div>

    <div class="discard @GetTutorialFocusClass("discard-pile") @(CanOpenTutorialDiscardPile ? "tutorial-discard-clickable" : "")"
         @onclick="OpenTutorialDiscardPile">
        <strong>DISCARD</strong>

        <span class="pile-number">
            @player.DiscardPile.Count
        </span>
    </div>

</div>

            </div>
        </section>
            <aside class="log-panel @GetBattleLogTutorialFocusClass()">
            <div class="log-header">
                @if (!logCollapsed)
                {
                    <h2>Battle Log</h2>

                  <button class="copy-log-button"
        @onclick="CopyVisibleBattleLog">
    @(logCopied ? "Copied!" : "Copy Log")
</button>

<button class="copy-log-button"
        @onclick="CopyReplay">
    @(replayCopied ? "Copied!" : "Copy Replay")
</button>
                }

                <button class="log-toggle"
                        @onclick="ToggleLog">
                    @(logCollapsed ? "◀" : "▶")
                </button>
            </div>

            @if (!logCollapsed)
            {
                <div class="log" @ref="battleLogElement">
                    @if (GetDisplayedBattleLog().Count == 0)
                    {
                        <span class="muted">No actions yet.</span>
                    }
                    else
                    {
                        @foreach (BattleLogEntry entry in GetDisplayedBattleLog())
                        {
                            <div class="log-entry @GetLogPhaseClass(entry)">
                                <span class="log-phase">@entry.Label</span>
                                <span class="log-action">@entry.Message</span>
                            </div>
                        }
                    }
                </div>
            }

            <div class="match-controls">
    @if (IsReplayMode)
    {
        <div class="replay-controls">

            <div class="replay-status">
                @(replayState?.IsFinished == true
                    ? "Replay Finished"
                    : "Replay")
            </div>

            <div class="replay-buttons">

                <button
                    disabled="@(replayState == null)"
                    @onclick="ReplayStart">
                    Start
                </button>

                <button
                    disabled="@(replayState == null ||
                                 replayState.CurrentEventIndex <= 0)"
                    @onclick="ReplayPrevious">
                    Previous
                </button>

                <button
                    disabled="@(replayState == null ||
                                 replayState.IsFinished)"
                    @onclick="ReplayNext">
                    Next
                </button>

                <button
                    disabled="@(replayState == null)"
                    @onclick="ReplayEnd">
                    End
                </button>

            </div>

            @if (replayState?.CurrentEvent != null)
            {
                <div class="replay-current-event">
                    @replayState.CurrentEvent.Message
                </div>
            }

        </div>
    }
    else if (!IsBattleFinished)
    {
       <div class="continue-tutorial-target @GetContinueTutorialFocusClass()">
            <ContinueButton
                Disabled="@IsContinueDisabled(player)"
                IsBusy="@botIsActing"
                Highlight="@ShouldHighlightContinue(player)"
                OnClick="ContinuePhase" />
        </div>

        <button disabled="@IsSurrenderDisabled"
                @onclick="RequestSurrender">
            Surrender
        </button>
    }
    else if (observingFinishedMatch)
    {
        <div class="finished-observation-label">
            Match Finished · Observing Board
        </div>
    }
</div>
        </aside>

        <section class="hand-area @GetTutorialHandFocusClass()">
            <strong class="hand-label">Your Hand</strong>

            <div class="hand">
              @foreach (HandSlot slot in player.HandSlots)
{
    <div class="@GetTutorialHandCardClass(slot)">
        <HandCard
            Slot="slot"
            IsClickable="@CanSelectHandCard(player, slot)"
            OnCardClicked="SelectHandCard" />
    </div>
}
            </div>
        </section>

        @if (selectedHandSlot?.CardInSlot != null)
        {
            Card selectedCard = selectedHandSlot.CardInSlot;

            <div class="card-action-overlay"
     @onclick="RequestCloseHandCard">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>@selectedCard.Name</h3>

                    <div class="selected-card-meta">
                        <span>
                            @selectedCard.Archetype · @selectedCard.Type
                        </span>

                        <strong>COST @selectedCard.Cost</strong>
                    </div>

                    @if (selectedCard.Type == CardType.Utility)
                    {
                        <div class="utility-description">
                            <strong>EFFECT</strong>

                            <span>
                                @UtilityInfo.GetDescription(selectedCard)
                            </span>
                        </div>

                        <button disabled="@(!CanPlaySelectedUtility)"
                                @onclick="PlaySelectedUtility">
                            Play Utility
                        </button>
                    }

                    <button disabled="@(!CanDiscardSelectedCard)"
                            @onclick="DiscardSelectedCard">
                        Discard & Draw
                    </button>

                    <button disabled="@(!CanCloseSelectedHandCard)"
        @onclick="RequestCloseHandCard">
    Cancel
</button>
                </div>
            </div>
        }

        @if (showDeckAction && Session.CurrentMatch != null)
        {
            <div class="card-action-overlay"
                 @onclick="CloseDeckAction">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>Deck Action</h3>
                    <p>@GetDeckActionMessage(player)</p>

                    @if (player.Deck.Structure == DeckStructure.Queue ||
                         player.Deck.Structure == DeckStructure.Stack)
                    {
                        <button disabled="@(!CanPerformDeckTutorialAction(TutorialAction.PeekDeck))"
                                @onclick="PeekSelectedDeck">
                            Peek
                        </button>

                        <button @onclick="CloseDeckAction">
                            Cancel
                        </button>
                    }
                    else if (player.Deck.Structure == DeckStructure.RandomList)
                    {
                        <button disabled="@(!CanPerformDeckTutorialAction(TutorialAction.ViewDrawPool))"
                                @onclick="ViewSelectedDrawPool">
                            View Draw Pool
                        </button>

                        <button @onclick="CloseDeckAction">
                            Cancel
                        </button>
                    }
                    else if (player.Deck.Structure == DeckStructure.LinkedList)
                    {
                        <button disabled="@(!CanPerformDeckTutorialAction(TutorialAction.StartReorderNodes))"
                                @onclick="StartReorderNodes">
                            Reorder Nodes
                        </button>

                        <button @onclick="CloseDeckAction">
                            Cancel
                        </button>
                    }
                </div>
            </div>
        }

        @if (peekedCards != null)
        {
            <div class="component-popup-layer">
                <CardViewer
                    @key="peekedCards"
                    Title="Deck Peek"
                    Cards="peekedCards"
                    OnClose="ClosePeek" />
            </div>
        }

        @if (drawPoolCards != null)
        {
            <div class="component-popup-layer">
                <CardViewer
                    @key="drawPoolCards"
                    Title="Draw Pool"
                    Cards="drawPoolCards"
                    OnClose="CloseDrawPool" />
            </div>
        }

        @if (discardPileCards != null)
        {
            <div class="component-popup-layer">
                <CardViewer
                    @key="discardPileCards"
                    Title="Discard Pile — Recycling Preview"
                    Cards="discardPileCards"
                    OnClose="CloseTutorialDiscardPile" />
            </div>
        }

        @if (reorderCards != null)
        {
            <div class="component-popup-layer">
                <ReorderNodes
                    @key="reorderCards"
                    Cards="reorderCards"
                    OnMove="MoveReorderNode"
                    OnFinish="CloseReorderPreview" />
            </div>
        }

        @if (showPassDeviceDialog && Session.CurrentMatch != null)
        {
            var passMatch = Session.CurrentMatch;
            var nextPlayer = passMatch.GetActingPlayer();

            <div class="pass-device-overlay">
                <div class="pass-device-dialog">
                    <div class="pass-device-icon">↔</div>
                    <h2>Pass the Device</h2>
                    <p>Hand the device to</p>

                    <strong class="pass-player-name">
                        @nextPlayer.Name
                    </strong>

                    <p class="pass-warning">
                        The next player's hand will remain hidden
                        until they are ready.
                    </p>

                    <button @onclick="AcknowledgePassDevice">
                        I'm Ready
                    </button>
                </div>
            </div>
        }

        @if (showCoinFlipDialog && Session.CurrentMatch != null)
        {
            var coinFlipMatch = Session.CurrentMatch;
            bool playerWonFlip =
                coinFlipMatch.GetActingPlayer() == coinFlipMatch.Player1;

            <div class="card-action-overlay">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>Coin Flip</h3>

                    @if (IsPassAndPlay())
                    {
                        <p>
                            <strong>
                                @coinFlipMatch.GetActingPlayer().Name
                            </strong>
                            won the coin flip!<br />
                            @coinFlipMatch.GetActingPlayer().Name will act first.
                        </p>
                    }
                    else if (playerWonFlip)
                    {
                        <p>
                            You won the coin flip!<br />
                            You will act first.
                        </p>
                    }
                    else
                    {
                        <p>
                            Bot won the coin flip!<br />
                            Bot will act first.
                        </p>
                    }

                    <button @onclick="AcknowledgeCoinFlip">
                        Continue
                    </button>
                </div>
            </div>
        }

        @if (selectedPlacementAttackSlot != null &&
             !showFatiguedAttackActions)
        {
            Card? selectedFieldAttack =
                GetSelectedPlacementAttack(player);

            <div class="card-action-overlay"
                 @onclick="ClosePlacementAttack">
                <div class="card-action-panel placement-picker-panel"
                     @onclick:stopPropagation="true">

                    <h3>
                        @(selectedFieldAttack == null
                            ? "Deploy Attack"
                            : "Replace Attack")
                    </h3>

                    @if (selectedFieldAttack == null)
                    {
                        <p>
                            Choose an Attack for Slot
                            @selectedPlacementAttackSlot.
                        </p>
                    }
                    else
                    {
                        <p>
                            Choose an Attack to replace
                            <strong>@selectedFieldAttack.Name</strong>.
                        </p>
                    }

                    @{
                        var deployableAttacks =
                            player.HandSlots
                                .Where(slot =>
                                    !slot.IsEmpty &&
                                    slot.CardInSlot?.Type ==
                                        CardType.Attack)
                                .ToList();
                    }

@if (deployableAttacks.Count == 0)
{
    <p>No Attack cards in hand.</p>
}
else
{
    <div class="placement-card-choices">
        @foreach (HandSlot slot in deployableAttacks)
        {
            <div class="@GetReplacementChoiceClass(slot)">
                <HandCard
                    Slot="slot"
                    IsClickable="@CanChoosePlacementAttack(slot)"
                    OnCardClicked="DeploySelectedAttack" />
            </div>
        }
    </div>
}

                    <button @onclick="ClosePlacementAttack">
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (selectedPlacementAttackSlot != null &&
             showFatiguedAttackActions)
        {
            Card? fatiguedAttack =
                GetSelectedPlacementAttack(player);

            if (fatiguedAttack != null)
            {
                <div class="card-action-overlay"
                     @onclick="CloseFatiguedAttackActions">
                    <div class="card-action-panel"
                         @onclick:stopPropagation="true">

                        <h3>@fatiguedAttack.Name</h3>
                        <p>This Attack is Fatigued.</p>

                        @if (player.Deck.Structure ==
                             DeckStructure.PriorityQueue)
                        {
                            <button disabled="@(!CanResolveFatigueWithRest)"
                                    @onclick="EmergencyRestSelectedAttack">
                                Emergency Rest
                            </button>
                        }
                        else
                        {
                            <button disabled="@(!CanResolveFatigueWithRest)"
                                    @onclick="RestSelectedAttack">
                                Rest
                            </button>
                        }

                        <button disabled="@(!CanResolveFatigueWithReplace)"
                                @onclick="ReplaceSelectedFatiguedAttack">
                            Replace
                        </button>

                        <button @onclick="CloseFatiguedAttackActions">
                            Cancel
                        </button>
                    </div>
                </div>
            }
        }

        @if (showZeroEnergyDialog && Session.CurrentMatch != null)
        {
            MatchState finishedMatch = Session.CurrentMatch;
            Player? winner =
                surrendered
                    ? GetPresentedOpponent()
                    : MatchManager.GetWinner(
                        finishedMatch.Player1,
                        finishedMatch.Player2);

            <div class="card-action-overlay">
                <div class="card-action-panel result-panel"
                     @onclick:stopPropagation="true">

                    @if (surrendered)
                    {
                        <h3>Defeat</h3>
                        <p>You surrendered the match.</p>

                        <p>
                            <strong>
                                @GetPresentedOpponent().Name
                            </strong>
                            wins the match.
                        </p>
                    }
                    else if (finishedMatch.IsDraw)
                    {
                        <h3>Draw!</h3>
                        <p>Both players reached 0 Energy.</p>
                        <p>Neither player wins the match.</p>
                    }
                    else
                    {
                        bool playerWon =
                            winner == finishedMatch.Player1;

                        @if (IsTournamentChampion)
                        {
                            <div class="tournament-champion-result">
                                <div class="champion-kicker">
                                    GRAND TOURNAMENT
                                </div>

                                <h3 class="champion-heading">
                                    Champion!
                                </h3>

                                <div class="champion-title">
                                    MASTER STRATEGIST
                                </div>

                                <p>
                                    You defeated all three Tournament
                                    opponents.
                                </p>

                                <p>
                                    <strong>Rogue Nomad</strong>
                                    has been defeated.
                                </p>

                                @if (Session.Tournament.LockedPlayerDeck != null)
                                {
                                    <div class="champion-quote">
                                        @TournamentManager.GetVictoryQuote(
                                            Session.Tournament
                                                .LockedPlayerDeck
                                                .Structure)
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <h3>
                                @(playerWon ? "Victory!" : "Defeat")
                            </h3>

                            @if (winner != null)
                            {
                                <p>
                                    <strong>@winner.Name</strong>
                                    wins the match.
                                </p>
                            }

                            @if (finishedMatch.Player1.Energy <= 0)
                            {
                                <p>Your Energy reached 0.</p>
                            }
                            else if (finishedMatch.Player2.Energy <= 0)
                            {
                                <p>
                                    @finishedMatch.Player2.Name's
                                    Energy reached 0.
                                </p>
                            }
                        }
                    }

                    <button disabled="@IsObserveBoardDisabled"
                            @onclick="ObserveFinishedMatch">
                        Observe Board
                    </button>

                    @if (IsFinishedTournamentMatch)
                    {
                        @if (HasNextTournamentRound)
                        {
                            <button @onclick="ContinueTournament">
                                Continue Tournament
                            </button>
                        }
                        else
                        {
                            <button @onclick="ReturnToTournament">
                                Return to Tournament
                            </button>
                        }
                    }
                    else if (!IsGuidedTutorialBattle)
                    {
                        <button @onclick="ReturnToMainMenu">
                            Main Menu
                        </button>
                    }
                </div>
            </div>
        }

        @if (showZeroEnergyWarning)
        {
            <div class="card-action-overlay">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>Warning</h3>

                    <p>
                        This action will reduce your Energy to 0.
                    </p>

                    <p>
                        Reaching 0 Energy immediately ends the match.
                        This action could result in a loss or a draw.
                    </p>

                    <button @onclick="ConfirmZeroEnergyAction">
                        Continue Anyway
                    </button>

                    <button @onclick="CancelZeroEnergyAction">
                        Cancel
                    </button>
                </div>
            </div>
        }

        @if (showLeaveMatchDialog)
        {
            <div class="card-action-overlay"
                 @onclick="CancelLeaveMatch">
                <div class="card-action-panel"
                     @onclick:stopPropagation="true">

                    <h3>@(IsGuidedTutorialBattle ? "Leave Tutorial?" : "Leave Battle?")</h3>

                    <p>
                        @(IsGuidedTutorialBattle
                            ? "Leaving will end the current tutorial. Are you sure you want to leave?"
                            : "Leaving will end the current battle. Are you sure you want to leave?")
                    </p>

                    <button @onclick="ConfirmLeaveMatch">
                        @(IsGuidedTutorialBattle ? "Leave Tutorial" : "Leave Battle")
                    </button>

                    <button @onclick="CancelLeaveMatch">
                        Stay
                    </button>
                </div>
            </div>
        }

        @if (showCharacterPicker)
        {
            <div class="card-action-overlay"
                 @onclick="CloseCharacterPicker">
                <div class="card-action-panel character-picker-panel"
                     @onclick:stopPropagation="true">

                    <h3>
                        @(player.ActiveCharacter == null
                            ? "Deploy Character"
                            : "Replace Character")
                    </h3>

                    @if (player.ActiveCharacter == null)
                    {
                        <p>Choose a Character to deploy.</p>
                    }
                    else
                    {
                        <p>
                            Choose a Character to replace
                            <strong>
                                @player.ActiveCharacter.Name
                            </strong>.
                        </p>
                    }

                    @{
                        var deployableCharacters =
                            player.HandSlots
                                .Where(slot =>
                                    !slot.IsEmpty &&
                                    slot.CardInSlot?.Type ==
                                        CardType.Character)
                                .ToList();
                    }

                    @if (deployableCharacters.Count == 0)
                    {
                        <p>No Character cards in hand.</p>
                    }
                    else
                    {
                        <div class="character-picker-choices">
    @foreach (HandSlot slot in deployableCharacters)
    {
        Card character =
            slot.CardInSlot!;

        <div class="character-choice">
            <HandCard
                Slot="slot"
                IsClickable="@CanChoosePlacementCharacter(character)"
                IsDisplayOnly="true"
                OnCardClicked="DeploySelectedCharacter" />
        </div>
    }
</div>
                    }

                    <button @onclick="CloseCharacterPicker">
                        Cancel
                    </button>
                </div>
            </div>
        }

@if (showDiscardForEnergyPicker)
{
    <div class="card-action-overlay"
         @onclick="CloseDiscardForEnergyPicker">

        <div class="card-action-panel discard-energy-picker-panel"
             @onclick:stopPropagation="true">

            <h3>Discard For Energy</h3>

            <p>
                Choose a card to discard.
                You will gain Energy equal to that card's Cost.
            </p>

            @{
                var discardableCards =
                    player.HandSlots
                        .Where(slot =>
                            !slot.IsEmpty &&
                            slot.CardInSlot != null &&
                            slot.SlotNumber !=
                                discardForEnergyUtilitySlot)
                        .ToList();
            }

            @if (discardableCards.Count == 0)
            {
                <p>No other cards in hand.</p>
            }
            else
            {
                <div class="discard-energy-card-choices">
                    @foreach (HandSlot slot in discardableCards)
                    {
                        <div class="discard-energy-choice">
                            <HandCard
                                Slot="slot"
                                IsClickable="true"
                                OnCardClicked="SelectDiscardForEnergyCard" />
                        </div>
                    }
                </div>
            }

            <button @onclick="CloseDiscardForEnergyPicker">
                Cancel
            </button>
        </div>
    </div>
}
    </div>

        <TutorialOverlay
        @key="Session.Tutorial.CurrentStep"
        Visible="@ShowTutorialOverlay"
        OnAdvanced="HandleTutorialOverlayAdvanced"
        OnFinish="FinishCurrentTutorial" />
}
<style>
* {
    box-sizing: border-box;
}


/* =========================================================
   BATTLE FOUNDATION
   ========================================================= */

.battle {
    --header-offset: 58px;
    --log-width: 320px;
    --log-collapsed-width: 112px;
    --phase-row-height: 72px;
    --hand-row-height: 76px;

    --background: #0d1116;
    --surface: #151b21;
    --surface-raised: #1b232b;
    --surface-soft: #222b34;

    --line: rgba(226, 233, 239, 0.09);
    --line-strong: rgba(226, 233, 239, 0.17);

    --text: #edf1f4;
    --muted: #929da7;

    --utility: #63ad79;
    --placement: #dc6728;
    --placement-bright: #ff8a3d;
    --attack: #55b6df;
    --attack-bright: #7ed8f5;
    --end: #87919b;
    --danger: #dd6262;
    --interactable: #f2f7fb;

    --tutorial-gold: #ffe078;
    --champion-gold: #d6b65d;

    position: relative;
    isolation: isolate;

    height: calc(100dvh - var(--header-offset));
    min-height: 650px;

    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        var(--log-width);
    grid-template-rows:
        minmax(205px, 1fr)
        var(--phase-row-height)
        minmax(230px, 1fr)
        var(--hand-row-height);

    overflow: hidden;

    background:
        radial-gradient(
            ellipse at 50% 48%,
            rgba(82, 97, 111, 0.14) 0%,
            rgba(13, 17, 22, 0.04) 48%,
            rgba(5, 7, 10, 0.42) 100%
        ),
        repeating-linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.012) 0,
            rgba(255, 255, 255, 0.012) 1px,
            transparent 1px,
            transparent 8px
        ),
        var(--background);

    color: var(--text);

    transition:
        grid-template-columns 0.18s ease;
}

.battle::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;

    background:
        linear-gradient(
            180deg,
            rgba(117, 43, 51, 0.17) 0%,
            transparent 33%
        ),
        linear-gradient(
            0deg,
            rgba(37, 86, 123, 0.19) 0%,
            transparent 36%
        );

    box-shadow:
        inset 0 0 110px rgba(0, 0, 0, 0.43);
}

.battle > * {
    position: relative;
    z-index: 1;
}

.battle.log-collapsed {
    grid-template-columns:
        minmax(0, 1fr)
        var(--log-collapsed-width);
}


/* =========================================================
   BATTLEFIELD
   ========================================================= */

.battle .side {
    min-width: 0;
    padding:
        clamp(14px, 1.5vw, 24px)
        clamp(20px, 1.8vw, 30px);
    overflow: visible;
}

.battle .enemy-side {
    grid-column: 1;
    grid-row: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    border-bottom:
        1px solid rgba(221, 98, 98, 0.10);
}

.battle .player-side {
    grid-column: 1;
    grid-row: 3;

    display: flex;
    align-items: center;

    border-top:
        1px solid rgba(85, 182, 223, 0.10);
}

.battle .enemy-side::before,
.battle .player-side::before {
    content: "";
    position: absolute;
    inset: 14px 20px;
    z-index: -1;
    pointer-events: none;

    border:
        1px solid rgba(255, 255, 255, 0.04);
    border-radius: 14px;

    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.025),
        0 16px 36px rgba(0, 0, 0, 0.12);
}

.battle .enemy-side::before {
    background:
        linear-gradient(
            180deg,
            rgba(118, 52, 60, 0.09),
            rgba(255, 255, 255, 0.008)
        );
}

.battle .player-side::before {
    background:
        linear-gradient(
            0deg,
            rgba(45, 93, 132, 0.10),
            rgba(255, 255, 255, 0.008)
        );
}


/* =========================================================
   PLAYER INFORMATION
   ========================================================= */

.battle .enemy-side > .player-info,
.battle .player-row > .player-info,
.battle .player-info-tutorial-target > .player-info {
    position: absolute;
    top: 50%;

    width: 218px;
    padding: 14px 11px;

    border-radius: 9px;
    background: #0d1217;

    box-shadow:
        0 14px 30px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.035);

    transform: translateY(-50%);
}

.battle .enemy-side > .player-info {
    left: clamp(18px, 1.7vw, 28px);

    border:
        1px solid rgba(221, 98, 98, 0.20);
}

.battle .player-row > .player-info,
.battle .player-info-tutorial-target > .player-info {
    left: 0;

    border:
        1px solid rgba(85, 182, 223, 0.22);
}


/* =========================================================
   FIELD LAYOUT
   ========================================================= */

.battle .field {
    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2vw, 34px);

    perspective: 900px;
}

.battle .enemy-side > .field,
.battle .player-field {
    width: min(
        650px,
        calc(100% - 470px)
    );
}

.battle .player-row {
    position: relative;

    width: 100%;
    min-height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
}

.battle .field-card-wrap,
.battle .character-wrap {
    filter:
        drop-shadow(
            0 12px 13px rgba(0, 0, 0, 0.30)
        );

    transition:
        transform 0.16s ease,
        filter 0.16s ease;
}


/* =========================================================
   INTERACTION LANGUAGE

   Every interactable uses the same high-presence frame:
   - 3px semantic-color border
   - 2px outer outline
   - dark separation ring
   - 6px semantic-color outer ring
   - restrained static glow

   The geometry stays identical. Only the meaning/color changes:
   - Cyan: Attack card or Character ability
   - Orange: Placement action
   - White: General interaction, including Deck actions
   - Red: Fatigue or required resolution

   Normal gameplay never pulses or scales. Tutorial targets later
   override this section with gold and controlled scaling.
   ========================================================= */

.battle {
    --interaction-border-width: 4px;
    --interaction-outline-width: 2px;
    --interaction-outline-offset: 3px;
}


/* ---------- REMOVE COMPONENT-LEVEL INTERACTION EFFECTS ---------- */

/*
   PlacementHighlightClass is supplied to the card components.
   Component CSS may otherwise add its old yellow ring or pulse.
   Neutralize those wrapper-level effects so Battle owns one frame.
*/

.battle .attack-shell:is(
    .placement-deploy,
    .placement-replace,
    .placement-fatigued
),
.battle .character-shell:is(
    .placement-deploy,
    .placement-replace
),
.battle .field-card-wrap:is(
    .placement-deploy,
    .placement-replace,
    .placement-fatigued
),
.battle .character-wrap:is(
    .placement-deploy,
    .placement-replace
) {
    animation: none !important;
    transform: none !important;
    outline: 0 !important;
    overflow: visible !important;
}

.battle .attack-shell.clickable,
.battle .attack-shell.interactable,
.battle .character-shell.clickable,
.battle .character-shell.interactable,
.battle .deck-clickable {
    animation: none !important;
    transform: none !important;
}

.battle .attack-shell.clickable .field-card-wrap,
.battle .attack-shell.interactable .field-card-wrap,
.battle .character-shell.clickable .character-wrap,
.battle .character-shell.interactable .character-wrap,
.battle .attack-shell.clickable:hover .field-card-wrap,
.battle .attack-shell.interactable:hover .field-card-wrap,
.battle .character-shell.clickable:hover .character-wrap,
.battle .character-shell.interactable:hover .character-wrap {
    animation: none !important;
    transform: none !important;
    overflow: visible !important;
}


/* ---------- ATTACK / CHARACTER ACTION AVAILABLE ---------- */

.battle:has(.phase.attack.active)
.attack-shell.occupied.attack-action-ready,
.battle:has(.phase.attack.active)
.character-shell.occupied.attack-action-ready {
    border:
        var(--interaction-border-width)
        solid
        var(--attack-bright) !important;

    outline:
        var(--interaction-outline-width)
        solid
        rgba(126, 216, 245, 0.90) !important;

    outline-offset:
        var(--interaction-outline-offset) !important;

    box-shadow:
        0 0 0 2px rgba(7, 15, 20, 0.94),
        0 0 0 6px rgba(85, 182, 223, 0.38),
        0 0 22px rgba(85, 182, 223, 0.31),
        0 11px 23px rgba(0, 0, 0, 0.38) !important;

    cursor: pointer;
    animation: none !important;

    transition:
        border-color 0.14s ease,
        outline-color 0.14s ease,
        box-shadow 0.14s ease;
}

.battle:has(.phase.attack.active)
.attack-shell.occupied.attack-action-ready:hover,
.battle:has(.phase.attack.active)
.character-shell.occupied.attack-action-ready:hover {
    border-color: #a9ebff !important;
    outline-color: #d0f4ff !important;

    box-shadow:
        0 0 0 2px rgba(7, 15, 20, 0.96),
        0 0 0 7px rgba(85, 182, 223, 0.49),
        0 0 26px rgba(85, 182, 223, 0.39),
        0 13px 26px rgba(0, 0, 0, 0.42) !important;
}


/* ---------- PLACEMENT ACTION AVAILABLE ---------- */

.battle:has(.phase.placement.active)
.attack-shell:is(.placement-deploy, .placement-replace),
.battle:has(.phase.placement.active)
.character-shell:is(.placement-deploy, .placement-replace) {
    border:
        var(--interaction-border-width)
        solid
        var(--placement-bright) !important;

    outline:
        var(--interaction-outline-width)
        solid
        rgba(255, 138, 61, 0.92) !important;

    outline-offset:
        var(--interaction-outline-offset) !important;

    box-shadow:
        0 0 0 2px rgba(18, 8, 4, 0.94),
        0 0 0 6px rgba(220, 103, 40, 0.39),
        0 0 22px rgba(220, 103, 40, 0.32),
        0 11px 23px rgba(0, 0, 0, 0.38) !important;

    cursor: pointer;
    animation: none !important;

    transition:
        border-color 0.14s ease,
        outline-color 0.14s ease,
        box-shadow 0.14s ease;
}

.battle:has(.phase.placement.active)
.attack-shell:is(.placement-deploy, .placement-replace):hover,
.battle:has(.phase.placement.active)
.character-shell:is(.placement-deploy, .placement-replace):hover {
    border-color: #ff9f64 !important;
    outline-color: #ffd0b0 !important;

    box-shadow:
        0 0 0 2px rgba(18, 8, 4, 0.96),
        0 0 0 7px rgba(220, 103, 40, 0.50),
        0 0 26px rgba(220, 103, 40, 0.40),
        0 13px 26px rgba(0, 0, 0, 0.42) !important;
}


/* ---------- GENERAL ACTION AVAILABLE ---------- */

.battle .deck-clickable {
    cursor: pointer;

    border:
        var(--interaction-border-width)
        solid
        var(--interactable) !important;

    outline:
        var(--interaction-outline-width)
        solid
        rgba(242, 247, 251, 0.90) !important;

    outline-offset:
        var(--interaction-outline-offset) !important;

    box-shadow:
        4px 5px 0 rgba(4, 6, 8, 0.55),
        0 0 0 2px rgba(8, 13, 17, 0.94),
        0 0 0 6px rgba(242, 247, 251, 0.37),
        0 0 22px rgba(225, 240, 248, 0.30) !important;

    animation: none !important;

    transition:
        border-color 0.14s ease,
        outline-color 0.14s ease,
        box-shadow 0.14s ease;
}

.battle .deck-clickable:hover {
    border-color: #ffffff !important;
    outline-color: #ffffff !important;
    transform: rotate(0deg) !important;

    box-shadow:
        4px 7px 0 rgba(4, 6, 8, 0.50),
        0 0 0 2px rgba(8, 13, 17, 0.96),
        0 0 0 7px rgba(255, 255, 255, 0.48),
        0 0 26px rgba(225, 240, 248, 0.38),
        0 13px 26px rgba(0, 0, 0, 0.42) !important;
}


/* ---------- FATIGUE / REQUIRED RESOLUTION ---------- */

.battle .attack-shell:is(
    .fatigued,
    .danger,
    .placement-fatigued
) .field-card,
.battle .field-card.fatigued {
    border:
        var(--interaction-border-width)
        solid
        #e66a6a !important;

    outline:
        var(--interaction-outline-width)
        solid
        rgba(230, 106, 106, 0.92) !important;

    outline-offset:
        var(--interaction-outline-offset) !important;

    box-shadow:
        0 0 0 2px rgba(16, 8, 10, 0.94),
        0 0 0 6px rgba(221, 98, 98, 0.40),
        0 0 22px rgba(221, 98, 98, 0.33),
        0 11px 23px rgba(0, 0, 0, 0.38) !important;

    animation: none !important;
}

.battle .attack-shell:is(
    .fatigued,
    .danger,
    .placement-fatigued
):hover .field-card {
    border-color: #f17b7b !important;
    outline-color: #ffc0c0 !important;

    box-shadow:
        0 0 0 2px rgba(16, 8, 10, 0.96),
        0 0 0 7px rgba(221, 98, 98, 0.50),
        0 0 26px rgba(221, 98, 98, 0.41),
        0 13px 26px rgba(0, 0, 0, 0.42) !important;
}


/* ---------- CHARACTER INFORMATION STACKING ---------- */

/*
   Character details must render above neighboring Attack cards.
   This changes stacking only. It does not resize, clip, or place a
   border around the expanded information panel.
*/

.battle .field,
.battle .player-row,
.battle .enemy-side,
.battle .player-side {
    overflow: visible;
}

.battle .attack-shell,
.battle .character-shell,
.battle .field-card-wrap,
.battle .character-wrap {
    position: relative;
}

.battle .attack-shell {
    z-index: 2;
}

.battle .character-shell {
    z-index: 4;
}

.battle .character-shell:hover,
.battle .character-shell:focus-within,
.battle .character-wrap:hover,
.battle .character-wrap:focus-within,
.battle .character-card:hover,
.battle .character-card:focus-within {
    z-index: 40;
}

/* Any positioned information surface inside a hovered Character
   remains above the card row and above adjacent Attack cards. */

.battle .character-shell:hover .character-card > *,
.battle .character-shell:focus-within .character-card > * {
    position: relative;
    z-index: 41;
}

/* =========================================================
   PHASE BAR
   ========================================================= */

.battle .phase-bar {
    grid-column: 1;
    grid-row: 2;

    min-width: 0;
    min-height: var(--phase-row-height);
    padding: 8px 26px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line-strong);

    background: rgba(8, 11, 15, 0.95);

    box-shadow:
        0 -9px 24px rgba(0, 0, 0, 0.20),
        0 9px 24px rgba(0, 0, 0, 0.22);

    backdrop-filter: blur(10px);
}

.battle .turn-details {
    position: absolute;
    left: 26px;

    padding-left: 12px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;

    border-left:
        2px solid rgba(214, 182, 93, 0.58);

    white-space: nowrap;
}

.battle .turn-details strong {
    color: #f2f5f7;

    font-size: 18px;
    line-height: 1;
    letter-spacing: 0.25px;
}

.battle .initiative-owner {
    color: #c8b878;

    font-size: 10px;
    font-weight: 800;
    line-height: 1;

    text-transform: uppercase;
    letter-spacing: 0.7px;
}

.battle .phases {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
}

.battle .phase {
    position: relative;

    min-width: 105px;
    padding: 9px 16px;

    border:
        1px solid rgba(255, 255, 255, 0.10);
    border-radius: 5px;

    background: #20262d;
    color: #8d969e;

    font-size: 12px;
    font-weight: 800;
    text-align: center;
    letter-spacing: 0.35px;
    white-space: nowrap;

    opacity: 0.58;

    transition:
        opacity 0.15s ease,
        transform 0.15s ease,
        border-color 0.15s ease,
        background 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease;
}

.battle .phase:not(:last-child)::after {
    content: "›";

    position: absolute;
    right: -13px;
    top: 50%;

    color: #56606a;

    font-size: 17px;
    font-weight: 400;

    transform: translateY(-53%);

    pointer-events: none;
}

.battle .phase.utility {
    border-bottom-color:
        rgba(99, 173, 121, 0.48);
}

.battle .phase.placement {
    border-bottom-color:
        rgba(220, 103, 40, 0.58);
}

.battle .phase.attack {
    border-bottom-color:
        rgba(85, 182, 223, 0.48);
}

.battle .phase.end {
    border-bottom-color:
        rgba(135, 145, 155, 0.48);
}

.battle .phase.active {
    opacity: 1;

    transform: translateY(-2px);

    border-color:
        rgba(255, 255, 255, 0.38);

    color: #0d1419;

    box-shadow:
        0 6px 18px rgba(0, 0, 0, 0.34),
        inset 0 1px 0 rgba(255, 255, 255, 0.24);
}

.battle .phase.active.utility {
    background: var(--utility);
}

.battle .phase.active.placement {
    background: var(--placement);
    color: #1c1109;
}

.battle .phase.active.attack {
    background: var(--attack);
}

.battle .phase.active.end {
    background: var(--end);
}

.battle .turn-owner {
    position: absolute;
    right: 26px;

    padding: 7px 12px;

    border: 1px solid var(--line-strong);
    border-radius: 5px;

    background:
        rgba(255, 255, 255, 0.025);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    white-space: nowrap;
}

.battle .turn-owner.player-turn {
    border-color:
        rgba(99, 173, 121, 0.56);

    background:
        rgba(99, 173, 121, 0.08);

    color: #97d4a5;
}

.battle .turn-owner.bot-turn {
    border-color:
        rgba(221, 98, 98, 0.56);

    background:
        rgba(221, 98, 98, 0.08);

    color: #e58b8b;
}


/* =========================================================
   DECK AND DISCARD
   ========================================================= */

.battle .piles {
    position: absolute;
    right: 0;
    top: 50%;

    display: flex;
    align-items: flex-end;
    gap: 12px;

    transform: translateY(-50%);
}

.battle .deck,
.battle .discard {
    position: relative;
    flex-shrink: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    border-radius: 7px;

    box-shadow:
        4px 5px 0 rgba(4, 6, 8, 0.55),
        8px 10px 20px rgba(0, 0, 0, 0.24);
}

.battle .deck {
    width: 82px;
    height: 112px;

    border: 2px solid #5f98b8;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.22),
            transparent 38%
        ),
        linear-gradient(
            145deg,
            #8bc7e4,
            #529abb
        );

    color: #10202a;

    transform: rotate(0.6deg);
}

.battle .deck::before {
    content: "";

    position: absolute;
    inset: 4px;

    border:
        1px solid rgba(12, 42, 57, 0.26);
    border-radius: 4px;

    background:
        repeating-linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.055) 0,
            rgba(255, 255, 255, 0.055) 2px,
            transparent 2px,
            transparent 7px
        );

    pointer-events: none;
}

.battle .discard {
    width: 64px;
    height: 84px;

    border: 1px dashed #69737c;

    background:
        linear-gradient(
            145deg,
            #29313a,
            #1a2026
        );

    color: #e4e8eb;
    font-size: 10px;

    transform: rotate(-1deg);
}

.battle .pile-number {
    margin-top: 5px;

    font-size: 21px;
    font-weight: 900;
}

.battle .deck-structure {
    font-size: 9px;
    white-space: nowrap;
}

.battle .deck-clickable {
    cursor: pointer;

    border: var(--interaction-border-width) solid var(--interactable);

    outline:
        1px solid rgba(242, 247, 251, 0.38);
    outline-offset: 3px;

    box-shadow:
        4px 5px 0 rgba(4, 6, 8, 0.55),
        0 0 0 2px rgba(8, 13, 17, 0.88),
        0 0 0 4px rgba(242, 247, 251, 0.24),
        0 0 18px rgba(225, 240, 248, 0.18);

    animation: none !important;

    transition:
        transform 0.14s ease,
        border-color 0.14s ease,
        outline-color 0.14s ease,
        box-shadow 0.14s ease;
}

.battle .deck-clickable:hover {
    border-color: #ffffff;

    outline-color:
        rgba(255, 255, 255, 0.76);

    transform:
        translateY(-5px)
        rotate(0deg);

    box-shadow:
        4px 7px 0 rgba(4, 6, 8, 0.50),
        0 0 0 2px rgba(8, 13, 17, 0.94),
        0 0 0 5px rgba(255, 255, 255, 0.38),
        0 0 23px rgba(225, 240, 248, 0.26),
        0 14px 27px rgba(0, 0, 0, 0.41);
}

.battle .deck-disabled {
    cursor: default;

    filter: grayscale(0.82);
    opacity: 0.55;
}


/* =========================================================
   BATTLE LOG
   ========================================================= */

.battle .log-panel {
    grid-column: 2;
    grid-row: 1 / 5;

    min-width: 0;
    padding: 14px 13px;

    display: flex;
    flex-direction: column;

    border-left: 1px solid var(--line);

    background:
        linear-gradient(
            180deg,
            #141a20,
            #0f1419
        );

    color: var(--text);

    box-shadow:
        -12px 0 30px rgba(0, 0, 0, 0.23);
}

.battle .log-panel::after {
    content: "";

    width: 100%;
    flex: 0 0 66px;

    pointer-events: none;
}

.battle .log-header {
    min-height: 38px;
    padding: 0 0 10px;

    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        auto
        auto
        38px;

    align-items: center;
    gap: 6px;

    border-bottom: 1px solid var(--line);
}

.battle .log-header h2 {
    min-width: 0;
    margin: 0;

    overflow: hidden;

    color: #edf1f4;

    font-size: 18px;
    line-height: 1;
    letter-spacing: 0.2px;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.battle .copy-log-button,
.battle .copy-replay-button {
    min-width: 0;
    height: 30px;
    padding: 0 7px;

    overflow: hidden;

    border:
        1px solid rgba(255, 255, 255, 0.14);
    border-radius: 4px;

    background: #252c34;
    color: #dce2e7;

    cursor: pointer;

    font-size: 8px;
    font-weight: 900;
    line-height: 1;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.battle .copy-log-button:hover,
.battle .copy-replay-button:hover,
.battle .log-toggle:hover {
    border-color:
        rgba(242, 247, 251, 0.45);

    background: #2d3540;
    color: #ffffff;
}

.battle .log-toggle {
    width: 38px;
    min-width: 38px;
    height: 36px;
    padding: 0;

    border:
        1px solid rgba(255, 255, 255, 0.14);
    border-radius: 4px;

    background: #252c34;
    color: #dce2e7;

    cursor: pointer;
    font-weight: 900;
}

.battle.log-collapsed .log-panel {
    padding-inline: 10px;
}

.battle.log-collapsed .log-header {
    display: flex;
    justify-content: center;
    padding-inline: 0;
}

.battle.log-collapsed .log-toggle {
    width: 100%;
    min-width: 0;
    height: 42px;

    font-size: 17px;
}

.battle.log-collapsed .match-controls {
    width: 100%;
    gap: 8px;
}

.battle.log-collapsed .match-controls > button,
.battle.log-collapsed .match-controls .continue-button {
    width: 100%;
    min-width: 0;
    padding: 10px 4px;

    overflow: hidden;

    font-size: 10px;
    line-height: 1.05;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.battle.log-collapsed .finished-observation-label,
.battle.log-collapsed .replay-status,
.battle.log-collapsed .replay-current-event {
    font-size: 8px;
}

.battle.log-collapsed .replay-buttons {
    display: grid;
    grid-template-columns: 1fr;
}

.battle.log-collapsed .replay-buttons button {
    width: 100%;
    min-width: 0;
    padding: 8px 3px;

    font-size: 9px;
}

.battle .log {
    min-height: 0;
    margin-top: 10px;
    padding: 8px;

    flex: 1;

    overflow-y: auto;

    border: 0;
    border-radius: 7px;

    background: #0b1014;

    box-shadow:
        inset 0 1px 5px rgba(0, 0, 0, 0.48);

    font-size: 12px;

    scrollbar-width: thin;
    scrollbar-color: #49545e #0b1014;
}

.battle .log-entry {
    margin-bottom: 5px;
    padding: 7px 8px;

    border-left: 3px solid #69727b;
    border-radius: 0 4px 4px 0;

    background:
        rgba(255, 255, 255, 0.025);

    line-height: 1.35;
}

.battle .log-entry:hover {
    background:
        rgba(255, 255, 255, 0.045);
}

.battle .log-phase {
    display: inline-block;

    min-width: 62px;
    margin-right: 6px;
    padding: 2px 5px;

    border:
        1px solid rgba(255, 255, 255, 0.09);
    border-radius: 3px;

    background:
        rgba(255, 255, 255, 0.035);

    font-size: 8px;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
}

.battle .log-action {
    color: #e0e5e9;

    font-size: 11px;
    line-height: 1.4;
}

.battle .log-entry.log-utility {
    border-left-color: var(--utility);
}

.battle .log-entry.log-utility .log-phase {
    color: #83c692;
}

.battle .log-entry.log-placement {
    border-left-color: var(--placement);
}

.battle .log-entry.log-placement .log-phase {
    color: #ff9554;
}

.battle .log-entry.log-attack {
    border-left-color: var(--attack);
}

.battle .log-entry.log-attack .log-phase {
    color: #7ac3e8;
}

.battle .log-entry.log-end {
    border-left-color: var(--end);
}

.battle .log-entry.log-end .log-phase {
    color: #c0c7cd;
}

.battle .log-entry.log-system {
    border-left-color: #8b949e;

    background:
        rgba(139, 148, 158, 0.065);
}

.battle .log-entry.log-system .log-phase {
    color: #c9d0d6;
}

.battle .muted {
    color: #737d86;
}


/* =========================================================
   MATCH AND REPLAY CONTROLS
   ========================================================= */

.battle .match-controls {
    position: relative;

    margin-top: auto;
    padding-top: 12px;

    display: flex;
    flex-direction: column;
    gap: 9px;

    border-top: 1px solid var(--line);
}

.battle .match-controls > button {
    min-width: 80px;
    padding: 11px 7px;

    border:
        1px solid rgba(255, 255, 255, 0.14);
    border-radius: 4px;

    background: #252c34;
    color: #e3e8ec;

    cursor: pointer;

    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
}

.battle .match-controls > button:hover:not(:disabled) {
    border-color:
        rgba(242, 247, 251, 0.45);

    background: #2d3540;
    color: #ffffff;
}

.battle .match-controls > button:disabled {
    cursor: default;

    filter: grayscale(0.75);
    opacity: 0.4;
}

.battle .replay-controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.battle .replay-status {
    color: var(--champion-gold);

    font-size: 12px;
    font-weight: 900;
    text-align: center;
}

.battle .replay-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
}

.battle .replay-buttons button {
    padding: 7px 10px;

    border: 1px solid #56606a;
    border-radius: 4px;

    background: #20262c;
    color: #e5e8eb;

    cursor: pointer;
}

.battle .replay-buttons button:hover:not(:disabled) {
    border-color:
        rgba(242, 247, 251, 0.45);

    background: #2c343c;
}

.battle .replay-buttons button:disabled {
    cursor: default;
    opacity: 0.42;
}

.battle .replay-current-event {
    padding: 7px 9px;

    border: 1px solid #665b36;
    border-radius: 4px;

    background:
        rgba(214, 182, 93, 0.07);

    color: #ddd2a1;

    font-size: 10px;
    line-height: 1.4;
    text-align: center;
}

.battle .finished-observation-label {
    width: 100%;
    padding: 12px 8px;

    border: 1px solid #46505a;
    border-radius: 5px;

    background:
        rgba(255, 255, 255, 0.04);

    color: #c8d0d8;

    font-size: 10px;
    font-weight: 800;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}


/* =========================================================
   HAND OVERLAY DRAWER

   Utility:
   Solid drawer.

   Placement, Attack, End:
   Cards rise without a large drawer.
   ========================================================= */

.battle .hand-area {
    grid-column: 1;
    grid-row: 4;

    min-width: 0;
    min-height: 0;

    padding: 5px 24px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: visible;

    border-top: 1px solid var(--line);

    background: #0e1419;

    box-shadow:
        0 -8px 20px rgba(0, 0, 0, 0.30);
}

.battle .hand-area::before {
    content: "";

    position: absolute;
    inset: 6px 20px;
    z-index: -1;

    border:
        1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;

    background: #121920;
}

.battle .hand-area::after {
    content: "";

    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 6px;
    z-index: 1;

    height: 0;

    border: 1px solid transparent;
    border-radius: 12px 12px 9px 9px;

    background: #11181f;

    opacity: 0;

    box-shadow: none;

    pointer-events: none;

    transition:
        height 0.22s ease,
        opacity 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.22s ease;
}

.battle .hand-label {
    position: absolute;
    left: 28px;
    top: 50%;
    z-index: 5;

    color: #87929c;

    font-size: 11px;
    font-weight: 900;
    line-height: 1;

    text-transform: uppercase;
    letter-spacing: 1.15px;
    white-space: nowrap;

    transform: translateY(-50%);
}

.battle .hand {
    position: relative;
    z-index: 3;

    min-width: 0;

    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 13px;

    transform:
        translateY(68px)
        scale(0.78);

    transform-origin: center bottom;

    opacity: 1;
    filter: none;

    transition:
        transform 0.22s ease,
        filter 0.22s ease;
}


/* ---------- EMPTY SLOTS ---------- */

.battle .hand-empty-card {
    height: 48px !important;
    min-height: 48px !important;

    align-self: flex-end;

    border:
        1px dashed #46515b !important;

    background: #151b21 !important;
    color: #7d8790 !important;

    opacity: 1 !important;
    filter: none !important;

    box-shadow:
        0 9px 18px rgba(0, 0, 0, 0.36) !important;
}

.battle .hand-empty-card .empty-title {
    color: #8c96a0 !important;
    opacity: 1 !important;
}

.battle .hand-empty-card .slot-number {
    color: #66717b !important;
    opacity: 1 !important;
}

.battle .hand:not(:has(.hand-card-wrap)) {
    align-items: flex-end;

    transform:
        translateY(9px)
        scale(0.84);

    opacity: 1;
    filter: none;
}


/* ---------- DISABLED CARDS ---------- */

.battle .hand .hand-card-wrap.disabled {
    opacity: 1 !important;

    filter:
        grayscale(0.68)
        brightness(0.88) !important;
}


/* ---------- UTILITY SOLID DRAWER ---------- */

/*
   Desktop Utility behavior only:
   - Starts expanded.
   - Collapses while the player battlefield is hovered.
   - Reopens when the hand area, cabinet, or cards are hovered.
   - Collapsed Utility cards stay bright.
*/
@@media (min-width: 901px) {
    .battle:has(.phase.utility.active) .hand-area {
        position: relative;
        z-index: 100;
        background: #10161c;
        box-shadow:
            0 -24px 48px rgba(0, 0, 0, 0.60);
    }

    .battle:has(.phase.utility.active) .hand-area::before {
        border-color: rgba(99, 173, 121, 0.28);
        background: #151c23;
    }

    .battle:has(.phase.utility.active) .hand-area::after {
        left: 20px;
        right: 20px;
        bottom: -14px;
        z-index: 1;
        height: 230px;
        border-color: rgba(99, 173, 121, 0.28);
        background:
            linear-gradient(
                180deg,
                #19232b 0%,
                #11181f 100%
            );
        opacity: 1;
        box-shadow:
            0 -20px 44px rgba(0, 0, 0, 0.60);
        pointer-events: auto;
    }

    .battle:has(.phase.utility.active) .hand-area .hand {
        transform:
            translateY(-112px)
            scale(1);
        opacity: 1;
        filter: none;
    }

    .battle:has(.phase.utility.active) .hand-area .hand-label {
        position: absolute;
        left: 30px;
        top: -109px;
        z-index: 8;
        width: 112px;
        min-width: 0;
        padding: 6px 8px;
        box-sizing: border-box;
        border: 1px solid rgba(99, 173, 121, 0.26);
        border-radius: 4px;
        background: #11181f;
        color: #81c994;
        font-size: 10px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0.55px;
        white-space: nowrap;
        transform: none;
        pointer-events: none;
    }

    .battle:has(.phase.utility.active) .hand-area .hand-empty-card {
        height: 58px;
        min-height: 58px;
        align-self: flex-end;
    }

    .battle:has(.phase.utility.active):has(.player-side:hover)
    .hand-area:not(:hover)::after {
        height: 0;
        border-color: transparent;
        opacity: 0;
        box-shadow: none;
    }

    .battle:has(.phase.utility.active):has(.player-side:hover)
    .hand-area:not(:hover) .hand {
        transform:
            translateY(68px)
            scale(0.78);
        opacity: 1;
        filter: none;
    }

    .battle:has(.phase.utility.active):has(.player-side:hover)
    .hand-area:not(:hover) .hand-card-wrap {
        opacity: 1;
        filter: none;
    }

    .battle:has(.phase.utility.active):has(.player-side:hover)
    .hand-area:not(:hover) .hand-empty-card {
        height: 48px;
        min-height: 48px;
        align-self: flex-end;
        opacity: 1;
        filter: none;
    }

    .battle:has(.phase.utility.active):has(.player-side:hover)
    .hand-area:not(:hover) .hand-label {
        left: 28px;
        top: 50%;
        width: auto;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #87929c;
        font-size: 11px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 1.15px;
        transform: translateY(-50%);
    }
}

/* ---------- PLACEMENT / ATTACK / END: CARDS ONLY ---------- */

.battle:has(
    .phase:is(
        .placement,
        .attack,
        .end
    ).active
)
.hand-area:hover:has(.hand-card-wrap) {
    z-index: 100;

    background: #0e1419;

    box-shadow:
        0 -12px 26px rgba(0, 0, 0, 0.38);
}

.battle:has(
    .phase:is(
        .placement,
        .attack,
        .end
    ).active
)
.hand-area:hover:has(.hand-card-wrap)::after {
    height: 0;

    border-color: transparent;

    opacity: 0;

    box-shadow: none;
}

.battle:has(
    .phase:is(
        .placement,
        .attack,
        .end
    ).active
)
.hand-area:hover:has(.hand-card-wrap)
.hand {
    transform:
        translateY(-112px)
        scale(1);

    opacity: 1;
    filter: none;
}

.battle:has(
    .phase:is(
        .placement,
        .attack,
        .end
    ).active
)
.hand-area:hover
.hand-card-wrap.disabled {
    opacity: 1 !important;

    filter:
        grayscale(0.38)
        brightness(0.97) !important;
}

.battle:has(
    .phase:is(
        .placement,
        .attack,
        .end
    ).active
)
.hand-area:hover
.hand-empty-card {
    height: 58px !important;
    min-height: 58px !important;

    align-self: flex-end;
}


/* ---------- TRAY LABELS ---------- */

.battle:has(
    .phase:is(
        .placement,
        .attack,
        .end
    ).active
)
.hand-area:has(.hand-card-wrap)
.hand-label::after {
    content: " · HOVER TO VIEW";

    color: #65707a;

    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.75px;
}

.battle
.hand-area:not(:has(.hand-card-wrap))
.hand-label::after {
    content: " · EMPTY";

    color: #606a73;

    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.75px;
}

.battle:has(
    .phase:is(
        .placement,
        .attack,
        .end
    ).active
)
.hand-area:hover
.hand-label::after {
    content: "";
}


/* =========================================================
   MODALS AND OVERLAYS
   ========================================================= */

.battle .card-action-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;

    padding: 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        rgba(4, 7, 10, 0.72);

    backdrop-filter: blur(3px);
}

.battle .card-action-panel {
    width: min(340px, calc(100vw - 40px));
    max-height: calc(100dvh - 40px);
    padding: 24px;

    display: flex;
    flex-direction: column;
    gap: 12px;

    overflow-y: auto;

    border: 1px solid #66717a;
    border-radius: 8px;

    background:
        linear-gradient(
            145deg,
            #1d252d,
            #141a20
        );

    color: var(--text);

    box-shadow:
        0 20px 48px rgba(0, 0, 0, 0.48);

    text-align: center;
}

.battle .card-action-panel h3 {
    margin: 0;

    color: #f1efe8;
    font-size: 21px;
}

.battle .card-action-panel p {
    margin: 0 0 8px;

    color: #bfc7ce;
    line-height: 1.45;
}

.battle .card-action-panel button {
    padding: 10px 14px;

    border: 1px solid #777e85;
    border-radius: 5px;

    background: #e8e4da;
    color: #222;

    cursor: pointer;
    font-weight: 800;
}

.battle .card-action-panel button:hover:not(:disabled) {
    background: #f4efe3;
}

.battle .card-action-panel button:disabled {
    cursor: default;

    filter: grayscale(0.75);
    opacity: 0.4;
}

.battle .selected-card-meta,
.battle .utility-description,
.battle .character-choice-info {
    border: 1px solid #46505a;
    border-radius: 5px;

    background: #10161b;
}

.battle .selected-card-meta {
    padding: 8px 10px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.battle .selected-card-meta span {
    color: #91afd5;

    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

.battle .selected-card-meta strong {
    color: #bd83ed;

    font-size: 10px;
    white-space: nowrap;
}

.battle .utility-description {
    padding: 11px 12px;

    display: flex;
    flex-direction: column;
    gap: 5px;

    text-align: left;
}

.battle .utility-description strong {
    color: var(--utility);

    font-size: 10px;
    letter-spacing: 0.5px;
}

.battle .utility-description span {
    color: #c8d0d8;

    font-size: 11px;
    line-height: 1.4;
}


/* =========================================================
   CARD CHOICE PANELS
   ========================================================= */

.battle .placement-picker-panel {
    width: fit-content;
    min-width: 300px;
    max-width: calc(100vw - 60px);
}

.battle .placement-card-choices,
.battle .discard-energy-card-choices {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
}

.battle .character-picker-panel {
    width: fit-content;
    min-width: 340px;
    max-width: calc(100vw - 60px);
}

.battle .character-picker-choices {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;

    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
}

.battle .character-choice {
    width: auto;

    display: flex;
    align-items: center;
    justify-content: center;
}

/* =========================================================
   COMPONENT POPUP LAYER

   CardViewer and ReorderNodes are components with their own
   internal panels. This fixed layer gives Deck Peek, Draw
   Pool, and Reorder Nodes the same reliable viewport-level
   stacking context as the Battle page's native dialogs.
   ========================================================= */

.battle .component-popup-layer {
    position: fixed;
    inset: 0;
    z-index: 11000;

    display: grid;
    place-items: center;

    padding: 20px;
    overflow: auto;

    background: rgba(4, 7, 10, 0.78);
    backdrop-filter: blur(4px);
}

.battle .component-popup-layer > * {
    position: relative;
    z-index: 1;

    max-width: calc(100vw - 40px);
    max-height: calc(100dvh - 40px);
}

/* =========================================================
   PASS DEVICE
   ========================================================= */

.battle .pass-device-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;

    padding: 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        rgba(7, 11, 15, 0.96);
}

.battle .pass-device-dialog {
    width: min(420px, 100%);
    padding: 30px;

    display: flex;
    flex-direction: column;
    align-items: center;

    border: 1px solid #68645b;
    border-radius: 8px;

    background:
        linear-gradient(
            145deg,
            #1c252d,
            #141b21
        );

    color: #f0eee8;

    box-shadow:
        0 20px 48px rgba(0, 0, 0, 0.48);

    text-align: center;
}

.battle .pass-device-icon {
    margin-bottom: 10px;

    color: var(--champion-gold);

    font-size: 42px;
    font-weight: 900;
}

.battle .pass-device-dialog h2 {
    margin: 0 0 18px;

    font-size: 30px;
}

.battle .pass-device-dialog p {
    margin: 5px 0;

    color: #c8d0d8;
}

.battle .pass-player-name {
    margin: 8px 0 16px;

    color: var(--champion-gold);
    font-size: 25px;
}

.battle .pass-warning {
    max-width: 320px;
    margin-bottom: 20px !important;

    font-size: 12px;
}

.battle .pass-device-dialog button {
    width: min(280px, 100%);
    padding: 13px 18px;

    border: 1px solid #77736a;
    border-radius: 5px;

    background: #e7e4dc;
    color: #222;

    cursor: pointer;
    font-weight: 800;
}


/* =========================================================
   TOURNAMENT RESULTS
   ========================================================= */

.battle .tournament-champion-result {
    padding: 8px 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.battle .champion-kicker {
    color: var(--champion-gold);

    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.6px;
}

.battle .card-action-panel .champion-heading {
    margin: 2px 0 4px;

    color: #f4efe3;

    font-size: 28px;
    text-transform: uppercase;
}

.battle .champion-title {
    width: 100%;
    margin: 4px 0 8px;
    padding: 11px 14px;

    border: 1px solid #a88f4d;
    border-radius: 5px;

    background:
        rgba(214, 182, 93, 0.12);

    color: var(--champion-gold);

    font-size: 17px;
    font-weight: 900;
    letter-spacing: 1.2px;
}

.battle .champion-quote {
    width: 100%;
    margin-top: 5px;
    padding: 11px 12px;

    border-left:
        3px solid var(--champion-gold);

    background:
        rgba(255, 255, 255, 0.035);

    color: #c8d0d8;

    font-size: 11px;
    font-style: italic;
    line-height: 1.4;
}


/* =========================================================
   PRECISE TUTORIAL TARGETS WITHOUT CHANGING BATTLE GEOMETRY
   ========================================================= */
.battle .character-tutorial-target {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    height: fit-content;
    overflow: visible;
}
.battle .character-tutorial-target:hover,
.battle .character-tutorial-target:focus-within {
    z-index: 80;
}
.battle .character-tutorial-target .character-wrap,
.battle .character-tutorial-target .character-shell,
.battle .character-tutorial-target .character-card {
    overflow: visible;
}
.battle .character-tutorial-target:hover .character-wrap,
.battle .character-tutorial-target:hover .character-shell,
.battle .character-tutorial-target:hover .character-card,
.battle .character-tutorial-target:focus-within .character-wrap,
.battle .character-tutorial-target:focus-within .character-shell,
.battle .character-tutorial-target:focus-within .character-card {
    z-index: 81;
}
.battle .continue-tutorial-target {
    position: relative;
    display: block;
}
.battle .hand-area.tutorial-focus:hover:has(.hand-card-wrap) {
    z-index: 106;
}
