    {
        allowNavigation = true;
        Navigation.NavigateTo("/simulator");
        return;
    }

    Deck? player1Deck =
        DeckManager.GetDeck(P1DeckIndex);

    Deck? player2Deck =
        DeckManager.GetDeck(P2DeckIndex);

    if (player1Deck == null ||
        player2Deck == null)
    {
        allowNavigation = true;
        Navigation.NavigateTo("/simulator");
        return;
    }

    string? recordedP1Fingerprint =
        GetReplayDeckFingerprint(
            replayData,
