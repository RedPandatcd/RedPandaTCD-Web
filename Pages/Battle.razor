    private void HandleAttackCardClick(
        int slot)
    {
        if (Session.CurrentMatch == null)
            return;

        MatchState match =
            Session.CurrentMatch;

        Player player =
            GetPresentedPlayer();

        if (botIsActing ||
            match.GetActingPlayer() != player)
        {
            return;
        }

        if (match.CurrentPhase ==
            MatchPhase.Placement)
        {
            if (awaitingWandererEntry)
            {
                ResolveWandererEntrySelection(
                    player,
                    slot);

                return;
            }

            SelectPlacementAttack(slot);
            return;
        }

        if (match.CurrentPhase !=
                MatchPhase.Attack ||
            !CanInteractWithAttack(
                player,
                slot))
        {
            return;
        }
        UpdateReplayContext();
        bool success =
            AttackManager.UseAttack(
                player,
                GetPresentedOpponent(),
                slot);

        if (!success)
            return;

        NotifyTutorialAction(
            TutorialAction.UseAttack);

        CheckForZeroEnergy();
        StateHasChanged();
    }


    private void HandleCharacterCardClick()
    {
        if (Session.CurrentMatch == null)
            return;

        MatchState match =
            Session.CurrentMatch;

        Player player =
            GetPresentedPlayer();

        if (botIsActing ||
            match.GetActingPlayer() != player)
        {
            return;
        }

        if (match.CurrentPhase ==
            MatchPhase.Placement)
        {
            SelectPlacementCharacter();
            return;
        }

        if (match.CurrentPhase !=
                MatchPhase.Attack ||
            !CanInteractWithCharacter(player))
        {
            return;
        }
        UpdateReplayContext();
        bool success =
            AttackManager.UseCharacterAbility(
                player);

        if (!success)
            return;

        NotifyTutorialAction(
            TutorialAction.UseCharacterAbility);

        CheckForZeroEnergy();
        StateHasChanged();
    }

    private bool CanAffordCharacterAbility(
        Player player)
    {
        if (player.ActiveCharacter == null)
            return false;

        int cost =
            player.ActiveCharacter.ActiveAbility switch
            {
                "ShieldGain" => 2,
                "MagicBoost" => 1,
                "FieldShield" => 3,
                "PowerSurge" => 3,
                "AttackBoost" => 2,
                "Heal" => 2,
                _ => int.MaxValue
            };

        return player.Energy >= cost;
    }

