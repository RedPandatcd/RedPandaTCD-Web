    // 9. DSA / DECK STRUCTURE TUTORIAL  

    private async Task HandleDsaInformationalAdvance()
    {
        if (!IsDsaTutorialBattle || Session.CurrentMatch == null)
            return;

        // Priority Queue has no manual utility action. Once its utility
        // explanation is acknowledged, discard its two sample cards so the
        // real End-phase draw path can demonstrate recycling.
        if (Session.Tutorial.CurrentTutorial == TutorialType.PriorityQueue &&
            RequiredTutorialAction == TutorialAction.ContinuePhase &&
            Session.CurrentMatch.CurrentPhase == MatchPhase.Utility)
        {
            Player player = GetPresentedPlayer();
            if (player.Deck.Name.StartsWith("DSA Tutorial", StringComparison.Ordinal))
                DiscardRemainingTutorialSampleCards(player);
        }

        await Task.CompletedTask;
    }

    // 10. MATCH COMPLETION / SURRENDER

    private bool IsBattleFinished
    {
        get
        {
            if (surrendered)
                return true;

            if (Session.CurrentMatch == null)
                return true;

            return
                Session.CurrentMatch.IsCompleted ||
                MatchManager.IsMatchOver(
                    Session.CurrentMatch.Player1,
                    Session.CurrentMatch.Player2);
        }
    }

    private bool WouldReachZeroEnergy(
        Player player,
        int cost) =>
        cost > 0 &&
        player.Energy - cost <= 0;

    private void WarnBeforeZeroEnergy(
        Func<bool> action)
    {
        pendingZeroEnergyAction = action;
        showZeroEnergyWarning = true;
    }

    private void CancelZeroEnergyAction()
    {
        showZeroEnergyWarning = false;
        pendingZeroEnergyAction = null;
    }

    private void ConfirmZeroEnergyAction()
    {
        Func<bool>? action =
            pendingZeroEnergyAction;

        showZeroEnergyWarning = false;
        pendingZeroEnergyAction = null;

        if (action == null ||
            !action())
        {
            return;
        }

        CheckForZeroEnergy();
    }

    private bool CheckForZeroEnergy()
    {
        if (Session.CurrentMatch == null)
            return false;

        MatchState match =
            Session.CurrentMatch;

        if (match.Player1.Energy > 0 &&
            match.Player2.Energy > 0)
        {
            return false;
        }

        bool tournamentMatch =
            IsTournamentMatch;

        BattleEngine.CompleteMatch(
            match);

        if (!match.IsCompleted)
            return false;

        finishedTournamentMatch =
            tournamentMatch;

        if (tournamentMatch)
        {
            Player? winner =
                MatchManager.GetWinner(
                    match.Player1,
                    match.Player2);

            if (match.IsDraw ||
                winner == null)
            {
                TournamentManager.EndAfterLoss(
                    Session.Tournament);
            }
            else if (winner == match.Player1)
            {
                TournamentManager.AdvanceAfterWin(
                    Session.Tournament);
            }
            else
            {
                TournamentManager.EndAfterLoss(
                    Session.Tournament);
            }
        }

        CloseGameplayPopups();

        surrendered = false;
        observingFinishedMatch = false;
        showZeroEnergyWarning = false;
        pendingZeroEnergyAction = null;
        showZeroEnergyDialog = true;

        return true;
    }

    private void CancelLeaveMatch()
    {
        showLeaveMatchDialog = false;
        pendingNavigationUrl = null;
    }

    private void RequestSurrender()
    {
        if (IsBattleFinished ||
            IsSurrenderDisabled)
        {
            return;
        }

        pendingNavigationUrl = null;
        showLeaveMatchDialog = true;
    }

    private async Task ConfirmLeaveMatch()
    {
        if (Session.CurrentMatch == null ||
            IsBattleFinished)
        {
            showLeaveMatchDialog = false;
            pendingNavigationUrl = null;
            return;
        }

        string? destination =
            pendingNavigationUrl;

        bool tournamentMatch =
            IsTournamentMatch;

        bool tutorialSurrender =
            IsLearnToPlayBattle &&
            RequiredTutorialAction ==
                TutorialAction.Surrender;

        showLeaveMatchDialog = false;
        pendingNavigationUrl = null;
        surrendered = true;
        observingFinishedMatch = false;

        MatchState match =
            Session.CurrentMatch;

        Player losingPlayer =
            GetPresentedPlayer();

        Player winningPlayer =
            GetPresentedOpponent();

        // Record the surrender in the actual game state.
        losingPlayer.HasSurrendered = true;

        BattleLog.WriteSystem(
            $"{losingPlayer.Name} surrendered.");

        BattleLog.WriteSystem(
            $"Match ended. {winningPlayer.Name} wins.");

        // Complete the match through the normal engine pathway.
        BattleEngine.CompleteMatch(
            match);

        if (tournamentMatch)
        {
            finishedTournamentMatch = true;

            TournamentManager.EndAfterLoss(
                Session.Tournament);
        }

        botIsActing = false;

        CloseGameplayPopups();

        showZeroEnergyWarning = false;
        pendingZeroEnergyAction = null;

        if (tutorialSurrender)
        {
            NotifyTutorialAction(
                TutorialAction.Surrender);
        }

        if (!string.IsNullOrWhiteSpace(
                destination))
        {
          if (IsGuidedTutorialBattle)
        {
            DeckManager.DeleteTutorialDeck();

            await JS.InvokeVoidAsync(
                "deckStorage.save",
                DeckManager.ExportCustomDecks());

            Session.Tutorial.TutorialDeck = null;

            TutorialManager.ExitTutorial(
                Session.Tutorial);
        }

            Session.CurrentMatch = null;
            allowNavigation = true;

            Navigation.NavigateTo(
                destination);

            return;
        }

        showZeroEnergyDialog = true;
        logCollapsed = false;

        StateHasChanged();
    }

    private void ObserveFinishedMatch()
    {
        if (IsObserveBoardDisabled)
            return;

        showZeroEnergyDialog = false;
        observingFinishedMatch = true;

        CloseGameplayPopups();

        NotifyTutorialAction(
            TutorialAction.ObserveBoard);

        StateHasChanged();
    }

