    private void DiscardSelectedCard()
    {
        if (Session.CurrentMatch == null ||
            selectedHandSlot?.CardInSlot == null ||
            !TutorialAllows(
                TutorialAction.DiscardAndDraw))
        {
            return;
        }

        if (IsLearnToPlayBattle &&
            RequiredTutorialAction ==
                TutorialAction.DiscardAndDraw &&
            !string.Equals(
                selectedHandSlot.CardInSlot.Id,
                "AP7",
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        MatchState match =
            Session.CurrentMatch;

        Player player =
            GetPresentedPlayer();

        if (match.CurrentPhase != MatchPhase.Utility ||
            match.GetActingPlayer() != player ||
            player.UtilityActionsRemaining <= 0)
        {
            return;
        }
        UpdateReplayContext();
        bool success =
            UtilityManager.DiscardAndDraw(
                player,
                selectedHandSlot.SlotNumber,
                match.ActingPlayerIndex,
                match.TurnNumber);

        if (!success)
            return;

        selectedHandSlot = null;

        NotifyTutorialAction(
            TutorialAction.DiscardAndDraw);

        StateHasChanged();
    }

    private void PlaySelectedUtility()
    {
        if (Session.CurrentMatch == null ||
            selectedHandSlot?.CardInSlot == null ||
            !TutorialAllows(
                TutorialAction.PlayUtility))
        {
            return;
        }

        MatchState match =
            Session.CurrentMatch;

        Player player =
            GetPresentedPlayer();

        Card card =
            selectedHandSlot.CardInSlot;

        if (match.CurrentPhase != MatchPhase.Utility ||
            match.GetActingPlayer() != player ||
            player.UtilityActionsRemaining <= 0 ||
            card.Type != CardType.Utility ||
            player.Energy < card.Cost)
        {
            return;
        }

        if (IsLearnToPlayBattle &&
            card.Id != "UM1")
        {
            return;
        }

        if (card.Name == "Discard For Energy")
        {
            discardForEnergyUtilitySlot =
                selectedHandSlot.SlotNumber;

            selectedHandSlot = null;
            showDiscardForEnergyPicker = true;

            StateHasChanged();
            return;
        }
        UpdateReplayContext();
        bool success =
            UtilityManager.PlayUtility(
                player,
                GetPresentedOpponent(),
                selectedHandSlot.SlotNumber);

        if (!success)
            return;

        selectedHandSlot = null;

        NotifyTutorialAction(
            TutorialAction.PlayUtility);

        StateHasChanged();
    }

    private void CloseDiscardForEnergyPicker()
    {
        showDiscardForEnergyPicker = false;
        discardForEnergyUtilitySlot = null;
    }

    private void SelectDiscardForEnergyCard(
        HandSlot slot)
    {
        if (Session.CurrentMatch == null ||
            !showDiscardForEnergyPicker ||
            !discardForEnergyUtilitySlot.HasValue ||
            slot.IsEmpty ||
            slot.CardInSlot == null ||
            slot.SlotNumber ==
                discardForEnergyUtilitySlot.Value)
        {
            return;
        }

        MatchState match =
            Session.CurrentMatch;

        Player player =
            GetPresentedPlayer();

        if (match.CurrentPhase != MatchPhase.Utility ||
            match.GetActingPlayer() != player ||
            player.UtilityActionsRemaining <= 0)
        {
            return;
        }

        bool success =
            UtilityManager.DiscardForEnergy(
                player,
                discardForEnergyUtilitySlot.Value,
                slot.SlotNumber);

        if (!success)
            return;

        showDiscardForEnergyPicker = false;
        discardForEnergyUtilitySlot = null;

        StateHasChanged();
    }

    private bool HasLegalUtilityAction(
        Player player)
    {
        bool deckHasCards =
            player.Deck.RuntimeStorage != null &&
            player.Deck.RuntimeStorage.Count > 0;

        bool freePeek =
            CharacterManager.HasPassive(
                player,
                "FreePeek");

        if (freePeek &&
            deckHasCards &&
            player.Deck.Structure is
                DeckStructure.Queue or
                DeckStructure.Stack or
               DeckStructure.LinkedList)
        {
            return true;
        }

        if (player.UtilityActionsRemaining <= 0)
            return false;

        if (player.HandSlots.Any(
                slot => !slot.IsEmpty))
        {
            return true;
        }

        bool supportsDeckAction =
            player.Deck.Structure is
                DeckStructure.Queue or
                DeckStructure.Stack or
                DeckStructure.RandomList or
                DeckStructure.LinkedList;

        return
            deckHasCards &&
            supportsDeckAction;
    }

