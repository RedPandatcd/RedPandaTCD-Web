    private bool CanSelectPlacementCharacter(
        Player player)
    {
        MatchState? match =
            Session.CurrentMatch;

        if (match == null ||
            IsBattleFinished ||
            botIsActing ||
            match.CurrentPhase != MatchPhase.Placement ||
            match.GetActingPlayer() != player)
        {
            return false;
        }

        if (!IsGuidedTutorialBattle)
            return true;

        // The Learn to Play lesson separates beginning a replacement
        // from completing it, so choosing Wanderer cannot consume the
        // preceding tutorial step.
        TutorialAction expectedAction =
            player.ActiveCharacter == null
                ? TutorialAction.DeployCharacter
                : RequiredTutorialAction ==
                    TutorialAction.BeginCharacterReplacement
                    ? TutorialAction.BeginCharacterReplacement
                    : TutorialAction.ReplaceCharacter;

        return RequiredTutorialAction == expectedAction;
    }

    private void SelectPlacementCharacter()
    {
        if (Session.CurrentMatch == null)
