    private void DeploySelectedCharacter(
        HandSlot slot)
    {
        if (Session.CurrentMatch == null ||
            slot.IsEmpty ||
            slot.CardInSlot?.Type !=
                CardType.Character)
        {
            return;
        }

        Card character =
            slot.CardInSlot;

        bool isReplacement =
            GetPresentedPlayer().ActiveCharacter != null;

        if (!CanChoosePlacementCharacter(
                character))
        {
            return;
        }

        Player player =
            GetPresentedPlayer();

        if (!CanSelectPlacementCharacter(
                player))
        {
            return;
        }

        int cost =
            player.CharacterDefeatedSinceLastPlacement
                ? 0
                : player.ActiveCharacter != null
                    ? 4
                    : character.Cost;

        if (WouldReachZeroEnergy(
                player,
                cost))
        {
            if (IsGuidedTutorialBattle)
                return;

            showCharacterPicker = false;

            WarnBeforeZeroEnergy(() =>
                PlacementManager.TryDeployCharacter(
                    player,
                    slot.SlotNumber));

            return;
        }
        UpdateReplayContext();
        bool success =
            PlacementManager.TryDeployCharacter(
                player,
                slot.SlotNumber);

        if (!success)
            return;
        showCharacterPicker = false;

        if (isReplacement)
        {
            NotifyTutorialAction(
                TutorialAction.ReplaceCharacter);
        }
        else
        {
            NotifyTutorialAction(
                TutorialAction.DeployCharacter);
}

        if (player.ActiveCharacter?.Name ==
                "Wanderer Red Panda" &&
            (player.AttackSlot1 != null ||
             player.AttackSlot2 != null))
        {
            awaitingWandererEntry = true;
        }

        CheckForZeroEnergy();
        StateHasChanged();
    }

