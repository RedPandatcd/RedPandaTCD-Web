        string.Join(
            Environment.NewLine,
            entries.Select(entry =>
                string.IsNullOrWhiteSpace(entry.Label)
                    ? entry.Message
                    : $"{entry.Label}: {entry.Message}"));

    await JS.InvokeVoidAsync(
        "navigator.clipboard.writeText",
