    private bool HasLegalPlayerAction(
        Player player)
    {
        if (Session.CurrentMatch == null)
            return false;

        return Session.CurrentMatch.CurrentPhase switch
        {
            MatchPhase.Utility =>
                HasLegalUtilityAction(player),

            MatchPhase.Placement =>
                HasLegalPlacementAction(player),

            MatchPhase.Attack =>
                HasLegalAttackAction(player),

            _ =>
                false
        };
    }
    private bool CanInteractWithAttack(
    Player player,
    int slot)
{
    if (Session.CurrentMatch == null ||
        IsBattleFinished ||
        botIsActing)
    {
        return false;
    }

    MatchState match =
        Session.CurrentMatch;

    if (match.GetActingPlayer() != player)
    {
        return false;
    }

    if (slot != 1 &&
        slot != 2)
    {
        return false;
    }

  if (match.CurrentPhase == MatchPhase.Placement)
{
    if (IsDsaTutorialBattle)
    {
        if (RequiredTutorialAction != TutorialAction.DeployAttack)
            return false;

        Card? deployed = slot == 1
            ? player.AttackSlot1
            : player.AttackSlot2;
        if (deployed != null)
            return false;
    }

    if (IsLearnToPlayBattle &&
        RequiredTutorialAction ==
            TutorialAction.DeployAttack)
    {
        Card? deployed =
            slot == 1
                ? player.AttackSlot1
                : player.AttackSlot2;

        if (deployed != null)
            return false;
    }

    return HasLegalPlacementAttackAction(
        player,
        slot);
}

    if (match.CurrentPhase != MatchPhase.Attack)
    {
        return false;
    }

    Card? attack =
        slot == 1
            ? player.AttackSlot1
            : player.AttackSlot2;

    if (attack == null)
    {
        return false;
    }

    if (IsLearnToPlayBattle)
{
    if (RequiredTutorialAction !=
        TutorialAction.UseAttack)
    {
        return false;
    }

    if (string.Equals(
            TutorialTarget,
            "piercing-attack",
            StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(
            attack.Id,
            "AP4",
            StringComparison.OrdinalIgnoreCase))
    {
        return false;
    }

    if (string.Equals(
            TutorialTarget,
            "fireball",
            StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(
            attack.Id,
            "AM6",
            StringComparison.OrdinalIgnoreCase))
    {
        return false;
    }

    if (string.Equals(
            TutorialTarget,
            "multi-hit-attack",
            StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(
            attack.Id,
            "AM3",
            StringComparison.OrdinalIgnoreCase))
    {
        return false;
    }
}

    bool fatigued =
        slot == 1
            ? player.IsFatiguedSlot1
            : player.IsFatiguedSlot2;

    bool resting =
        slot == 1
            ? player.IsRestingSlot1
            : player.IsRestingSlot2;

    bool usedThisPhase =
        slot == 1
            ? player.AttackSlot1UsedThisPhase
            : player.AttackSlot2UsedThisPhase;

    int useCost =
        slot == 1
            ? player.AttackSlot1TotalUses
            : player.AttackSlot2TotalUses;

    return
        !fatigued &&
        !resting &&
        !usedThisPhase &&
        player.Energy >= useCost;
}


private bool HasLegalPlacementAttackAction(
    Player player,
    int fieldSlot)
{
    if (fieldSlot != 1 &&
        fieldSlot != 2)
    {
        return false;
    }

    bool isFatigued =
        fieldSlot == 1
            ? player.IsFatiguedSlot1
            : player.IsFatiguedSlot2;

    /*
     * A Fatigued Attack must still be resolved through
     * Rest, Emergency Rest, or Replace.
     */
    if (isFatigued)
    {
        return true;
    }

    foreach (HandSlot handSlot in player.HandSlots)
    {
        Card? card =
            handSlot.CardInSlot;

        if (card == null ||
            card.Type != CardType.Attack)
        {
            continue;
        }

        int cost =
            card.Cost;

        if (player.DiscountActive)
        {
            cost =
                Math.Max(
                    0,
                    cost - 1);
        }

        if (player.Energy >= cost)
        {
            return true;
        }
    }

    return false;
}


private bool CanInteractWithCharacter(
    Player player)
{
    if (Session.CurrentMatch == null ||
        IsBattleFinished ||
        botIsActing)
    {
        return false;
    }

    MatchState match =
        Session.CurrentMatch;

    if (match.GetActingPlayer() != player)
    {
        return false;
    }

    if (match.CurrentPhase == MatchPhase.Placement)
    {
        if (IsDsaTutorialBattle &&
            RequiredTutorialAction != TutorialAction.DeployCharacter)
        {
            return false;
        }

        return HasLegalPlacementCharacterAction(
            player);
    }

  if (match.CurrentPhase != MatchPhase.Attack)
{
    return false;
}

if (IsLearnToPlayBattle &&
    RequiredTutorialAction !=
        TutorialAction.UseCharacterAbility)
{
    return false;
}

if (player.ActiveCharacter == null)
{
    return false;
}

    if (player.CharacterNewlyDeployed ||
        player.AbilityUsedThisPhase ||
        player.AbilityCooldownRemaining > 0)
    {
        return false;
    }

    return CanAffordCharacterAbility(
        player);
}


private bool HasLegalPlacementCharacterAction(
    Player player)
{
    foreach (HandSlot handSlot in player.HandSlots)
    {
        Card? card =
            handSlot.CardInSlot;

        if (card == null ||
            card.Type != CardType.Character)
        {
            continue;
        }

        int cost;

        if (player.CharacterDefeatedSinceLastPlacement)
        {
            cost = 0;
        }
        else if (player.ActiveCharacter != null)
        {
            cost = 4;
        }
        else
        {
            cost =
                card.Cost;
        }

        if (player.Energy >= cost)
        {
            return true;
        }
    }

    return false;
}


private bool HasLegalPlacementAction(
    Player player)
{
    bool slot1ActionAvailable =
        HasLegalPlacementAttackAction(
            player,
            1);

    bool slot2ActionAvailable =
        HasLegalPlacementAttackAction(
            player,
            2);

    bool characterActionAvailable =
        HasLegalPlacementCharacterAction(
            player);

    return
        slot1ActionAvailable ||
        slot2ActionAvailable ||
        characterActionAvailable;
}

    private bool HasLegalAttackAction(
        Player player)
    {
        bool slot1 =
            player.AttackSlot1 != null &&
            !player.IsFatiguedSlot1 &&
            !player.IsRestingSlot1 &&
            !player.AttackSlot1UsedThisPhase &&
            player.Energy >=
                player.AttackSlot1TotalUses;

        bool slot2 =
            player.AttackSlot2 != null &&
            !player.IsFatiguedSlot2 &&
            !player.IsRestingSlot2 &&
            !player.AttackSlot2UsedThisPhase &&
            player.Energy >=
                player.AttackSlot2TotalUses;

        bool ability =
            player.ActiveCharacter != null &&
            !player.CharacterNewlyDeployed &&
            !player.AbilityUsedThisPhase &&
            player.AbilityCooldownRemaining <= 0 &&
            CanAffordCharacterAbility(player);

        return slot1 || slot2 || ability;
    }

