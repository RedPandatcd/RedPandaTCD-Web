@using RedPandaTCD_Web.Game

<div class="browse-row @RootClass">
    <button type="button"
            class="cabinet-toggle"
            title="@(IsExpanded ? "Hide card details" : "Show card details")"
            aria-expanded="@IsExpanded"
            @onclick="ToggleExpandedAsync">
        <span class="cabinet-chevron">
            @(IsExpanded ? "▼" : "▶")
        </span>
    </button>

    @if (Position.HasValue)
    {
        <div class="position-cell"
             title="Deck position">
            @Position.Value
        </div>
    }

    <button type="button"
            class="row-main"
            title="@(IsExpanded ? "Hide card details" : "Open card details")"
            @onclick="ToggleExpandedAsync">

        <span class="row-heading">
            <strong>
                @Card.Name
            </strong>

            <span class="archetype-pill @ArchetypeClass">
                @Card.Archetype
            </span>
        </span>

        <span class="row-meta">
            <span>@Card.Id</span>

            <span>·</span>

            <span>@Card.Type</span>

            <span>·</span>

            <span class="cost">
                <b>◆</b>@Card.Cost
            </span>

            @if (Priority.HasValue)
            {
                <span>·</span>

                <span class="priority">
                    PRIORITY @Priority.Value
                </span>
            }
        </span>

        <span class="row-detail">
            @if (Card.Type == CardType.Attack)
            {
                <span class="stat">
                    <b>@Card.Damage</b> DMG
                </span>

                <span class="stat">
                    <b>@Card.Hits</b>
                    @(Card.Hits == 1
                        ? "HIT"
                        : "HITS")
                </span>

                @if (Card.IsPiercing)
                {
                    <span class="trait piercing">
                        ◆ PIERCING
                    </span>
                }
                @if (Card.IgnoresShield)
                    {
                        <span class="cabinet-trait ignores-shield">
                            ◈ IGNORE SHIELD
                        </span>
                    }
                @if (Card.Hits > 1)
                {
                    <span class="trait multi-hit">
                        ✦ MULTI-HIT
                    </span>
                }

                @if (Card.InstantFatigue)
                {
                    <span class="trait instant-fatigue">
                        ! INSTANT FATIGUE
                    </span>
                }
            }
            else if (Card.Type == CardType.Character)
            {
                <span class="stat">
                    <b>@Card.HpValue</b> HP
                </span>

                <span class="stat">
                    <b>@Card.ShieldValue</b> SHIELD
                </span>

                <span class="detail-note">
                    ENTRY · PASSIVE · ACTIVE
                </span>
            }
            else
            {
                <span class="utility-summary">
                    @UtilityInfo.GetDescription(Card)
                </span>
            }
        </span>
    </button>

    <div class="row-actions">
        @if (ShowMoveControls)
        {
            <button type="button"
                    class="mini-action"
                    title="Move up"
                    disabled="@DisableMoveUp"
                    @onclick="MoveUpAsync">
                ↑
            </button>

            <button type="button"
                    class="mini-action"
                    title="Move down"
                    disabled="@DisableMoveDown"
                    @onclick="MoveDownAsync">
                ↓
            </button>
        }

        @if (ShowRemove)
        {
            <button type="button"
                    class="mini-action remove-action"
                    title="Remove card"
                    disabled="@DisableRemove"
                    @onclick="RemoveAsync">
                ×
            </button>
        }

        @if (ShowAdd)
        {
            <button type="button"
                    class="add-action"
                    title="@(AddDisabled
                        ? AddDisabledTitle
                        : "Add card to deck")"
                    disabled="@AddDisabled"
                    @onclick="AddAsync">
                +
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(StatusText))
        {
            <span class="status-chip @StatusClass">
                @StatusText
            </span>
        }
    </div>

    @if (IsExpanded)
    {
        <div class="card-cabinet @CabinetClass">

            <div class="cabinet-guide">
                <span class="guide-kicker">
                    CARD DETAILS
                </span>

                <strong class="cabinet-card-name">
                    @Card.Name
                </strong>

                <div class="cabinet-basic-meta">
                    <span>
                        @Card.Archetype
                    </span>

                    <span>
                        @Card.Type
                    </span>

                    <span>
                        COST @Card.Cost
                    </span>

                    @if (Priority.HasValue)
                    {
                        <span>
                            PRIORITY @Priority.Value
                        </span>
                    }
                </div>

                @if (Card.Type == CardType.Character)
                {
                    <div class="cabinet-stat-grid">
                        <span class="cabinet-stat">
                            <b>@Card.HpValue</b>
                            HP
                        </span>

                        <span class="cabinet-stat">
                            <b>@Card.ShieldValue</b>
                            SHIELD
                        </span>

                        <span class="cabinet-stat">
                            <b>@Card.Cost</b>
                            COST
                        </span>
                    </div>

                    <div class="cabinet-ability-list">

                        <section class="cabinet-ability entry">
                            <span class="cabinet-section-label">
                                ENTRY
                            </span>

                            <strong>
                                @CharacterInfo.GetEntryName(Card)
                            </strong>

                            <p>
                                @CharacterInfo.GetEntryDescription(Card)
                            </p>
                        </section>

                        <section class="cabinet-ability passive">
                            <span class="cabinet-section-label">
                                PASSIVE
                            </span>

                            <strong>
                                @CharacterInfo.GetPassiveName(Card)
                            </strong>

                            <p>
                                @CharacterInfo.GetPassiveDescription(Card)
                            </p>
                        </section>

                        <section class="cabinet-ability active">
                            <span class="cabinet-section-label">
                                ACTIVE
                            </span>

                            <strong>
                                @CharacterInfo.GetActiveName(Card)
                            </strong>

                            <p>
                                @CharacterInfo.GetActiveDescription(Card)
                            </p>

                            <div class="cabinet-active-meta">
                                <span>
                                    COST
                                    <b>
                                        @CharacterInfo.GetActiveCost(Card)
                                    </b>
                                    ENERGY
                                </span>

                                <span>
                                    COOLDOWN
                                    <b>
                                        @Card.AbilityCooldown
                                    </b>
                                </span>
                            </div>
                        </section>

                    </div>
                }
                else if (Card.Type == CardType.Attack)
                {
                    <div class="cabinet-stat-grid">
                        <span class="cabinet-stat">
                            <b>@Card.Damage</b>
                            DAMAGE
                        </span>

                        <span class="cabinet-stat">
                            <b>@Card.Hits</b>
                            @(Card.Hits == 1
                                ? "HIT"
                                : "HITS")
                        </span>

                        <span class="cabinet-stat">
                            <b>@Card.Cost</b>
                            COST
                        </span>
                    </div>

                    <section class="cabinet-attack-info">
                        <span class="cabinet-section-label">
                            ATTACK PROFILE
                        </span>

                        <strong>
                            @Card.Archetype Attack
                        </strong>

                        <div class="cabinet-traits">
                            @if (Card.IsPiercing)
                            {
                                <span class="cabinet-trait piercing">
                                    ◆ PIERCING
                                </span>
                            }

                            @if (Card.Hits > 1)
                            {
                                <span class="cabinet-trait multi-hit">
                                    ✦ MULTI-HIT
                                </span>
                            }

                            @if (Card.InstantFatigue)
                            {
                                <span class="cabinet-trait instant-fatigue">
                                    ! INSTANT FATIGUE
                                </span>
                            }

                            @if (!Card.IsPiercing &&
                                 Card.Hits <= 1 &&
                                 !Card.InstantFatigue)
                            {
                                <span class="cabinet-trait standard">
                                    STANDARD ATTACK
                                </span>
                            }
                            @if (Card.IgnoresShield)
                             {
                                <span class="cabinet-trait ignores-shield">
                                        ◈ IGNORE SHIELD
                                </span>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <div class="cabinet-stat-grid single-stat">
                        <span class="cabinet-stat">
                            <b>@Card.Cost</b>
                            COST
                        </span>
                    </div>

                    <section class="cabinet-utility-info">
                        <span class="cabinet-section-label">
                            EFFECT
                        </span>

                        <p>
                            @UtilityInfo.GetDescription(Card)
                        </p>
                    </section>
                }
            </div>

            @if (ShowCardPreview)
            {
                <div class="preview-stage">
                    <HandCard Slot="@PreviewSlot"
                              IsClickable="false"
                              IsDisplayOnly="true" />
                </div>
            }

        </div>
    }
</div>

<style>
.browse-row {
    --browse-border: #46515c;
    --browse-bg: #151e26;
    --browse-bg-2: #10171e;
    --browse-text: #edf2f5;
    --browse-muted: #8f9aa4;
    --browse-gold: #e5cc67;

    display: grid;
    grid-template-columns:
        38px
        minmax(0, 1fr)
        auto;

    align-items: stretch;
    overflow: visible;

    border: 1px solid var(--browse-border);
    border-radius: 8px;

    background:
        linear-gradient(
            145deg,
            var(--browse-bg),
            var(--browse-bg-2)
        );

    color: var(--browse-text);

    box-shadow:
        0 5px 14px rgba(0, 0, 0, .2);

    transition:
        border-color .16s ease,
        box-shadow .16s ease,
        opacity .16s ease,
        filter .16s ease;
}

.browse-row.has-position {
    grid-template-columns:
        38px
        36px
        minmax(0, 1fr)
        auto;
}

.browse-row.is-expanded {
    border-color: #71808d;

    box-shadow:
        0 9px 24px rgba(0, 0, 0, .3);
}

.browse-row.tutorial-required {
    border-color: var(--browse-gold);

    box-shadow:
        0 0 0 2px rgba(229, 204, 103, .22),
        0 0 19px rgba(229, 204, 103, .28);
}

.browse-row.is-subdued {
    opacity: .42;

    filter:
        saturate(.58)
        brightness(.72);
}

.browse-row.is-subdued.is-expanded {
    opacity: .72;

    filter:
        saturate(.72)
        brightness(.84);
}

.browse-row.is-complete {
    border-color: #477a58;
}

.cabinet-toggle,
.row-main,
.mini-action,
.add-action {
    font: inherit;
}

/* =========================================================
   EXPAND BUTTON
   ========================================================= */

.cabinet-toggle {
    border: 0;
    border-right: 1px solid #37434e;
    border-radius: 7px 0 0 7px;

    background: #202b35;
    color: #b9c4cd;

    cursor: pointer;
}

.cabinet-toggle:hover {
    background: #293641;
    color: #ffffff;
}

.browse-row.is-expanded .cabinet-toggle {
    background: #293641;
    color: #e5cc67;
}

.cabinet-chevron {
    font-size: 11px;
}

/* =========================================================
   POSITION
   ========================================================= */

.position-cell {
    display: flex;
    align-items: center;
    justify-content: center;

    border-right: 1px solid #37434e;

    background: rgba(255, 255, 255, .025);
    color: #c8d0d6;

    font-size: 11px;
    font-weight: 900;
}

/* =========================================================
   COMPACT ROW
   ========================================================= */

.row-main {
    min-width: 0;

    padding: 11px 13px;

    border: 0;

    background: transparent;
    color: inherit;

    cursor: pointer;
    text-align: left;
}

.row-main:hover {
    background: rgba(255, 255, 255, .025);
}

.row-heading,
.row-meta,
.row-detail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}

.row-heading {
    gap: 8px;
}

.row-heading strong {
    min-width: 0;

    overflow: hidden;

    font-size: 14px;
    letter-spacing: .25px;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.archetype-pill {
    padding: 3px 6px;

    border: 1px solid #64717c;
    border-radius: 999px;

    color: #bfc8cf;

    font-size: 7px;
    font-weight: 900;
    letter-spacing: .55px;

    text-transform: uppercase;
}

.archetype-pill.magic {
    border-color: #7f6aaa;
    color: #d5c3ff;
}

.archetype-pill.physical {
    border-color: #a96a59;
    color: #f1b4a1;
}

.archetype-pill.neutral {
    border-color: #697782;
    color: #ccd4da;
}

.row-meta {
    margin-top: 4px;

    gap: 4px;

    color: var(--browse-muted);

    font-size: 8px;
    font-weight: 800;
    letter-spacing: .4px;

    text-transform: uppercase;
}

.row-meta .cost b {
    margin-right: 2px;

    color: #72c7e9;
}

.row-meta .priority {
    color: #e0c86c;
}

.row-detail {
    min-height: 20px;

    margin-top: 7px;

    gap: 6px;
}

.stat,
.trait,
.detail-note {
    padding: 4px 7px;

    border: 1px solid #46535f;
    border-radius: 4px;

    background: #0d141a;
    color: #b8c3cb;

    font-size: 8px;
    font-weight: 900;
    letter-spacing: .35px;
}

.stat b {
    color: #ffffff;
}

.trait.piercing {
    border-color: #ca8443;
    color: #f1b16e;
}

.trait.multi-hit {
    border-color: #6588b7;
    color: #9fc8ff;
}

.trait.instant-fatigue {
    border-color: #ad5c62;
    color: #ef999f;
}

.detail-note {
    border-color: #756297;

    color: #d5c3ff;
}

.utility-summary {
    color: #aeb9c1;

    font-size: 9px;
    line-height: 1.4;
}

/* =========================================================
   ACTIONS
   ========================================================= */

.row-actions {
    padding: 7px;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 5px;
}

.mini-action,
.add-action {
    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 5px;

    cursor: pointer;
    font-weight: 900;
}

.mini-action {
    width: 30px;
    height: 30px;

    border: 1px solid #596672;

    background: #202a33;
    color: #c7d0d7;
}

.add-action {
    width: 36px;
    height: 36px;

    border: 1px solid #4e879d;

    background: #183748;
    color: #9ce2ff;

    font-size: 19px;
}

.add-action:hover:not(:disabled) {
    border-color: #8bdcff;

    background: #245268;
    color: #ffffff;
}

.remove-action:hover:not(:disabled) {
    border-color: #9f5b60;

    background: #43262a;
    color: #f0a2a7;
}

.browse-row.tutorial-required
.add-action:not(:disabled) {
    border-color: #e5cc67;

    background: #55471b;
    color: #ffe078;

    box-shadow:
        0 0 12px rgba(229, 204, 103, .25);
}

.mini-action:disabled,
.add-action:disabled {
    cursor: default;
    opacity: .32;
}

/* =========================================================
   STATUS
   ========================================================= */

.status-chip {
    padding: 5px 7px;

    border: 1px solid #60707c;
    border-radius: 5px;

    color: #b8c2ca;

    font-size: 8px;
    font-weight: 900;
    letter-spacing: .45px;

    text-transform: uppercase;
}

.status-chip.complete {
    border-color: #548564;

    background: rgba(76, 128, 91, .14);
    color: #9ed2aa;
}

/* =========================================================
   EXPANDED CARD CABINET
   ========================================================= */

.card-cabinet {
    grid-column: 1 / -1;

    padding: 16px;

    display: grid;
    grid-template-columns:
        minmax(260px, .95fr)
        minmax(220px, .75fr);

    gap: 20px;
    align-items: center;

    border-top: 1px solid #3a4650;

    background:
        linear-gradient(
            180deg,
            rgba(7, 12, 16, .56),
            rgba(16, 24, 31, .96)
        );
}

/*
    YOUR DECK MODE

    The row still expands and shows all useful information,
    but no rendered card visual is shown.
*/
.card-cabinet.information-only {
    grid-template-columns: 1fr;

    padding: 13px 14px;
}

.card-cabinet.information-only .cabinet-guide {
    width: 100%;
}

/*
    CARD FINDER CHARACTER MODE

    Keep the large Character preview only in the Card Finder.
    Your Deck uses information-only mode and does not render
    the card preview.
*/
.card-cabinet.character-preview {
    grid-template-columns:
        minmax(360px, 1fr)
        minmax(300px, 1fr);

    padding: 20px;

    gap: 20px;

    align-items: center;
}

.card-cabinet.character-preview .preview-stage {
    min-height: 390px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: visible;
}

/*
    Scale the rendered HandCard host instead of trying to
    reach CharacterCard's internal .character-wrap.
*/
.card-cabinet.character-preview .preview-stage > * {
    transform: scale(1.48);
    transform-origin: center;
}
/* =========================================================
   INFORMATION
   ========================================================= */

.cabinet-guide {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: 8px;
}

.guide-kicker {
    color: #e5cc67;

    font-size: 8px;
    font-weight: 900;
    letter-spacing: 1px;
}

.cabinet-card-name {
    color: #f3eee5;

    font-size: 17px;
    line-height: 1.15;
}

.cabinet-basic-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 5px;
}

.cabinet-basic-meta span {
    padding: 4px 7px;

    border: 1px solid #46535f;
    border-radius: 5px;

    background: #0d141a;
    color: #aeb9c1;

    font-size: 9px;
    font-weight: 900;

    text-transform: uppercase;
}

.cabinet-stat-grid {
    display: grid;
    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 6px;
}

.cabinet-stat-grid.single-stat {
    grid-template-columns:
        minmax(100px, 150px);
}

.cabinet-stat {
    min-width: 0;

    padding: 8px;

    display: flex;
    flex-direction: column;
    align-items: center;

    gap: 2px;

    border: 1px solid #46535f;
    border-radius: 6px;

    background: #111920;
    color: #aeb9c1;

    font-size: 9px;
    font-weight: 900;
}

.cabinet-stat b {
    color: #ffffff;

    font-size: 15px;
}

/* =========================================================
   CHARACTER ABILITIES
   ========================================================= */

.cabinet-ability-list {
    display: flex;
    flex-direction: column;

    gap: 7px;
}

.cabinet-ability,
.cabinet-attack-info,
.cabinet-utility-info {
    padding: 9px 10px;

    border: 1px solid #46535f;
    border-left-width: 3px;
    border-radius: 6px;

    background: #0d141a;
}

.cabinet-ability.entry {
    border-left-color: #e4a82f;
}

.cabinet-ability.passive {
    border-left-color: #8c58c7;
}

.cabinet-ability.active {
    border-left-color: #35c759;
}

.cabinet-section-label {
    display: block;

    margin-bottom: 3px;

    color: #8f9ba5;

    font-size: 8px;
    font-weight: 900;
    letter-spacing: .8px;
}

.cabinet-ability strong,
.cabinet-attack-info strong {
    color: #f3eee5;

    font-size: 12px;
}

.cabinet-ability p,
.cabinet-utility-info p {
    margin: 4px 0 0;

    color: #b3bdc5;

    font-size: 10px;
    line-height: 1.45;
}

.cabinet-active-meta {
    margin-top: 7px;

    display: flex;
    flex-wrap: wrap;

    gap: 5px;
}

.cabinet-active-meta span {
    padding: 4px 6px;

    border-radius: 4px;

    background: #17222a;
    color: #9faab3;

    font-size: 8px;
    font-weight: 800;
}

.cabinet-active-meta b {
    color: #ffffff;
}

/* Character details get a little more room
   when the full Character preview is displayed. */

.card-cabinet.character-preview
.cabinet-ability strong {
    font-size: 13px;
}

.card-cabinet.character-preview
.cabinet-ability p {
    font-size: 11px;
    line-height: 1.5;
}

.card-cabinet.character-preview
.cabinet-section-label {
    font-size: 9px;
}

/* =========================================================
   ATTACK DETAILS
   ========================================================= */

.cabinet-traits {
    margin-top: 8px;

    display: flex;
    flex-wrap: wrap;

    gap: 6px;
}

.cabinet-trait {
    padding: 5px 7px;

    border: 1px solid #53606a;
    border-radius: 5px;

    background: #171f26;
    color: #bdc6cd;

    font-size: 8px;
    font-weight: 900;
}

.cabinet-trait.piercing {
    border-color: #ca8443;
    color: #f1b16e;
}
.trait.ignores-shield {
    color: #ffb86b;
}

.cabinet-trait.ignores-shield {
    border-color: #ca8443;
    color: #f1b16e;
}
.cabinet-trait.multi-hit {
    border-color: #6588b7;
    color: #9fc8ff;
}

.cabinet-trait.instant-fatigue {
    border-color: #ad5c62;
    color: #ef999f;
}

.cabinet-trait.standard {
    color: #bfc8cf;
}

/* =========================================================
   ACTUAL CARD PREVIEW

   Only rendered when ShowCardPreview == true.
   ========================================================= */

.preview-stage {
    min-height: 190px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: visible;
}

.preview-stage :deep(.hand-card-wrap) {
    margin: 0;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@@media (max-width: 720px) {
    .browse-row,
    .browse-row.has-position {
        grid-template-columns:
            36px
            minmax(0, 1fr)
            auto;
    }

    .position-cell {
        display: none;
    }

    .card-cabinet,
    .card-cabinet.character-preview {
        grid-template-columns: 1fr;
    }

    .card-cabinet.character-preview
    .preview-stage {
        min-height: 250px;
    }

    .cabinet-stat-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }
}

@@media (max-width: 480px) {
    .cabinet-stat-grid {
        grid-template-columns: 1fr;
    }
}
</style>

@code {
    [Parameter, EditorRequired]
    public Card Card { get; set; } = default!;

    [Parameter]
    public int? Position { get; set; }

    [Parameter]
    public int? Priority { get; set; }

    /* =====================================================
       CARD PREVIEW MODE

       true:
           Finder expansion shows information + actual card.

       false:
           Your Deck expansion shows information only.
       ===================================================== */

    [Parameter]
    public bool ShowCardPreview { get; set; } = true;

    [Parameter]
    public bool ShowAdd { get; set; }

    [Parameter]
    public bool AddDisabled { get; set; }

    [Parameter]
    public string AddDisabledTitle { get; set; } =
        "This card cannot be added right now.";

    [Parameter]
    public EventCallback<Card> OnAdd { get; set; }

    [Parameter]
    public bool ShowMoveControls { get; set; }

    [Parameter]
    public bool DisableMoveUp { get; set; }

    [Parameter]
    public bool DisableMoveDown { get; set; }

    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public bool ShowRemove { get; set; }

    [Parameter]
    public bool DisableRemove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public bool TutorialRequired { get; set; }

    [Parameter]
    public bool Subdued { get; set; }

    [Parameter]
    public string StatusText { get; set; } = "";

    [Parameter]
    public string StatusClass { get; set; } = "";

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter]
    public bool StartExpanded { get; set; }

    private bool localExpanded;
    private bool initialized;

    private bool UsesControlledExpansion =>
        ExpandedChanged.HasDelegate;

    private bool IsExpanded =>
        UsesControlledExpansion
            ? Expanded
            : localExpanded;

    private HandSlot PreviewSlot =>
        new(1)
        {
            CardInSlot = Card
        };

    private string ArchetypeClass =>
        Card.Archetype switch
        {
            Archetype.Magic =>
                "magic",

            Archetype.Physical =>
                "physical",

            _ =>
                "neutral"
        };

    private string CabinetClass
    {
        get
        {
            if (!ShowCardPreview)
            {
                return "information-only";
            }

            if (Card.Type == CardType.Character)
            {
                return "character-preview";
            }

            return "";
        }
    }

    private string RootClass =>
        string.Join(
            " ",
            new[]
            {
                Position.HasValue
                    ? "has-position"
                    : "",

                IsExpanded
                    ? "is-expanded"
                    : "",

                TutorialRequired
                    ? "tutorial-required"
                    : "",

                Subdued
                    ? "is-subdued"
                    : "",

                string.Equals(
                    StatusClass,
                    "complete",
                    StringComparison.OrdinalIgnoreCase)
                        ? "is-complete"
                        : ""
            }
            .Where(value =>
                !string.IsNullOrWhiteSpace(value)));

    protected override void OnParametersSet()
    {
        if (initialized)
        {
            return;
        }

        localExpanded =
            StartExpanded;

        initialized =
            true;
    }

    private async Task ToggleExpandedAsync()
    {
        bool nextState =
            !IsExpanded;

        if (UsesControlledExpansion)
        {
            await ExpandedChanged.InvokeAsync(
                nextState);

            return;
        }

        localExpanded =
            nextState;
    }

    private async Task AddAsync()
    {
        if (AddDisabled)
        {
            return;
        }

        await OnAdd.InvokeAsync(
            Card);
    }

    private async Task MoveUpAsync()
    {
        if (DisableMoveUp)
        {
            return;
        }

        await OnMoveUp.InvokeAsync();
    }

    private async Task MoveDownAsync()
    {
        if (DisableMoveDown)
        {
            return;
        }

        await OnMoveDown.InvokeAsync();
    }

    private async Task RemoveAsync()
    {
        if (DisableRemove)
        {
            return;
        }

        await OnRemove.InvokeAsync();
    }
}