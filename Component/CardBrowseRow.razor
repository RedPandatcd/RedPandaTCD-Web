
@using RedPandaTCD_Web.Game

<div class="browse-row @RootClass">
    @if (ShowCardPreview)
    {
        <button type="button"
                class="cabinet-toggle"
                title="@(IsExpanded ? "Hide card details" : "Show card details")"
                aria-expanded="@IsExpanded"
                @onclick="ToggleExpandedAsync">
            <span class="cabinet-chevron">
                @(IsExpanded ? "▼" : "▶")
            </span>
        </button>
    }

    @if (Position.HasValue)
    {
        <div class="position-cell" title="Deck position">
            @Position.Value
        </div>
    }

    @if (ShowCardPreview)
    {
        <button type="button"
                class="row-main"
                title="@(IsExpanded ? "Hide card details" : "Open card details")"
                @onclick="ToggleExpandedAsync">

            <span class="row-heading">
                <strong>@Card.Name</strong>
                <span class="archetype-pill @ArchetypeClass">
                    @Card.Archetype
                </span>
            </span>

            <span class="row-meta">
                <span>@Card.Id</span>
                <span>·</span>
                <span>@Card.Type</span>
                <span>·</span>
                <span class="cost"><b>◆</b>@Card.Cost</span>

                @if (Priority.HasValue)
                {
                    <span>·</span>
                    <span class="priority">PRIORITY @Priority.Value</span>
                }
            </span>

            <span class="row-detail">
                @if (Card.Type == CardType.Attack)
                {
                    <span class="stat"><b>@Card.Damage</b> DMG</span>
                    <span class="stat">
                        <b>@Card.Hits</b>
                        @(Card.Hits == 1 ? "HIT" : "HITS")
                    </span>

                    @if (Card.IsPiercing)
                    {
                        <span class="trait piercing">◆ PIERCING</span>
                    }

                    @if (Card.IgnoresShield)
                    {
                        <span class="trait ignores-shield">◈ IGNORE SHIELD</span>
                    }

                    @if (Card.Hits > 1)
                    {
                        <span class="trait multi-hit">✦ MULTI-HIT</span>
                    }

                    @if (Card.InstantFatigue)
                    {
                        <span class="trait instant-fatigue">! INSTANT FATIGUE</span>
                    }
                }
                else if (Card.Type == CardType.Character)
                {
                    <span class="stat"><b>@Card.HpValue</b> HP</span>
                    <span class="stat"><b>@Card.ShieldValue</b> SHIELD</span>
                    <span class="detail-note">ENTRY · PASSIVE · ACTIVE</span>
                }
                else
                {
                    <span class="utility-summary">
                        @UtilityInfo.GetDescription(Card)
                    </span>
                }
            </span>
        </button>
    }
    else
    {
        <div class="row-main compact-deck-main">
            <span class="row-heading">
                <strong>@Card.Name</strong>
                <span class="archetype-pill @ArchetypeClass">
                    @Card.Archetype
                </span>
            </span>

            <span class="row-meta compact-deck-meta">
                <span>@Card.Type</span>
                <span>·</span>
                <span class="cost"><b>◆</b>@Card.Cost</span>

                @if (Priority.HasValue)
                {
                    <span>·</span>
                    <span class="priority">PRIORITY @Priority.Value</span>
                }

                @if (Card.Type == CardType.Attack)
                {
                    <span>·</span>
                    <span>@Card.Damage DMG</span>
                    <span>·</span>
                    <span>@Card.Hits HIT@(Card.Hits == 1 ? "" : "S")</span>
                }
                else if (Card.Type == CardType.Character)
                {
                    <span>·</span>
                    <span>@Card.HpValue HP</span>
                    <span>·</span>
                    <span>@Card.ShieldValue SHIELD</span>
                }
                else
                {
                    <span>·</span>
                    <span class="utility-summary">
                        @UtilityInfo.GetDescription(Card)
                    </span>
                }
            </span>
        </div>
    }

    <div class="row-actions">
        @if (ShowMoveControls)
        {
            <button type="button"
                    class="mini-action"
                    title="Move up"
                    disabled="@DisableMoveUp"
                    @onclick="MoveUpAsync">↑</button>

            <button type="button"
                    class="mini-action"
                    title="Move down"
                    disabled="@DisableMoveDown"
                    @onclick="MoveDownAsync">↓</button>
        }

        @if (ShowRemove)
        {
            <button type="button"
                    class="mini-action remove-action"
                    title="Remove card"
                    disabled="@DisableRemove"
                    @onclick="RemoveAsync">×</button>
        }

        @if (ShowAdd)
        {
            <button type="button"
                    class="add-action"
                    title="@(AddDisabled ? AddDisabledTitle : "Add card to deck")"
                    disabled="@AddDisabled"
                    @onclick="AddAsync">+</button>
        }

        @if (!string.IsNullOrWhiteSpace(StatusText))
        {
            <span class="status-chip @StatusClass">
                @StatusText
            </span>
        }
    </div>

    @* Expanded card details: this was the missing markup. *@
    @if (IsExpanded)
    {
        <div class="card-cabinet @CabinetClass">
            <div class="cabinet-guide">
                <span class="guide-kicker">CARD DETAILS</span>

                <h3 class="cabinet-card-name">@Card.Name</h3>

                <div class="cabinet-basic-meta">
                    <span>@Card.Type</span>
                    <span>@Card.Archetype</span>
                    <span>◆ @Card.Cost COST</span>
                    <span>@Card.Id</span>
                </div>

                @if (Card.Type == CardType.Attack)
                {
                    <div class="cabinet-stat-grid">
                        <div class="cabinet-stat">
                            <span>DAMAGE</span>
                            <b>@Card.Damage</b>
                        </div>
                        <div class="cabinet-stat">
                            <span>HITS</span>
                            <b>@Card.Hits</b>
                        </div>
                        <div class="cabinet-stat">
                            <span>COST</span>
                            <b>@Card.Cost</b>
                        </div>
                    </div>

                    @if (Card.IsPiercing || Card.IgnoresShield ||
                         Card.Hits > 1 || Card.InstantFatigue)
                    {
                        <div class="cabinet-traits">
                            @if (Card.IsPiercing)
                            {
                                <span class="cabinet-trait piercing">◆ PIERCING</span>
                            }
                            @if (Card.IgnoresShield)
                            {
                                <span class="cabinet-trait ignores-shield">◈ IGNORE SHIELD</span>
                            }
                            @if (Card.Hits > 1)
                            {
                                <span class="cabinet-trait multi-hit">✦ MULTI-HIT</span>
                            }
                            @if (Card.InstantFatigue)
                            {
                                <span class="cabinet-trait instant-fatigue">! INSTANT FATIGUE</span>
                            }
                        </div>
                    }

                    <div class="cabinet-attack-info">
                        <span class="cabinet-section-label">ATTACK</span>
                        <strong>
                            @Card.Damage damage × @Card.Hits
                            @(Card.Hits == 1 ? "hit" : "hits")
                        </strong>
                    </div>
                }
                else if (Card.Type == CardType.Character)
                {
                    <div class="cabinet-stat-grid">
                        <div class="cabinet-stat">
                            <span>HP</span>
                            <b>@Card.HpValue</b>
                        </div>
                        <div class="cabinet-stat">
                            <span>SHIELD</span>
                            <b>@Card.ShieldValue</b>
                        </div>
                        <div class="cabinet-stat">
                            <span>COST</span>
                            <b>@Card.Cost</b>
                        </div>
                    </div>

                    @* Use the existing description helper rather than
                       inventing character ability properties. *@
                    <div class="cabinet-utility-info">
                        <span class="cabinet-section-label">CARD EFFECT</span>
                        <p>@UtilityInfo.GetDescription(Card)</p>
                    </div>
                }
                else
                {
                    <div class="cabinet-stat-grid single-stat">
                        <div class="cabinet-stat">
                            <span>COST</span>
                            <b>@Card.Cost</b>
                        </div>
                    </div>

                    <div class="cabinet-utility-info">
                        <span class="cabinet-section-label">EFFECT</span>
                        <p>@UtilityInfo.GetDescription(Card)</p>
                    </div>
                }
            </div>

            @if (ShowCardPreview)
            {
                <div class="preview-stage">
                    <HandCard Card="@Card" Slot="@PreviewSlot" />
                </div>
            }
        </div>
    }
</div>

<style>
.browse-row {
    --browse-border: #46515c;
    --browse-bg: #151e26;
    --browse-bg-2: #10171e;
    --browse-text: #edf2f5;
    --browse-muted: #8f9aa4;
    --browse-gold: #e5cc67;

    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    align-items: stretch;
    overflow: visible;
    border: 1px solid var(--browse-border);
    border-radius: 8px;
    background: linear-gradient(145deg, var(--browse-bg), var(--browse-bg-2));
    color: var(--browse-text);
    box-shadow: 0 5px 14px rgba(0, 0, 0, .2);
    transition: border-color .16s ease, box-shadow .16s ease,
                opacity .16s ease, filter .16s ease;
}

.browse-row.has-position {
    grid-template-columns: 38px 36px minmax(0, 1fr) auto;
}

.browse-row.is-expanded {
    border-color: #71808d;
    box-shadow: 0 9px 24px rgba(0, 0, 0, .3);
}

.browse-row.tutorial-required {
    border-color: var(--browse-gold);
    box-shadow: 0 0 0 2px rgba(229, 204, 103, .22),
                0 0 19px rgba(229, 204, 103, .28);
}

.browse-row.is-subdued {
    opacity: .42;
    filter: saturate(.58) brightness(.72);
}

.browse-row.is-subdued.is-expanded {
    opacity: .72;
    filter: saturate(.72) brightness(.84);
}

.browse-row.is-complete {
    border-color: #477a58;
}

.cabinet-toggle,
.row-main,
.mini-action,
.add-action {
    box-sizing: border-box;
    font: inherit;
}

/* Expand button */
.cabinet-toggle {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    border-right: 1px solid #37434e;
    border-radius: 7px 0 0 7px;
    background: #202b35;
    color: #b9c4cd;
    cursor: pointer;
}

.cabinet-toggle:hover {
    background: #293641;
    color: #fff;
}

.browse-row.is-expanded .cabinet-toggle {
    background: #293641;
    color: #e5cc67;
}

.cabinet-chevron {
    font-size: 11px;
}

/* Position */
.position-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid #37434e;
    background: rgba(255, 255, 255, .025);
    color: #c8d0d6;
    font-size: 11px;
    font-weight: 900;
}

/* Main row */
.row-main {
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 100%;
    min-width: 0;
    align-self: stretch;
    margin: 0;
    padding: 11px 13px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--browse-text);
    font-family: inherit;
    font-size: inherit;
    text-align: left;
    cursor: pointer;
}

.row-main:hover,
.row-main:focus {
    background: rgba(255, 255, 255, .025);
    color: var(--browse-text);
}

.row-main:focus-visible {
    outline: 2px solid #72c7e9;
    outline-offset: -2px;
}

.row-main:active {
    background: rgba(255, 255, 255, .04);
    color: var(--browse-text);
}

.row-heading,
.row-meta,
.row-detail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}

.row-heading {
    gap: 8px;
}

.row-heading strong {
    min-width: 0;
    overflow: hidden;
    font-size: 14px;
    letter-spacing: .25px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.archetype-pill {
    flex-shrink: 0;
    padding: 3px 6px;
    border: 1px solid #64717c;
    border-radius: 999px;
    color: #bfc8cf;
    font-size: 7px;
    font-weight: 900;
    letter-spacing: .55px;
    text-transform: uppercase;
}

.archetype-pill.magic {
    border-color: #7f6aaa;
    color: #d5c3ff;
}

.archetype-pill.physical {
    border-color: #a96a59;
    color: #f1b4a1;
}

.archetype-pill.neutral {
    border-color: #697782;
    color: #ccd4da;
}

.row-meta {
    margin-top: 4px;
    gap: 4px;
    color: var(--browse-muted);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .4px;
    text-transform: uppercase;
}

.row-meta .cost {
    white-space: nowrap;
}

.row-meta .cost b {
    margin-right: 2px;
    color: #72c7e9;
}

.row-meta .priority {
    color: #e0c86c;
    white-space: nowrap;
}

/* Row details */
.row-detail {
    min-height: 20px;
    margin-top: 7px;
    gap: 6px;
}

.stat,
.trait,
.detail-note {
    padding: 4px 7px;
    border: 1px solid #46535f;
    border-radius: 4px;
    background: #0d141a;
    color: #b8c3cb;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .35px;
}

.stat b {
    color: #fff;
}

.trait.piercing {
    border-color: #ca8443;
    color: #f1b16e;
}

.trait.multi-hit {
    border-color: #6588b7;
    color: #9fc8ff;
}

.trait.instant-fatigue {
    border-color: #ad5c62;
    color: #ef999f;
}

.trait.ignores-shield {
    border-color: #ca8443;
    color: #ffb86b;
}

.detail-note {
    border-color: #756297;
    color: #d5c3ff;
}

.utility-summary {
    min-width: 0;
    color: #aeb9c1;
    font-size: 9px;
    line-height: 1.4;
}

/* Compact deck rows */
.compact-deck-main {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    align-self: center;
    padding: 5px 8px;
    background: transparent;
    color: var(--browse-text);
    cursor: default;
}

.compact-deck-main:hover,
.compact-deck-main:focus,
.compact-deck-main:active {
    background: transparent;
    color: var(--browse-text);
}

.compact-deck-main .row-heading {
    min-width: 0;
    flex: 1 1 auto;
    flex-wrap: nowrap;
    gap: 6px;
}

.compact-deck-main .row-heading strong {
    font-size: 12px;
}

.compact-deck-main .archetype-pill {
    padding: 2px 5px;
    font-size: 7px;
}

.compact-deck-meta {
    display: flex;
    min-width: 0;
    flex: 0 1 auto;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
    font-size: 8px;
    white-space: nowrap;
}

.compact-deck-meta .utility-summary {
    display: inline-block;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 8px;
}

/* Rows without expand buttons */
.browse-row:not(:has(.cabinet-toggle)) {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
}

.browse-row.has-position:not(:has(.cabinet-toggle)) {
    grid-template-columns: 30px minmax(0, 1fr) auto;
}

.browse-row:not(:has(.cabinet-toggle)) .row-actions {
    padding: 4px;
    gap: 3px;
}

.browse-row:not(:has(.cabinet-toggle)) .mini-action {
    width: 25px;
    height: 25px;
}

/* Actions */
.row-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    align-self: stretch;
    gap: 5px;
    padding: 7px;
}

.mini-action,
.add-action {
    appearance: none;
    -webkit-appearance: none;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin: 0;
    border-radius: 5px;
    font-family: inherit;
    cursor: pointer;
    font-weight: 900;
}

.mini-action {
    width: 30px;
    height: 30px;
    border: 1px solid #596672;
    background: #202a33;
    color: #c7d0d7;
}

.mini-action:hover:not(:disabled) {
    background: #2b3945;
    color: #fff;
}

.add-action {
    width: 36px;
    height: 36px;
    border: 1px solid #4e879d;
    background: #183748;
    color: #9ce2ff;
    font-size: 19px;
}

.add-action:hover:not(:disabled) {
    border-color: #8bdcff;
    background: #245268;
    color: #fff;
}

.remove-action:hover:not(:disabled) {
    border-color: #9f5b60;
    background: #43262a;
    color: #f0a2a7;
}

.browse-row.tutorial-required .add-action:not(:disabled) {
    border-color: #e5cc67;
    background: #55471b;
    color: #ffe078;
    box-shadow: 0 0 12px rgba(229, 204, 103, .25);
}

.mini-action:disabled,
.add-action:disabled {
    cursor: default;
    opacity: .32;
}

/* Status */
.status-chip {
    padding: 5px 7px;
    border: 1px solid #60707c;
    border-radius: 5px;
    color: #b8c2ca;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .45px;
    text-transform: uppercase;
}

.status-chip.complete {
    border-color: #548564;
    background: rgba(76, 128, 91, .14);
    color: #9ed2aa;
}

/* Expanded card cabinet */
.card-cabinet {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(260px, .95fr) minmax(220px, .75fr);
    align-items: center;
    gap: 20px;
    padding: 16px;
    border-top: 1px solid #3a4650;
    background: linear-gradient(180deg, rgba(7, 12, 16, .56), rgba(16, 24, 31, .96));
}

.card-cabinet.information-only {
    grid-template-columns: 1fr;
    padding: 13px 14px;
}

.card-cabinet.character-preview {
    grid-template-columns: minmax(360px, 1fr) minmax(300px, 1fr);
    align-items: center;
    gap: 20px;
    padding: 20px;
}

.card-cabinet.character-preview .preview-stage {
    display: flex;
    min-height: 390px;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.card-cabinet.character-preview .preview-stage > * {
    transform: scale(1.48);
    transform-origin: center;
}

/* Cabinet information */
.cabinet-guide {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
}

.guide-kicker {
    color: #e5cc67;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 1px;
}

.cabinet-card-name {
    margin: 0;
    color: #f3eee5;
    font-size: 17px;
    line-height: 1.15;
}

.cabinet-basic-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}

.cabinet-basic-meta span {
    padding: 4px 7px;
    border: 1px solid #46535f;
    border-radius: 5px;
    background: #0d141a;
    color: #aeb9c1;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
}

.cabinet-stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
}

.cabinet-stat-grid.single-stat {
    grid-template-columns: minmax(100px, 150px);
}

.cabinet-stat {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px;
    border: 1px solid #46535f;
    border-radius: 6px;
    background: #111920;
    color: #aeb9c1;
    font-size: 9px;
    font-weight: 900;
}

.cabinet-stat b {
    color: #fff;
    font-size: 15px;
}

/* Attack and utility descriptions */
.cabinet-attack-info,
.cabinet-utility-info {
    padding: 9px 10px;
    border: 1px solid #46535f;
    border-left-width: 3px;
    border-left-color: #ca8443;
    border-radius: 6px;
    background: #0d141a;
}

.cabinet-section-label {
    display: block;
    margin-bottom: 3px;
    color: #8f9ba5;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .8px;
}

.cabinet-attack-info strong {
    color: #f3eee5;
    font-size: 12px;
}

.cabinet-utility-info p {
    margin: 4px 0 0;
    color: #b3bdc5;
    font-size: 10px;
    line-height: 1.45;
}

/* Attack traits */
.cabinet-traits {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
}

.cabinet-trait {
    padding: 5px 7px;
    border: 1px solid #53606a;
    border-radius: 5px;
    background: #171f26;
    color: #bdc6cd;
    font-size: 8px;
    font-weight: 900;
}

.cabinet-trait.piercing,
.cabinet-trait.ignores-shield {
    border-color: #ca8443;
    color: #f1b16e;
}

.cabinet-trait.multi-hit {
    border-color: #6588b7;
    color: #9fc8ff;
}

.cabinet-trait.instant-fatigue {
    border-color: #ad5c62;
    color: #ef999f;
}

/* Card preview */
.preview-stage {
    display: flex;
    min-height: 190px;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.preview-stage :deep(.hand-card-wrap) {
    margin: 0;
}

/* Responsive */
@@media (max-width: 720px) {
    .browse-row,
    .browse-row.has-position {
        grid-template-columns: 36px minmax(0, 1fr) auto;
    }

    .position-cell {
        display: none;
    }

    .card-cabinet,
    .card-cabinet.character-preview {
        grid-template-columns: 1fr;
    }

    .card-cabinet.character-preview .preview-stage {
        min-height: 250px;
    }
}

@@media (max-width: 600px) {
    .compact-deck-main {
        align-items: flex-start;
        flex-direction: column;
        gap: 3px;
        padding: 6px 8px;
    }

    .compact-deck-main .row-heading {
        width: 100%;
    }

    .compact-deck-meta {
        justify-content: flex-start;
