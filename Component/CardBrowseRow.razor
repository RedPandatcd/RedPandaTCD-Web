@code {
    [Parameter, EditorRequired]
    public Card Card { get; set; } = default!;

    [Parameter]
    public int? Position { get; set; }

    [Parameter]
    public int? Priority { get; set; }

    [Parameter]
    public bool ShowCardPreview { get; set; } = true;

    [Parameter]
    public bool ShowAdd { get; set; }

    [Parameter]
    public bool AddDisabled { get; set; }

    [Parameter]
    public string AddDisabledTitle { get; set; } =
        "This card cannot be added right now.";

    [Parameter]
    public EventCallback<Card> OnAdd { get; set; }

    [Parameter]
    public bool ShowMoveControls { get; set; }

    [Parameter]
    public bool DisableMoveUp { get; set; }

    [Parameter]
    public bool DisableMoveDown { get; set; }

    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public bool ShowRemove { get; set; }

    [Parameter]
    public bool DisableRemove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public bool TutorialRequired { get; set; }

    [Parameter]
    public bool Subdued { get; set; }

    [Parameter]
    public string StatusText { get; set; } = "";

    [Parameter]
    public string StatusClass { get; set; } = "";

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter]
    public bool StartExpanded { get; set; }

    private bool localExpanded;
    private bool initialized;

    private bool UsesControlledExpansion =>
        ExpandedChanged.HasDelegate;

    private bool IsExpanded =>
        UsesControlledExpansion
            ? Expanded
            : localExpanded;

    private HandSlot PreviewSlot =>
        new(1)
        {
            CardInSlot = Card
        };

    private string ArchetypeClass =>
        Card.Archetype switch
        {
            Archetype.Magic => "magic",
            Archetype.Physical => "physical",
            _ => "neutral"
        };

    private string CabinetClass
    {
        get
        {
            if (!ShowCardPreview)
            {
                return "information-only";
            }

            if (Card.Type == CardType.Character)
            {
                return "character-preview";
            }

            return "";
        }
    }

    private string RootClass =>
        string.Join(
            " ",
            new[]
            {
                Position.HasValue ? "has-position" : "",
                IsExpanded ? "is-expanded" : "",
                TutorialRequired ? "tutorial-required" : "",
                Subdued ? "is-subdued" : "",
                string.Equals(
                    StatusClass,
                    "complete",
                    StringComparison.OrdinalIgnoreCase)
                    ? "is-complete"
                    : ""
            }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    protected override void OnParametersSet()
    {
        if (initialized)
        {
            return;
        }

        localExpanded = StartExpanded;
        initialized = true;
    }

    private async Task ToggleExpandedAsync()
    {
        bool nextState = !IsExpanded;

        if (UsesControlledExpansion)
        {
            await ExpandedChanged.InvokeAsync(nextState);
            return;
        }

        localExpanded = nextState;
    }

    private async Task AddAsync()
    {
        if (AddDisabled)
        {
            return;
        }

        await OnAdd.InvokeAsync(Card);
    }

    private async Task MoveUpAsync()
    {
        if (DisableMoveUp)
        {
            return;
        }

        await OnMoveUp.InvokeAsync();
    }

    private async Task MoveDownAsync()
    {
        if (DisableMoveDown)
        {
            return;
        }

        await OnMoveDown.InvokeAsync();
    }

    private async Task RemoveAsync()
    {
        if (DisableRemove)
        {
            return;
        }

        await OnRemove.InvokeAsync();
    }
}
