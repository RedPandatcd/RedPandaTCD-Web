@code {
    [Parameter]
    public HandSlot Slot { get; set; } = default!;

    [Parameter]
    public bool IsClickable { get; set; }

    [Parameter]
    public bool IsDisplayOnly { get; set; }

    [Parameter]
    public EventCallback<HandSlot> OnCardClicked { get; set; }

    private sealed record HandAttackTrait(string Label, string Icon, string CssClass);

    private async Task HandleClick()
    {
        if (!IsClickable || Slot.IsEmpty)
        {
            return;
        }

        await OnCardClicked.InvokeAsync(Slot);
    }

   private string GetInteractionClass()
{
    if (IsDisplayOnly)
    {
        return "display-only";
    }

    if (IsClickable)
    {
        return "clickable";
    }

    return "disabled";
}

    private static string GetArchetypeClass(Card card) =>
        card.Archetype switch
        {
            Archetype.Magic => "archetype-magic",
            Archetype.Physical => "archetype-physical",
            _ => "archetype-neutral"
        };

    private static string GetCharacterArchetypeClass(Card card) =>
        card.Archetype switch
        {
            Archetype.Magic => "magic",
            Archetype.Physical => "physical",
            _ => "neutral"
        };

    private static string GetUtilityArchetypeClass(Card card) =>
        card.Archetype switch
        {
            Archetype.Magic => "utility-magic",
            Archetype.Physical => "utility-physical",
            _ => "utility-neutral"
        };

    private static string GetAttackTypeLabel(Card card) =>
        card.Archetype switch
        {
            Archetype.Magic => "Magic Attack",
            Archetype.Physical => "Physical Attack",
            _ => "Neutral Attack"
        };

    private static string GetAttackMark(Card card) =>
        card.Archetype switch
        {
            Archetype.Magic => "✧",
            Archetype.Physical => "▲",
            _ => "●"
        };

    private static IReadOnlyList<HandAttackTrait> GetAttackTraits(Card card)
    {
        List<HandAttackTrait> traits = new();

        if (card.IsPiercing)
        {
            traits.Add(new("Piercing", "🗡️", "trait-piercing"));
        }

        if (card.Hits > 1)
        {
            traits.Add(new("Multi-Hit", "", "trait-multi-hit"));
        }

        if (card.IgnoresShield)
        {
            traits.Add(new("Ignore Shield", "", "trait-ignore-shield"));
        }

        if (card.InstantFatigue)
        {
            traits.Add(new("Instant Fatigue", "⚡", "trait-instant-fatigue"));
        }

        return traits;
    }

    private static string GetCharacterMark(Card card) =>
        card.Archetype switch
        {
            Archetype.Magic => "✦",
            Archetype.Physical => "▲",
            _ => "◆"
        };

    private static string GetUtilityIcon(Card card) =>
        card.Name switch
        {
            "Energy Potion" => "🧪",
            "Energy Drain" => "🔋",
            "Attack Amplifier" => "📈",
            "Defensive Stance" => "🥋🛡️",
            "Shield Booster" => "🛡️⬆️",
            "Shield Breaker" => "🛡️💥",
            "Discount Coupon" => "🎟",
            "Discard For Energy" => "♻",
            _ => "✦"
        };
}