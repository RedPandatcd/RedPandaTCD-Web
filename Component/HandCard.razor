@using RedPandaTCD_Web.Game

@if (Slot.IsEmpty)
{
    <div class="hand-empty-card">
        <span>EMPTY</span>
        <small>Slot @Slot.SlotNumber</small>
    </div>
}
else
{
    Card card = Slot.CardInSlot!;

    <div class="hand-card-wrap @GetInteractionClass()"
         @onclick="HandleClick">
        @if (card.Type == CardType.Attack)
        {
            <article class="hand-attack-card @GetArchetypeClass(card)">
                <header class="attack-header">
                    <strong class="attack-title">@card.Name</strong>
                    <span class="attack-chip @GetArchetypeClass(card)">
                        <span aria-hidden="true">@GetAttackMark(card)</span>
                        @GetAttackTypeLabel(card)
                    </span>
                </header>

                <div class="attack-primary-stats">
                    <div class="attack-stat damage-stat">
                        <span>DAMAGE</span>
                        <strong>@card.Damage</strong>
                    </div>
                    <div class="attack-stat hits-stat">
                        <span>HITS</span>
                        <strong>@card.Hits</strong>
                    </div>
                </div>

                @if (GetAttackTraits(card).Count > 0)
                {
                    var attackTraits = GetAttackTraits(card);
                    <div class="attack-traits @(attackTraits.Count > 1 ? "icons-only" : "with-labels")"
                         aria-label="Attack effects">
                        @foreach (HandAttackTrait trait in attackTraits)
                        {
                            <div class="attack-trait @trait.CssClass"
                                 title="@trait.Label"
                                 aria-label="@trait.Label">
                                @if (trait.CssClass == "trait-multi-hit")
                                {
                                    <span class="trait-target-icon" aria-hidden="true">
                                        <svg viewBox="0 0 512 512" focusable="false" aria-hidden="true">
                                            <path fill="currentColor" d="m182.885 16.2l-1.73 57.015l51.257 47.226l8.063-23.036zm-68.537 65.073v.004l77.75 61.625l28.797-8.062l-57.018-52.986l-49.53-.58zM89.32 101.6l1.225 56.375l55.762 56.373l9.19-30.637zm159.496 33.992l-15.552 10.363c19.852 29.796 29.86 65.31 28.07 103.537l-.182.016l-1.406 18.824l.06-.004c-3.512 49.992 11.5 96.754 41.26 133.654l-30.218 16.368l62.177 19.548l-38.877 19.432l153.995 32.77l-98.457-122.86l.132 55.44c-50.335-36.216-76.608-92.807-71.142-155.975l.078-.006l.22-3.1c.025-.26.047-.517.075-.776c4.974-46.64-6.008-90.873-30.234-127.232zm-171.14 36.472l-57.6 2.454l87.012 61.275l23.898-9.19zm77.482 51.54l-10.05 15.757c28.25 18.023 61.034 28.177 95.874 29.265l1.395-18.648c-31.888-.83-61.58-10.016-87.22-26.372zm143.664 24.207l-1.312 18.602c52.536 1.886 99.042 26.41 130.82 68.754h-47.113L497.91 427.9l-31.62-145.66l-19.546 39.588l-18.7-59.478l-15.747 29.07c-31.726-26.472-71.01-41.83-113.475-43.61z" />
                                        </svg>
                                    </span>
                                }
                                else if (trait.CssClass == "trait-ignore-shield")
                                {
                                    <svg class="ignore-shield-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                        <path d="M17.67 17.667A12 12 0 0 1 12 21A12 12 0 0 1 3.5 6c.794.036 1.583-.006 2.357-.124m3.128-.926A12 12 0 0 0 12 3a12 12 0 0 0 8.5 3a12 12 0 0 1-1.116 9.376M3 3l18 18" />
                                    </svg>
                                }
                                else
                                {
                                    <span aria-hidden="true">@trait.Icon</span>
                                }

                                @if (attackTraits.Count == 1)
                                {
                                    <strong>@trait.Label</strong>
                                }
                            </div>
                        }
                    </div>
                }

                <footer class="attack-footer">
                    <div class="attack-footer-item">
                        <span>DEPLOY COST</span>
                        <strong><b class="energy-icon">◆</b>@card.Cost</strong>
                    </div>
                    <div class="attack-footer-item">
                        <span>BASE USES</span>
                        <strong>2 / 2</strong>
                    </div>
                </footer>
            </article>
        }
        else if (card.Type == CardType.Character)
        {
            <article class="hand-character-card">
                <div class="hand-ability-rail" aria-hidden="true">
                    <span class="entry-rail"></span>
                    <span class="passive-rail"></span>
                    <span class="active-rail"></span>
                </div>

                <header class="character-header">
                    <strong class="character-title">@card.Name</strong>
                    <span class="character-chip @GetCharacterArchetypeClass(card)">
                        @card.Archetype
                    </span>
                </header>

                <div class="character-art">
                    <span aria-hidden="true">@GetCharacterMark(card)</span>
                </div>

                <div class="character-deploy-cost" title="Deployment cost">
                    <span class="energy-icon">◆</span>
                    <strong>@card.Cost</strong>
                </div>

                <footer class="character-values">
                    <div class="character-orb hp-orb" title="Base HP">
                        <span aria-hidden="true">♥</span>
                        <strong>@card.HpValue</strong>
                    </div>
                    <div class="character-orb shield-orb" title="Base Shield">
                        <span class="shield-symbol" aria-hidden="true">⬢</span>
                        <strong>@card.ShieldValue</strong>
                    </div>
                </footer>
            </article>

            @if (!IsDisplayOnly)
            {
            <aside class="hand-character-info" aria-label="Character ability information">
                <div class="info-heading">
                    <strong>@card.Name</strong>
                    <span>@card.Archetype Character</span>
                </div>
                <section class="info-ability entry-info">
                    <strong>ENTRY · @CharacterInfo.GetEntryName(card)</strong>
                    <span>@CharacterInfo.GetEntryDescription(card)</span>
                </section>
                <div class="info-divider"></div>
                <section class="info-ability passive-info">
                    <strong>PASSIVE · @CharacterInfo.GetPassiveName(card)</strong>
                    <span>@CharacterInfo.GetPassiveDescription(card)</span>
                </section>
                <div class="info-divider"></div>
                <section class="info-ability active-info">
                    <strong>ACTIVE · @CharacterInfo.GetActiveName(card)</strong>
                    <span>@CharacterInfo.GetActiveDescription(card)</span>
                    <div class="active-meta">
                        <span>Cost: @CharacterInfo.GetActiveCost(card) Energy</span>
                        <span>Cooldown: @card.AbilityCooldown</span>
                    </div>
                </section>
            </aside>
            }
        }
        else
        {
            <article class="hand-utility-card @GetUtilityArchetypeClass(card)">
                <header class="utility-header">
                    <strong class="utility-title">@card.Name</strong>
                    <span class="utility-chip">
                        <span aria-hidden="true">✦</span>
                        UTILITY
                    </span>
                </header>

                <div class="utility-art" aria-label="@card.Name icon">
                    @if (card.Name == "Shield Breaker")
                    {
                        <span class="effect-icon" aria-hidden="true">🛡️💥</span>
                    }
                    else
                    {
                        <span aria-hidden="true">@GetUtilityIcon(card)</span>
                    }
                </div>

                <div class="utility-effect">
                    @UtilityInfo.GetDescription(card)
                </div>

<footer class="utility-footer">
    <span class="utility-cost-label">
        DEPLOY COST
    </span>

    <strong class="utility-cost-value">
        <b class="energy-icon">◆</b>
        @card.Cost
    </strong>
</footer>
            </article>
        }
    </div>
}

<style>
    .hand-card-wrap {
        position: relative;
        width: clamp(152px, 10vw, 176px);
        height: clamp(210px, 13.7vw, 238px);
        flex: 0 0 auto;
        overflow: visible;
        border: 2px solid #7f7668;
        border-radius: 10px;
        background: #f4efe3;
        color: #22262a;
        box-shadow: 0 6px 14px rgba(0, 0, 0, .27);
        transition: transform .14s ease, border-color .14s ease,
                    box-shadow .14s ease, filter .14s ease, opacity .14s ease;
    }

    .hand-card-wrap.clickable {
        cursor: pointer;
    }

    .hand-card-wrap.clickable:hover,
.hand-card-wrap.clickable:focus-within {
    z-index: 200;
    transform: translateY(-7px);
    border-color: #c7b98f;
    box-shadow: 0 11px 22px rgba(0, 0, 0, .34);
}
    .hand-card-wrap.display-only,
    .hand-card-wrap.display-only:hover {
        cursor: default;
        z-index: auto;
        transform: none;
        border-color: #7f7668;
        box-shadow: 0 6px 14px rgba(0, 0, 0, .27);
        filter: none;
    }

    .hand-card-wrap.disabled {
        cursor: default;
        filter: grayscale(.72);
        opacity: .53;
    }

   .hand-empty-card {
    width: clamp(132px, 8.8vw, 150px);
    height: 64px;

    box-sizing: border-box;
    align-self: flex-end;
    flex: 0 0 auto;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;

    border: 2px dashed rgba(255, 255, 255, .28);
    border-radius: 10px;

    background: rgba(255, 255, 255, .035);
    color: rgba(255, 255, 255, .45);
}


    .hand-empty-card span {
        font-size: 11px;
        font-weight: 900;
    }

    .hand-empty-card small {
        font-size: 8px;
        opacity: .7;
    }

    /* ==================== ATTACK ==================== */

    .hand-attack-card,
    .hand-utility-card {
        position: absolute;
        inset: 0;
        min-width: 0;
        min-height: 0;
        padding: 4px 7px 9px 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        overflow: hidden;
        border-radius: 8px;
        background: linear-gradient(155deg, #fffaf0 0%, #eee5d3 100%);
    }
    .hand-utility-card {
    padding-bottom: 9px;
}

    .hand-attack-card::before,
    .hand-utility-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 5px;
        background: #717981;
    }

    .hand-attack-card.archetype-magic::before {
        background: #386fc8;
    }

    .hand-attack-card.archetype-physical::before {
        background: #c84f4f;
    }

    .attack-header {
        width: 100%;
        min-width: 0;
        min-height: 49px;
        padding: 1px 2px 0;
        display: grid;
        grid-template-rows: minmax(18px, auto) 23px;
        justify-items: center;
        align-items: center;
        gap: 5px;
        text-align: center;
    }

    .attack-title {
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding-top: 2px;
        font-size: clamp(12px, .84vw, 15px);
        line-height: 1.25;
    }

    .attack-chip {
        min-height: 23px;
        padding: 4px 10px 4px 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 999px;
        color: #fff;
        font-size: 7px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: .48px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .attack-chip.archetype-magic {
        background: #386fc8;
    }

    .attack-chip.archetype-physical {
        background: #b94747;
    }

    .attack-chip.archetype-neutral {
        background: #666e76;
    }

    .attack-chip > span {
        width: 13px;
        font-size: 9px;
    }

    .attack-chip .attack-chip-target {
        display: inline-grid;
        place-items: center;
        width: 14px;
        height: 14px;
        flex: 0 0 14px;
    }

    .attack-chip-target svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .attack-primary-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
    }

    .attack-stat {
        min-width: 0;
        min-height: 46px;
        padding: 5px 4px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(65, 58, 48, .1);
        border-radius: 7px;
        background: rgba(67, 58, 48, .07);
    }

    .attack-stat span,
    .attack-footer-item > span,
    .utility-footer div > span {
        color: #716b63;
        font-size: 6px;
        font-weight: 900;
        letter-spacing: .7px;
        white-space: nowrap;
    }

    .attack-stat strong {
        margin-top: 1px;
        font-size: 17px;
        line-height: 1;
    }

    .damage-stat strong {
        color: #bf3f47;
    }

    .hits-stat strong {
        color: #3479aa;
    }

    .attack-traits {
        min-height: 32px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .attack-traits.icons-only {
        flex-wrap: nowrap;
        gap: 6px;
    }

    .attack-trait {
        padding: 4px 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border: 1px solid rgba(79, 74, 68, .24);
        border-radius: 7px;
        background: rgba(67, 58, 48, .085);
        color: #443e38;
    }

    .attack-trait > span {
        width: 19px;
        height: 19px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 11px;
        font-weight: 900;
    }

    .attack-trait .trait-target-icon {
        width: 22px;
        height: 22px;
        flex: 0 0 22px;
    }

    .trait-target-icon svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .attack-traits.icons-only .attack-trait {
        width: 31px;
        height: 31px;
        min-width: 31px;
        padding: 3px;
        flex: 0 0 31px;
        box-sizing: border-box;
    }

    .attack-traits.icons-only .attack-trait > span {
        width: 23px;
        height: 23px;
        flex: 0 0 23px;
        background: transparent;
    }

    .attack-traits.icons-only .attack-trait .trait-target-icon {
        width: 24px;
        height: 24px;
        flex-basis: 24px;
    }

    .attack-trait strong {
        font-size: 7.5px;
        line-height: 1;
        letter-spacing: .42px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .trait-piercing > span {
        color: #2876a8;
        background: rgba(40, 118, 168, .13);
    }

    .trait-multi-hit > span {
        color: #7359b4;
        background: rgba(115, 89, 180, .13);
    }

    .trait-ignore-shield > span {
        color: #ad2929;
        background: rgba(198, 83, 83, .15);
    }

    .ignore-shield-svg {
        width: 1.25em;
        height: 1.25em;
        display: inline-block;
        vertical-align: middle;
        flex: 0 0 auto;
    }

    .overlapped-effect-icon {
        position: relative;
        display: inline-block;
        width: 1.45em;
        height: 1.35em;
        flex: 0 0 1.45em;
        line-height: 1;
        vertical-align: middle;
    }

    .overlapped-effect-icon .effect-base {
        position: absolute;
        left: 0;
        top: 0;
        font-size: 1.05em;
    }

    .overlapped-effect-icon .effect-overlay {
        position: absolute;
        right: -0.12em;
        bottom: -0.08em;
        font-size: .72em;
        line-height: 1;
        filter: drop-shadow(0 0 1px #fff);
    }

    .utility-overlap {
        width: 1.55em;
        height: 1.5em;
        flex-basis: 1.55em;
        font-size: 43px;
    }

    .utility-overlap .effect-base {
        font-size: .9em;
    }

    .utility-overlap .effect-overlay {
        font-size: .62em;
        right: -.04em;
        bottom: -.02em;
    }

    .trait-instant-fatigue > span {
        color: #bd424a;
        background: rgba(189, 66, 74, .13);
    }

    .attack-footer {
        margin-top: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
    }

    .attack-footer-item {
        min-height: 42px;
        padding: 7px 4px 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        border: 1px solid rgba(65, 58, 48, .15);
        border-radius: 7px;
        background: rgba(67, 58, 48, .065);
    }

    .attack-footer-item strong {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        color: #364049;
        font-size: 12px;
        line-height: 1;
    }

    .attack-footer-item:first-child strong {
        color: #71329a;
    }

    .energy-icon {
        color: #9b45d2;
        font-size: 11px;
        font-style: normal;
    }

    /* ==================== CHARACTER ==================== */

    .hand-character-card {
        position: absolute;
        inset: 0;
        z-index: 2;
        padding: 7px 12px 9px 10px;
        display: flex;
        flex-direction: column;
        gap: 7px;
        overflow: hidden;
        border-radius: 8px;
        background: linear-gradient(155deg, #fffaf0 0%, #eee4cf 100%);
    }

    .hand-ability-rail {
        position: absolute;
        inset: 0 0 0 auto;
        z-index: 3;
        width: 7px;
        display: grid;
        grid-template-rows: 1fr 1fr 1fr;
    }

    .entry-rail {
        background: #e4a82f;
    }

    .passive-rail {
        background: #8c58c7;
    }

    .active-rail {
        background: #35c759;
    }

    .character-header {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        text-align: center;
    }

    .character-title {
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: clamp(14px, .95vw, 17px);
        line-height: 1.2;
    }

    .character-chip {
        padding: 4px 9px;
        border-radius: 999px;
        color: #fff;
        font-size: 7px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .character-chip.magic {
        background: #3475d2;
    }

    .character-chip.physical {
        background: #b94747;
    }

    .character-chip.neutral {
        background: #6c747c;
    }

    .character-art {
        min-height: 0;
        flex: 1;
        margin-bottom: 3px;
        display: grid;
        place-items: center;
        overflow: hidden;
        border: 1px solid rgba(81, 70, 52, .18);
        border-radius: 8px 8px 3px 3px;
        background:
            radial-gradient(
                circle at 50% 48%,
                rgba(214, 182, 93, .22),
                transparent 58%
            ),
            repeating-linear-gradient(
                135deg,
                rgba(70, 58, 42, .045) 0,
                rgba(70, 58, 42, .045) 1px,
                transparent 1px,
                transparent 7px
            ),
            rgba(82, 67, 45, .055);
    }

    .character-art > span {
        color: rgba(136, 103, 38, .48);
        font-size: 42px;
        font-weight: 900;
        line-height: 1;
    }

    /* Vertical Character deployment-cost pill */

    .character-deploy-cost {
        position: absolute;
        left: 50%;
        bottom: 2px;
        z-index: 6;

        width: 30px;
        height: 48px;
        padding: 3px 0;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;

        box-sizing: border-box;

        border: 2px solid #66566f;
        border-radius: 15px 15px 8px 8px;

        background:
            linear-gradient(
                180deg,
                #f4e4ff 0%,
                #b786d2 100%
            );

        color: #4f2368;

        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, .55),
            0 3px 7px rgba(0, 0, 0, .25);

        transform: translateX(-50%);
    }

    .character-deploy-cost .energy-icon {
        color: #8e3fc0;
        font-size: 10px;
        line-height: 1;
    }

    .character-deploy-cost strong {
        color: #4f2368;
        font-size: 16px;
        font-weight: 950;
        line-height: 1;
    }

    .character-values {
        position: relative;
        z-index: 5;
        height: 0;
    }

    .character-orb {
        position: absolute;
        bottom: -7px;
        width: 49px;
        height: 49px;
        display: grid;
        place-items: center;
        overflow: hidden;
        border: 3px solid #5e5549;
        border-radius: 50% 50% 10px 10px;
        box-shadow:
            inset 0 2px 0 rgba(255, 255, 255, .75),
            0 4px 8px rgba(0, 0, 0, .32);
    }

    .hp-orb {
        left: -3px;
        background: linear-gradient(180deg, #f7dade, #c93d4b);
    }

    .shield-orb {
        right: -3px;
        background: linear-gradient(180deg, #dbeafa, #3d7db4);
    }

    .character-orb > span {
        position: absolute;
        top: 4px;
        left: 50%;
        color: rgba(255, 255, 255, .88);
        font-size: 10px;
        transform: translateX(-50%);
    }

    .character-orb .shield-symbol {
        font-size: 12px;
    }

    .character-orb strong {
        position: relative;
        z-index: 2;
        margin-top: 8px;
        color: #fff;
        font-size: 23px;
        font-weight: 950;
        line-height: 1;
        text-shadow:
            0 1px 0 rgba(0, 0, 0, .48),
            0 2px 4px rgba(0, 0, 0, .32);
    }

    /* Character information window: leave this section intact */

    .hand-character-info {
        position: absolute !important;
        top: 50% !important;
        left: calc(100% + 12px) !important;
        z-index: 210 !important;
        width: 310px !important;
        height: auto !important;
        max-height: 280px;
        padding: 12px 14px !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 7px !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        border: 2px solid #766b5b !important;
        border-radius: 10px !important;
        background: linear-gradient(155deg, #fffaf0, #eee4cf) !important;
        color: #25211d !important;
        box-shadow: 0 15px 34px rgba(0, 0, 0, .48) !important;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-50%) translateX(-5px);
        pointer-events: none;
        transition:
            opacity .14s ease,
            transform .14s ease,
            visibility .14s ease;
    }

    .hand-card-wrap:hover > .hand-character-info,
