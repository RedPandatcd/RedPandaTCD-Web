@inherits LayoutComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable
@using RedPandaTCD_Web.Game


<div class="main-layout">

    <GameNav />

    <main class="main-content">
        @Body
    </main>

</div>

<style>
.main-layout {
    width: 100%;
    margin: 0;
    padding: 0;
}

.main-content {
    width: 100%;
}
</style>

@code {
    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync("gameGuard.enable");

        var json = await JS.InvokeAsync<string?>(
            "deckStorage.load");

        DeckManager.ImportCustomDecks(json);

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("gameGuard.disable");
    }
}
